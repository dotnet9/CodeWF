@inherits BaseComponent
@inject AppService AppService

<style>
    .cl-doc-menu {
        background: var(--bg-card); /* 使用主题背景色 */
        border: 1px solid var(--border-color); /* 柔和边框 */
        border-radius: 8px; /* 统一圆角 */
        box-shadow: var(--shadow-sm); /* 柔和阴影 */
    }

    .cl-doc-menu ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .cl-doc-menu li {
        margin: 4px 0;
    }

    .cl-doc-menu div {
        color: var(--text-primary); /* 主题主色文字 */
        font-weight: 600;
        padding: 8px 16px;
        font-size: 1rem;
        border-left: 3px solid transparent;
        letter-spacing: 0.3px;
    }

    .cl-doc-menu a {
        display: block;
        padding: 8px 16px;
        color: var(--text-secondary); /* 主题次要文字 */
        text-decoration: none;
        transition: var(--transition); /* 统一过渡效果 */
        border-left: 3px solid transparent;
        font-size: 0.9rem;
        position: relative;
    }

    .cl-doc-menu a:hover {
        background: var(--bg-secondary); /* 柔和背景色 */
        color: var(--primary-color); /* 主题主色 */
        border-left-color: var(--primary-color); /* 主题主色边框 */
        padding-left: 20px;
    }

    .cl-doc-menu a.active {
        background: var(--bg-secondary); /* 柔和背景色 */
        color: var(--primary-color); /* 主题主色 */
        border-left-color: var(--primary-color); /* 主题主色边框 */
        font-weight: 500;
    }

    .cl-doc-menu ul ul {
        margin-left: 16px;
        position: relative;
    }

    .cl-doc-menu ul ul::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 1px;
        background: var(--border-color); /* 统一边框色 */
    }

    .cl-doc-menu ul ul a {
        font-size: 0.85rem;
        padding: 5px 16px;
    }

    .cl-doc-menu ul ul a::before {
        content: '›';
        color: var(--border-color); /* 统一边框色 */
        margin-right: 6px;
        font-weight: normal;
    }
</style>

<CmsCard Class="cl-doc-menu">
    @if (_contents is { Count: > 0 })
    {
        <ul>
            @foreach (var content in _contents)
            {
                <li>
                    @if (content.Children?.Count > 0)
                    {
                        <div>@content.Name</div>
                        <ul>
                            @foreach (var child in content.Children)
                            {
                                <li>
                                    <a href="@GetUrl(child)" class="@(IsActive(child.Slug) ? "active" : "")">@child.Name</a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <a href="@GetUrl(content)" class="@(IsActive(content.Slug) ? "active" : "")">@content.Name</a>
                    }
                </li>
            }
        </ul>
    }
</CmsCard>

@code {
    private List<DocItem>? _contents { get; set; }

    protected override async Task OnInitAsync()
    {
        await base.OnInitAsync();

        _contents = await AppService.GetAllDocItemsAsync();
    }

    private string GetUrl(DocItem item) => $"/doc/{item.Slug}";

    private bool IsActive(string slug)
    {
        var uri = Navigation.Uri;
        if (string.Equals(slug, _contents?.FirstOrDefault()?.Slug, StringComparison.CurrentCultureIgnoreCase))
        {
            return true;
        }

        return uri.EndsWith($"/{slug}");
    }

}