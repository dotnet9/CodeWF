@page "/"

@inherits BaseComponent
@layout HomeLayout
@inject AppService AppService
@inject IOptions<SiteOption> SiteOption

<PageTitle>@SiteOption.Value.AppTitle</PageTitle>

<style>
    /* 英雄区背景动画 */
    .hero-section::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(53, 189, 255, 0.15), transparent 70%);
        animation: float 20s ease-in-out infinite;
        z-index: -1;
    }

    .hero-section::after {
        content: '';
        position: absolute;
        bottom: -30%;
        right: -20%;
        width: 150%;
        height: 150%;
        background: radial-gradient(circle, rgba(120, 50, 226, 0.1), transparent 70%);
        animation: float 25s ease-in-out infinite reverse;
        z-index: -1;
    }

    /* 卡片样式美化 */
    .tech-card {
        position: relative;
        background: rgba(48, 43, 99, 0.85);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(53, 189, 255, 0.2);
        border-radius: 16px;
        padding: 2rem;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        min-height: 280px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        cursor: pointer;
        overflow: hidden;
    }

    .tech-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(53, 189, 255, 0.1), transparent);
        transition: all 0.6s ease;
    }

    .tech-card:hover {
        transform: translateY(-8px) scale(1.02);
        background: rgba(58, 53, 119, 0.95);
        border-color: rgba(53, 189, 255, 0.5);
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.4);
    }

    .tech-card:hover::before {
        left: 100%;
    }

    .tech-card .title {
        font-size: 1.35rem;
        font-weight: 700;
        margin-bottom: 1.25rem;
        color: rgba(255, 255, 255, 0.98);
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        line-height: 1.5;
        text-shadow: 0 0 15px rgba(53, 189, 255, 0.4);
    }

    .tech-card .description {
        color: rgba(255, 255, 255, 0.82);
        font-size: 0.98rem;
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        line-height: 1.65;
    }

    .tech-card i {
        font-size: 2.25rem;
        margin-bottom: 1.5rem;
        color: #35bdff;
        text-shadow: 0 0 20px rgba(53, 189, 255, 0.6);
        transition: all 0.4s ease;
    }

    .tech-card:hover i {
        transform: scale(1.1) rotate(5deg);
        text-shadow: 0 0 30px rgba(53, 189, 255, 0.8);
    }

    .tech-card .stretched-link::after {
        position: absolute;
        top: 0;
        right: 0;
        bottom: 0;
        left: 0;
        z-index: 1;
        content: "";
    }

    /* 按钮样式美化 */
    .btn-outline-light {
        border: 2px solid rgba(255, 255, 255, 0.3);
        color: rgba(255, 255, 255, 0.9);
        background: rgba(255, 255, 255, 0.1);
        border-radius: 50px;
        padding: 0.75rem 2rem;
        font-weight: 600;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .btn-outline-light:hover {
        border-color: #35bdff;
        color: #ffffff;
        background: rgba(53, 189, 255, 0.2);
        box-shadow: var(--glow-blue);
        transform: translateY(-2px);
    }

    .btn-success {
        border: none;
        background: linear-gradient(135deg, #44c553, #34a043);
        border-radius: 50px;
        padding: 0.75rem 2rem;
        font-weight: 600;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .btn-success:hover {
        background: linear-gradient(135deg, #34a043, #2a8036);
        box-shadow: 0 0 20px rgba(68, 197, 83, 0.4);
        transform: translateY(-2px);
    }

    /* 容器美化 */
    .container {
        position: relative;
    }

    /* 响应式调整已移至外部CSS文件 */
</style>

<!-- 修改背景颜色和文字样式 -->
<div class="jumbotron jumbotron-lg jumbotron-fluid mb-0 pb-3 bg-dark-tech position-relative" style="background: linear-gradient(135deg, #0f0c29 0%, #302b63 50%, #24243e 100%);">
    <!-- 装饰性背景元素 -->
    <div class="position-absolute top-0 left-0 w-100 h-100 overflow-hidden">
        <div class="position-absolute top-20 left-10 w-32 h-32 bg-blue rounded-full opacity-20 blur-3xl"></div>
        <div class="position-absolute bottom-20 right-20 w-48 h-48 bg-purple rounded-full opacity-20 blur-3xl"></div>
        <div class="position-absolute top-50 left-50 transform -translate-x-1/2 -translate-y-1/2 w-64 h-64 bg-cyan rounded-full opacity-10 blur-3xl"></div>
    </div>
    
    <div class="container text-light h-100 position-relative z-10">
        <div class="d-lg-flex align-items-center justify-content-between text-center pl-lg-5">
            <div class="col pt-8 pb-8">
                <h2 class="display-4 font-weight-bold mb-4" style="text-shadow: 0 0 15px rgba(53, 189, 255, 0.5), 0 0 30px rgba(53, 189, 255, 0.3);">文章启智，工具助力</h2>
                <h5 class="font-weight-light mb-3" style="color: rgba(255, 255, 255, 0.9);">
                    <strong>码坊</strong>：使用<strong>.NET 10 Web API</strong> + <strong>Blazor</strong>开发。
                </h5>
                <h5 class="font-weight-light mb-6" style="color: rgba(255, 255, 255, 0.85);">有技术文章、开源项目介绍和在线工具，助力高效编程。</h5>
                <div class="d-flex justify-content-center gap-4 flex-wrap">
                    <a href="/bbs" class="btn btn-lg btn-outline-light">博客</a>
                    <a href="https://github.com/dotnet9/codewf" class="btn btn-lg btn-success" target="_blank">Github</a>
                </div>
            </div>
            <!-- 替换为更有科技感的图片 -->
            <div class="col align-self-bottom align-items-right text-right h-max-380 position-relative z-index-1 d-none d-lg-block">
                <img src="https://img1.dotnet9.com/site/banners/banner.jpg" class="rounded-xl img-fluid shadow-lg" style="animation: float 4s ease-in-out infinite;">
            </div>
        </div>
    </div>
</div>


<!-- 修改 SVG 颜色 -->
<svg style="-webkit-transform:rotate(-180deg);-moz-transform:rotate(-180deg);-o-transform:rotate(-180deg);transform:rotate(-180deg);margin-top:-1px;enable-background:new 0 0 1440 126;" version="1.1" id="Layer_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" x="0px" y="0px" viewbox="0 0 1440 126" xml:space="preserve">
    <path class="bg-tech" d="M685.6,38.8C418.7-11.1,170.2,9.9,0,30v96h1440V30C1252.7,52.2,1010,99.4,685.6,38.8z" fill="rgba(48, 43, 99, 0.85)"/>
</svg>

<div class="container pt-8 pb-8" data-aos="fade-up">
    <div class="row gap-6">
        @if (_posts?.Any() != true)
        {
            <div class="col-12 d-flex justify-content-center align-items-center py-12">
                <AntEmpty Description="暂无文章" />
            </div>
        }
        else
        {
            foreach (var blogPost in _posts)
            {
                int index = _posts.IndexOf(blogPost);
                <div class="col-md-6 col-xl-4 mb-6">
                    <div class="tech-card h-100">
                        <i class="@Icons[index % Icons.Length] @GetIconStyle(index)"></i>
                        <h3 class="title">@blogPost.Title</h3>
                        <p class="description">@blogPost.Description</p>
                        <a href="@ConstantUtil.GetBbsPostUrl(blogPost)" class="stretched-link"></a>
                    </div>
                </div>
            }
        }
    </div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const handleScroll = () => {
            const indexNav = document.querySelector('.index-nav');
            if (indexNav) {
                const darkNavClasses = ['bg-white', 'navbar-light', 'shadow-sm', 'scrollednav'];
                if (window.scrollY > 50) {
                    darkNavClasses.forEach(cls => indexNav.classList.add(cls));
                } else {
                    darkNavClasses.forEach(cls => indexNav.classList.remove(cls));
                }
            }
        };
        
        window.addEventListener('scroll', handleScroll);
        // 初始检查
        handleScroll();
    });
</script>

@code
{
    private static readonly string[] Icons = { "fas fa-paper-plane", "fas fa-shield-alt", "fas fa-layer-group", "fas fa-vector-square", "fab fa-amazon", "fab fa-slack-hash" };
    private List<BlogPost>? _posts;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        _posts = await AppService.GetBannerPostAsync();
    }

    private string GetIconStyle(int index)
    {
        string[] styles = new[] { "text-salmon", "text-primary", "text-success", "text-info", "text-warning" };
        return styles[index % styles.Length];
    }
}