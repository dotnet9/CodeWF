@inherits BaseComponent
@inject AppService AppService

<div class="fluent-container fluent-widget friend-links" data-aos="fade-up">
    <div class="d-flex flex-wrap align-items-center">
        <span class="fluent-title-small mr-3">
            <i class="fas fa-link mr-2"></i>友情链接
        </span>
        @if (_links?.Any() != true)
        {
            <AntEmpty/>
        }
        else
        {
            <div class="tech-links-container">
                @foreach (var link in _links)
                {
                    <a href="@link.Link" target="_blank" title="@link.Description" class="tech-link">
                        <span class="link-text">@link.Title</span>
                    </a>
                }
            </div>
        }
    </div>
</div>

<style>
    .tech-links-container {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        padding: 20px;
        background: var(--bg-card);
        border-radius: 16px;
        border: 1px solid var(--border-color);
        box-shadow: var(--shadow-md);
        backdrop-filter: blur(10px);
    }

    .tech-link {
        position: relative;
        padding: 8px 16px;
        color: var(--text-primary);
        text-decoration: none;
        background: var(--bg-hover);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        transition: var(--transition);
        font-size: 0.95rem;
        display: flex;
        align-items: center;
    }

    .tech-link::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(45deg, transparent, var(--bg-hover), transparent);
        opacity: 0;
        transition: opacity var(--transition);
    }

    .tech-link:hover {
        transform: translateY(-2px);
        background: var(--bg-active);
        border-color: var(--accent-color);
        box-shadow: var(--shadow-lg);
        color: var(--text-primary);
    }

    .tech-link:hover::before {
        opacity: 1;
    }

    .link-text::before {
        content: '# ';
        color: var(--accent-color);
        margin-right: 2px;
    }
</style>

@code {
    private List<FriendLinkItem>? _links;

    protected override async Task OnInitAsync()
    {
        await base.OnInitAsync();

        _links = await AppService.GetAllFriendLinkItemsAsync();
    }
}