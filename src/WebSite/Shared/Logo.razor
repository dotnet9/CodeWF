@inject IOptions<SiteOption> SiteOption

<a href="/" class="logo-link">
    <div class="logo-container">
        <img src="@SiteOption.Value.Favicon" alt="@SiteOption.Value.AppTitle" title="@SiteOption.Value.AppTitle" class="logo-image" />
        <!-- 修改标题样式 -->
        <span class="logo-text">@SiteOption.Value.AppTitle</span>
    </div>
</a>

<!-- 添加自定义样式 -->
<style>
    .logo-text {
        color: var(--text-primary);
        transition: all 0.3s ease;
        margin-left: 10px; /* 添加一些间距 */
        font-weight: 700;
        font-size: 1.25rem;
    }

    .logo-text:hover {
        color: var(--accent-color);
    }
</style>