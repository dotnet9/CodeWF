@inject IOptions<SiteOption> SiteOption

<footer class="footer">
    <div class="container">
        <div class="row">
            <div class="col-12 col-md">
                <Logo/>
                <div class="desc">@SiteOption.Value.Memo</div>
            </div>
            <div class="col-12 col-md">
                <div class="row">
                    <div class="col-6 col-md" style="margin-top:1rem;">
                        <h5 class="mb-4">站点</h5>
                        <ul class="list-unstyled text-small">
                            <li>
                                <i class="fas fa-angle-right" />
                                <a class="text-muted" href="/donation">赞助</a>
                            </li>
                            <li>
                                <i class="fas fa-angle-right" />
                                <a class="text-muted" href="/timeline">时间线</a>
                            </li>
                            <li>
                                <i class="fas fa-angle-right" />
                                <a class="text-muted" href="/rss" target="_blank">RSS</a>
                            </li>
                            <li>
                                <i class="fas fa-angle-right" />
                                <a class="text-muted" href="/sitemap.xml" target="_blank">站点地图</a>
                            </li>
                            <li>
                                <i class="fas fa-angle-right" />
                                <a class="text-muted" href="/about">关于</a>
                            </li>
                        </ul>
                    </div>
                    <div class="col-6 col-md" style="margin-top:1rem;">
                        <h5 class="mb-4">工具资源</h5>
                        <ul class="list-unstyled text-small">
                            <li>
                                <i class="fas fa-angle-right" />
                                <a class="text-muted" href="https://it-tools.tech/" target="_blank">IT-Tools</a>
                            </li>
                            <li>
                                <i class="fas fa-angle-right"/>
                                <a class="text-muted" href="https://www.cnblogs.com/Dotnet9-com/" target="_blank">博客园</a>
                            </li>
                            <li>
                                <i class="fas fa-angle-right"/>
                                <a class="text-muted" href="https://space.bilibili.com/470546606" target="_blank">B站</a>
                            </li>
                            <li>
                                <i class="fas fa-angle-right" />
                                <a class="text-muted" href="https://www.toutiao.com/c/user/98075192460/#mid=1651788205627396" target="_blank">今日头条</a>
                            </li>
                            <li>
                                <i class="fas fa-angle-right"/>
                                <a class="text-muted" href="https://github.com/dotnet9/" target="_blank">Github</a>
                            </li>
                        </ul>
                    </div>
                    <div class="col-6 col-md" style="margin-top:1rem;">
                        <h5 class="mb-4">社区资源</h5>
                        <ul class="list-unstyled text-small">
                            <li>
                                <i class="fas fa-angle-right"/>
                                <a class="text-muted" href="https://irihi.tech/" target="_blank">铱泓科技</a>
                            </li>
                            <li>
                                <i class="fas fa-angle-right"/>
                                <a class="text-muted" href="http://known.org.cn/" target="_blank">Known</a>
                            </li>
                            <li>
                                <i class="fas fa-angle-right"/>
                                <a class="text-muted" href="https://antblazor.com" target="_blank">Ant Blazor</a>
                            </li>
                            <li>
                                <i class="fas fa-angle-right" />
                                <a class="text-muted" href="https://masastack.com/" target="_blank">Masa</a>
                            </li>
                            <li>
                                <i class="fas fa-angle-right"/>
                                <a class="text-muted" href="https://www.youtube.com/channel/UCbkbOlw8snP93RJ2BhH44Qw" target="_blank">Murat Yücedağ</a>
                            </li>
                        </ul>
                    </div>
                    <div class="col-12 col-md" style="margin-top:1rem;">
                        <div class="qrcode">
                            <img src="@SiteOption.Value.WeChatImg" width="180" alt="@SiteOption.Value.WeChatName"/>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="copyright">
            <span>©@SiteOption.Value.StartYear-@DateTime.Now.Year @SiteOption.Value.Owner</span>
            <a class="text-muted" target="_blank" href="https://beian.miit.gov.cn">@SiteOption.Value.BaiAn</a>
        </div>
    </div>
</footer>

<style>
    .footer {
        background-color: #000000;
        padding: 3rem 0 1rem;
        color: #ffffff;
        border-top: 1px solid #333333;
        position: relative;
        overflow: hidden;
    }

    /* 页脚中的Logo样式 */
    .footer .logo-text {
        color: #ffffff !important;
    }

    .footer .logo-text:hover {
        color: #bbdefb !important;
    }

    /* 装饰性背景元素 */
    .footer::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.5), transparent);
        animation: shimmer 3s infinite;
    }

    .footer .desc {
        margin-top: 1rem;
        opacity: 1;
        font-size: 0.9rem;
        line-height: 1.6;
        color: #ffffff;
    }

    .footer h5 {
        color: #ffffff;
        font-weight: 600;
        font-size: 1.2rem;
        margin-bottom: 1.5rem;
        transition: all 0.3s ease;
    }

    .footer h5:hover {
        transform: translateX(5px);
        color: #bbdefb;
    }

    .footer ul li {
        margin: 0.75rem 0;
        transition: all 0.3s ease;
    }

    .footer ul li:hover {
        transform: translateX(10px);
    }

    .footer ul li i {
        color: #bbdefb;
        font-size: 0.8rem;
        margin-right: 0.75rem;
        transition: all 0.3s ease;
        display: inline-block;
    }

    .footer ul li:hover i {
        transform: translateX(3px) rotate(5deg);
        color: #2196f3;
    }

    .footer ul li a {
        color: #ffffff;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        font-size: 0.95rem;
        position: relative;
        padding: 0.25rem 0;
    }

    .footer ul li a::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 0;
        height: 1px;
        background: #ffffff;
        transition: width 0.3s ease;
    }

    .footer ul li:hover a {
        color: #bbdefb;
    }

    .footer ul li:hover a::after {
        width: 100%;
    }

    .footer .qrcode {
        background: #1a1a1a;
        padding: 1rem;
        border-radius: 12px;
        text-align: center;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid #333333;
        backdrop-filter: blur(10px);
    }

    .footer .qrcode:hover {
        transform: translateY(-10px) scale(1.05);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.3);
        border-color: #2196f3;
    }

    .footer .qrcode img {
        border-radius: 8px;
        box-shadow: var(--shadow-md);
        transition: all 0.3s ease;
    }

    .footer .qrcode:hover img {
        box-shadow: var(--shadow-lg);
    }

    .footer .copyright {
        margin-top: 3rem;
        padding-top: 2rem;
        border-top: 1px solid #333333;
        text-align: center;
        font-size: 0.9rem;
        opacity: 1;
        position: relative;
        color: #ffffff;
    }

    .footer .copyright::before {
        content: '';
        position: absolute;
        top: -1px;
        left: 50%;
        transform: translateX(-50%);
        width: 60px;
        height: 2px;
        background: #2196f3;
        border-radius: 2px;
    }

    .footer .copyright a {
        color: #ffffff;
        text-decoration: none;
        margin: 0 0.75rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        padding: 0.25rem 0;
    }

    .footer .copyright a::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        width: 0;
        height: 1px;
        background: #2196f3;
        transition: width 0.3s ease;
    }

    .footer .copyright a:hover {
        color: #bbdefb;
    }

    .footer .copyright a:hover::after {
        width: 100%;
    }

    /* 响应式设计已移至外部CSS文件 */
</style>