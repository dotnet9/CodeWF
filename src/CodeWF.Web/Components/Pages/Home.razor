@page "/"
@using CodeWF.Web.Models
@inject CodeWF.Web.Services.ContentRepository Repository

<PageTitle>@(HomeData?.Site.AppTitle ?? "CodeWF")</PageTitle>
<HeadContent>
    <meta name="description" content="@(HomeData?.Site.Memo ?? string.Empty)" />
</HeadContent>

@if (HomeData is null)
{
    <section class="page-shell"><p class="muted">加载中…</p></section>
}
else
{
    var latest = HomeData.RecentPosts.Take(3).ToList();
    var recent = HomeData.RecentPosts.Skip(3).Take(6).ToList();

    @if (HomeData.BannerPosts.Count > 0)
    {
        <section class="banner-carousel" id="banner-carousel" aria-label="精选文章">
            <div class="banner-track">
                @foreach (var post in HomeData.BannerPosts)
                {
                    <a class="banner-slide" href="@post.Url" style="background-image: linear-gradient(180deg, rgba(0,0,0,.05), rgba(0,0,0,.45)), url('@post.Cover')">
                        <span class="banner-slide__title">@post.Title</span>
                    </a>
                }
            </div>
            <div class="banner-dots" role="tablist">
                @for (var i = 0; i < HomeData.BannerPosts.Count; i++)
                {
                    <button type="button" class="banner-dot@(i == 0 ? " is-active" : "")" data-index="@i" aria-label="第 @(i + 1) 张"></button>
                }
            </div>
        </section>
    }

    <section class="prototype-hero">
        <div class="prototype-hero__copy">
            <span class="prototype-status"><i></i>SYSTEM ONLINE · 更新于 @DateTime.Now.ToString("M月d日")</span>
            <h1>.NET 开发者的<br /><span id="typewriter">代码工坊</span><b aria-hidden="true">▌</b></h1>
            <p>深度技术文章与系统化专题，覆盖 WPF、Avalonia、Blazor 与 AI 开发实践；常用在线工具已独立为工具箱站。</p>
            <div class="prototype-hero__actions">
                <a class="prototype-button" href="/post">开始阅读 →</a>
                <a class="prototype-button prototype-button--ghost" href="@ToolsSiteUrl" target="_blank" rel="noreferrer">打开工具箱</a>
            </div>
            <div class="prototype-metrics">
                <div><strong>@HomeData.Counts.GetValueOrDefault("posts")</strong><span>篇文章</span></div>
                <div><strong>@HomeData.Counts.GetValueOrDefault("categories")</strong><span>个分类</span></div>
                <div><strong>@(DateTime.Now.Year - HomeData.Site.StartYear)<i>+</i></strong><span>年坚持</span></div>
            </div>
        </div>

        <div class="prototype-terminal" aria-label="CodeWF 站点状态">
            <div class="prototype-terminal__bar">
                <i class="red"></i><i class="yellow"></i><i class="green"></i><span>codewf — 站点情报 · live</span>
            </div>
            <div class="prototype-terminal__body">
                <p><span class="comment"># 检查站点状态</span></p>
                <p><span class="prompt">$</span> curl codewf.com/api/health</p>
                <p>{ "{ " }<span class="key">"status"</span>: <span class="string">"online"</span> { "}" }</p>
                <br />
                <p><span class="prompt">$</span> codewf stats --live</p>
                <p><span class="key">articles</span> <span class="value">@HomeData.Counts.GetValueOrDefault("posts")</span></p>
                <p><span class="key">categories</span> <span class="value">@HomeData.Counts.GetValueOrDefault("categories")</span></p>
                <br />
                <p><span class="prompt">$</span> dotnet --info</p>
                <p><span class="string">Ready to build.</span> <span class="prototype-terminal__cursor"></span></p>
            </div>
        </div>
    </section>

    <section class="home-section">
        <h2>最新文章</h2>
        <div class="post-grid">
            @foreach (var post in latest)
            {
                <PostCard Post="post" />
            }
        </div>
        <p class="muted home-more"><a href="/post">浏览全部文章 →</a></p>
    </section>

    @if (recent.Count > 0)
    {
        <section class="home-section">
            <h2>近期更新</h2>
            <div class="post-grid">
                @foreach (var post in recent)
                {
                    <PostCard Post="post" />
                }
            </div>
        </section>
    }

    <section class="home-section">
        <h2>分类索引</h2>
        <div class="chip-row">
            @foreach (var category in HomeData.Categories)
            {
                <a class="chip" href="@($"/cat/{Uri.EscapeDataString(category.Slug ?? category.Name)}")">@category.Name（@category.PostCount）</a>
            }
        </div>
    </section>
}

@code {
    private HomePageData? HomeData;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            HomeData = await Repository.GetHomeAsync("zh-CN", 12);
        }
        catch
        {
            HomeData = null;
        }
    }

    private string ToolsSiteUrl => "https://tools.dotnet9.com";
}
