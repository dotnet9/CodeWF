@model WebApp.Components.FriendLinkViewModel

<div class="friend-links">
    <div class="section-heading section-heading--compact">
        <div>
            <span class="eyebrow">友情链接</span>
            <h2 class="section-title">值得一看的技术站点</h2>
        </div>
    </div>

    @if (Model.Links?.Any() != true)
    {
        <div class="empty-state">
            <h2>友情链接暂未配置</h2>
            <p>后续可以在这里补充合作站点与推荐资源。</p>
        </div>
    }
    else
    {
        <div class="friend-links__grid">
            @foreach (var link in Model.Links.OrderBy(item => item.Index))
            {
                var tooltip = !string.IsNullOrWhiteSpace(link.Description)
                    ? $"{link.Title} - {link.Description}"
                    : link.Title;
                <a href="@link.Link" target="_blank" rel="noreferrer" title="@tooltip" aria-label="@tooltip" class="friend-link-card">
                    <span class="friend-link-card__title">@link.Title</span>
                </a>
            }
        </div>
    }
</div>
