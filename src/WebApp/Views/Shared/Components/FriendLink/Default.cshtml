@model WebApp.Components.FriendLinkViewModel

<div class="friend-links mt-4 mb-4">
    <div class="d-flex flex-wrap align-items-center justify-content-center">
        <span class="me-3 mb-2">
            <i class="fas fa-link me-2"></i>友情链接
        </span>
        @if (Model.Links?.Any() != true)
        {
            <span class="text-muted">暂无友情链接</span>
        }
        else
        {
            <div class="tech-links-container">
                @foreach (var link in Model.Links)
                {
                    <a href="@link.Link" target="_blank" title="@link.Description" class="tech-link">
                        <span class="link-text">@link.Title</span>
                    </a>
                }
            </div>
        }
    </div>
</div>

<style>
    .tech-links-container {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        padding: 16px 24px;
        background: #f8f9fa;
        border-radius: 12px;
        border: 1px solid #e9ecef;
        transition: all 0.3s ease;
    }

    .tech-link {
        position: relative;
        padding: 8px 16px;
        color: #333;
        text-decoration: none;
        background: #fff;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        transition: all 0.3s ease;
        font-size: 0.9rem;
        font-weight: 500;
        display: flex;
        align-items: center;
    }

    .tech-link:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(0, 123, 255, 0.25);
        border-color: #007bff;
        color: #007bff;
    }

    .link-text::before {
        content: '# ';
        color: #007bff;
        margin-right: 4px;
    }

    @@media (max-width: 768px) {
        .tech-links-container {
            padding: 12px 16px;
            gap: 8px;
        }

        .tech-link {
            padding: 6px 12px;
            font-size: 0.85rem;
        }
    }
</style>
