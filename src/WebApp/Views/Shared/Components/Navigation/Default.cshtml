@model WebApp.Components.NavigationViewModel
@{
    var albums = Model.Albums.ToList();
    var categories = Model.Categories.ToList();
}

@if (albums.Any())
{
    <li class="nav-item dropdown">
        <button class="nav-link dropdown-toggle site-menu-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">专题</button>
        <div class="dropdown-menu nav-mega-menu">
            <div class="nav-mega-menu__header">
                <div>
                    <span class="nav-mega-menu__eyebrow">Albums</span>
                    <strong>按系列阅读文章</strong>
                </div>
                <span class="nav-mega-menu__badge">@albums.Count 个专题</span>
            </div>
            <div class="nav-menu-list">
                @foreach (var album in albums)
                {
                    <a class="nav-menu-link" href="/bbs/album/@album.Slug">
                        <span class="nav-menu-link__content">
                            <strong>@album.Name</strong>
                            @if (!string.IsNullOrWhiteSpace(album.Memo))
                            {
                                <small>@album.Memo</small>
                            }
                        </span>
                        @if (album.PostCount > 0)
                        {
                            <span class="nav-menu-link__count">@album.PostCount</span>
                        }
                    </a>
                }
            </div>
            <div class="nav-mega-menu__actions">
                <a href="/bbs/album">全部专题</a>
                <a href="/bbs">最新文章</a>
            </div>
        </div>
    </li>
}

@if (categories.Any())
{
    <li class="nav-item dropdown">
        <button class="nav-link dropdown-toggle site-menu-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">分类</button>
        <div class="dropdown-menu nav-mega-menu">
            <div class="nav-mega-menu__header">
                <div>
                    <span class="nav-mega-menu__eyebrow">Categories</span>
                    <strong>按技术主题筛选</strong>
                </div>
                <span class="nav-mega-menu__badge">@categories.Count 个分类</span>
            </div>
            <div class="nav-menu-list">
                @foreach (var category in categories)
                {
                    <a class="nav-menu-link" href="/Bbs/Category/@category.Slug">
                        <span class="nav-menu-link__content">
                            <strong>@category.Name</strong>
                            @if (!string.IsNullOrWhiteSpace(category.Memo))
                            {
                                <small>@category.Memo</small>
                            }
                        </span>
                        @if (category.PostCount > 0)
                        {
                            <span class="nav-menu-link__count">@category.PostCount</span>
                        }
                    </a>
                }
            </div>
            <div class="nav-mega-menu__actions">
                <a href="/Bbs/Category">全部分类</a>
                <a href="/bbs">最新文章</a>
            </div>
        </div>
    </li>
}
