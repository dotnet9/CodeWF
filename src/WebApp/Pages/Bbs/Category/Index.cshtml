@page "/Bbs/Category/{slug}"
@model WebApp.Pages.Bbs.Category.IndexModel
@{    ViewData["Title"] = $"{Model.CategoryName} - 博客分类";}

<div class="container">
    <h1 class="mb-4">@Model.CategoryName</h1>
    <div class="row">
        <div class="col-md-8">
            <div class="card-grid">
                @if (Model.Posts == null || !Model.Posts.Any())
                {
                    <div class="col-12 text-center py-8">
                        <p>该分类下暂无文章</p>
                    </div>
                }
                else
                {
                    foreach (var post in Model.Posts)
                    {
                        <div class="card shadow-sm mb-4">
                            <div class="row g-0">
                                @if (!string.IsNullOrEmpty(post.Cover))
                                {
                                    <div class="col-md-3">
                                        <a href="/Bbs/Post/@post.Date?.Year/@post.Date?.Month/@post.Slug">
                                            <img src="@post.Cover" class="img-fluid rounded-start" alt="@post.Title" style="width: 100%; height: 100%; object-fit: cover;">
                                        </a>
                                    </div>
                                }
                                <div class="col-md-9">
                                    <div class="card-body">
                                        <a href="/Bbs/Post/@post.Date?.Year/@post.Date?.Month/@post.Slug" class="text-decoration-none">
                                            <h4 class="card-title text-dark">@post.Title</h4>
                                        </a>
                                        <p class="card-text text-muted">@post.Description</p>
                                        <div class="d-flex justify-content-between align-items-center">
                                            <small class="text-muted">作者：@(string.IsNullOrEmpty(post.Author) ? Model.Owner : post.Author)</small>
                                            <small class="text-muted">@post.Date?.ToString("yyyy-MM-dd HH:mm:ss")</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-header">
                    文章分类
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        @foreach (var category in Model.Categories)
                        {
                            <li class="list-group-item">
                                <a href="/Bbs/Category/@category.Slug">@category.Name</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>