@page "/Bbs/Post/{year:int}/{month:int}/{slug}"
@model WebApp.Pages.Bbs.Post.IndexModel
@{
    ViewData["Title"] = Model.Post?.Title ?? "文章详情";
    ViewData["Description"] = Model.Post?.Description ?? "浏览码坊技术文章。";
}

@section Head {
    <partial name="_CodeHighlightHead" />
}

<section class="page-shell">
    <div class="container">
        @if (Model.Post == null)
        {
            <div class="empty-state">
                <h2>文章不存在或已下线</h2>
                <p>可以返回博客首页继续浏览其他内容。</p>
            </div>
        }
        else
        {
            <div class="page-banner">
                <div>
                    <span class="eyebrow">Article</span>
                    <h1 class="page-title">@Model.Post.Title</h1>
                    @if (!string.IsNullOrWhiteSpace(Model.Post.Description))
                    {
                        <p class="page-description">@Model.Post.Description</p>
                    }
                </div>
                <div class="page-banner__meta">
                    <span class="meta-chip"><i class="far fa-calendar"></i>发布于 @Model.Post.Date?.ToString("yyyy-MM-dd")</span>
                    @if (Model.Post.Lastmod.HasValue)
                    {
                        <span class="meta-chip"><i class="fas fa-rotate-right"></i>更新于 @Model.Post.Lastmod.Value.ToString("yyyy-MM-dd")</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Post.Author))
                    {
                        <span class="meta-chip"><i class="far fa-user"></i>@Model.Post.Author</span>
                    }
                </div>
            </div>

            <div class="article-layout">
                <div class="article-main">
                    @if (!string.IsNullOrWhiteSpace(Model.Post.Cover))
                    {
                        <div class="surface-panel article-cover">
                            <img src="@Model.Post.Cover" alt="@Model.Post.Title" class="cover-media cover-media--hero" decoding="async" fetchpriority="high" />
                        </div>
                    }

                    <article class="surface-panel article-panel">
                        @if (Model.Post.Categories?.Any() == true)
                        {
                            <div class="chip-row">
                                @foreach (var category in Model.Post.Categories)
                                {
                                    <span class="tag-chip"><i class="fas fa-folder-open"></i>@category</span>
                                }
                            </div>
                        }

                        @if (Model.Post.Tags?.Any() == true)
                        {
                            <div class="chip-row chip-row--secondary">
                                @foreach (var tag in Model.Post.Tags)
                                {
                                    <span class="tag-chip tag-chip--muted"><i class="fas fa-hashtag"></i>@tag</span>
                                }
                            </div>
                        }

                        <div class="prose article-content" data-reading-body>
                            @Html.Raw(Model.Post.HtmlContent)
                        </div>
                    </article>

                    @if (Model.PreviousPost != null || Model.NextPost != null)
                    {
                        <nav class="doc-pager" aria-label="文章阅读导航">
                            @if (Model.PreviousPost != null)
                            {
                                var previousUrl = $"/Bbs/Post/{Model.PreviousPost.Date?.Year}/{Model.PreviousPost.Date?.Month}/{Model.PreviousPost.Slug}";
                                <a href="@previousUrl" class="surface-panel doc-pager__item doc-pager__item--prev">
                                    <span class="doc-pager__label">
                                        <i class="fas fa-arrow-left"></i>
                                        上一篇
                                    </span>
                                    <strong>@Model.PreviousPost.Title</strong>
                                    @if (!string.IsNullOrWhiteSpace(Model.PreviousPost.Description))
                                    {
                                        <p>@Model.PreviousPost.Description</p>
                                    }
                                </a>
                            }
                            else
                            {
                                <div class="surface-panel doc-pager__item doc-pager__item--empty" aria-hidden="true"></div>
                            }

                            @if (Model.NextPost != null)
                            {
                                var nextUrl = $"/Bbs/Post/{Model.NextPost.Date?.Year}/{Model.NextPost.Date?.Month}/{Model.NextPost.Slug}";
                                <a href="@nextUrl" class="surface-panel doc-pager__item doc-pager__item--next">
                                    <span class="doc-pager__label">
                                        下一篇
                                        <i class="fas fa-arrow-right"></i>
                                    </span>
                                    <strong>@Model.NextPost.Title</strong>
                                    @if (!string.IsNullOrWhiteSpace(Model.NextPost.Description))
                                    {
                                        <p>@Model.NextPost.Description</p>
                                    }
                                </a>
                            }
                            else
                            {
                                <div class="surface-panel doc-pager__item doc-pager__item--empty" aria-hidden="true"></div>
                            }
                        </nav>
                    }
                </div>

                <aside class="article-aside sticky-panel">
                    <div id="toc" class="surface-panel toc-panel" data-reading-toc>
                        <h2 class="sidebar-title">目录</h2>
                        <div class="toc-nav"></div>
                    </div>
                </aside>
            </div>
        }
    </div>
</section>

@section Scripts {
    <partial name="_CodeHighlightScripts" />
}
