@page "/Bbs/Post/{year:int}/{month:int}/{slug}"
@model WebApp.Pages.Bbs.Post.IndexModel
@{
    ViewData["Title"] = Model.Post?.Title ?? "文章详情 - 码坊";
}

<div class="container">
    @if (Model.Post != null)
    {
        <div class="row">
            <div class="col-lg-8">
                <article class="mb-4">
                    <h1 class="mb-4">@Model.Post.Title</h1>
                    <div class="text-muted mb-4">
                        <span>发布时间：@Model.Post.Date?.ToString("yyyy-MM-dd")</span>
                        @if (Model.Post.Lastmod.HasValue)
                        {
                            <span class="ml-4">更新时间：@Model.Post.Lastmod.Value.ToString("yyyy-MM-dd")</span>
                        }
                        @if (!string.IsNullOrEmpty(Model.Post.Author))
                        {
                            <span class="ml-4">作者：@Model.Post.Author</span>
                        }
                    </div>

                    @if (Model.Post.Categories != null && Model.Post.Categories.Any())
                    {
                        <div class="mb-4">
                            <strong>分类：</strong>
                            @foreach (var category in Model.Post.Categories)
                            {
                                <span class="badge bg-primary mr-2">@category</span>
                            }
                        </div>
                    }

                    @if (Model.Post.Tags != null && Model.Post.Tags.Any())
                    {
                        <div class="mb-4">
                            <strong>标签：</strong>
                            @foreach (var tag in Model.Post.Tags)
                            {
                                <span class="badge bg-secondary mr-2">@tag</span>
                            }
                        </div>
                    }

                    <div class="content" data-toggle="toc" data-spy="scroll" data-target="#toc">
                        @Html.Raw(Model.Post.HtmlContent)
                    </div>
                </article>
            </div>
            <div class="col-lg-4">
                <nav id="toc" class="navbar navbar-light bg-light flex-column align-items-start p-3 sticky-top">
                    <h5 class="mb-3">目录</h5>
                    <nav class="nav nav-pills flex-column"></nav>
                </nav>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-danger">
            文章不存在或已被删除
        </div>
    }
</div>

<style>
    #toc {
        top: 100px;
        max-height: calc(100vh - 120px);
        overflow-y: auto;
    }

    #toc .nav-link {
        font-size: 0.85rem;
        padding: 0.25rem 0.75rem;
    }

    #toc .nav-pills .nav-link.active,
    #toc .nav-pills .show > .nav-link {
        background-color: #007bff;
        color: white;
    }

    .content h2 {
        margin-top: 2rem;
        padding-top: 1rem;
    }

    .content h3 {
        margin-top: 1.5rem;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            if (typeof Prism !== 'undefined') {
                Prism.highlightAll();
            }

            $('[data-toggle="toc"]').each(function() {
                var $this = $(this);
                var entries = [];

                $this.find('h2, h3, h4').each(function() {
                    var $heading = $(this);
                    var level = parseInt(this.tagName.substring(1)) - 1;
                    var text = $heading.text();
                    var id = $heading.attr('id') || text.toLowerCase().replace(/[^a-z0-9]+/g, '-');

                    if (!$heading.attr('id')) {
                        $heading.attr('id', id);
                    }

                    entries.push({
                        level: level,
                        id: id,
                        text: text
                    });
                });

                var $tocNav = $('#toc .nav');
                entries.forEach(function(entry) {
                    var $link = $('<a class="nav-link"></a>')
                        .attr('href', '#' + entry.id)
                        .text(entry.text)
                        .css('padding-left', (entry.level * 0.75) + 'rem');

                    $tocNav.append($link);
                });

                $tocNav.find('a').on('click', function(e) {
                    e.preventDefault();
                    var targetId = $(this).attr('href');
                    $('html, body').animate({
                        scrollTop: $(targetId).offset().top - 80
                    }, 500);
                });
            });
        });
    </script>
}