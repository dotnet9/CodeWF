@page "/post"
@using Microsoft.Extensions.Options
@using WebApp.Extensions
@inject IOptions<WebApp.Options.SiteOption> SiteOptions
@model WebApp.Pages.Bbs.IndexModel
@{
    ViewData["Title"] = "博客";
    ViewData["Description"] = "浏览码坊博客内容，按时间查看最新技术文章。";
    var siteOwner = SiteOptions.Value.Owner ?? SiteOptions.Value.AppTitle ?? "码坊";
    var startPage = Math.Max(1, Model.PageIndex - 2);
    var endPage = Math.Min(Model.TotalPages, Model.PageIndex + 2);
    if (endPage - startPage < 4)
    {
        if (startPage == 1)
        {
            endPage = Math.Min(Model.TotalPages, startPage + 4);
        }
        else if (endPage == Model.TotalPages)
        {
            startPage = Math.Max(1, endPage - 4);
        }
    }
}

<section class="page-shell">
    <div class="container">
        <div class="page-banner">
            <div>
                <span class="eyebrow">Blog</span>
                <h1 class="page-title">技术文章</h1>
                <p class="page-description">
                    这里收录站点的文章正文，覆盖 .NET、桌面开发、工程实践与通用开发话题。
                </p>
            </div>
            <div class="page-banner__stats">
                <div class="stat-chip">
                    <strong>@Model.Total</strong>
                    <span>篇文章</span>
                </div>
                <div class="stat-chip">
                    <strong>@Math.Max(0, Model.Categories.Count - 1)</strong>
                    <span>个分类</span>
                </div>
            </div>
        </div>

        <div class="discovery-grid">
            <section class="surface-panel discovery-panel">
                <div class="surface-panel__header">
                    <div>
                        <span class="eyebrow">First Visit</span>
                        <h2 class="surface-title">新用户起步路线</h2>
                    </div>
                </div>
                <div class="discovery-link-list">
                    @foreach (var link in Model.GettingStartedLinks)
                    {
                        <a href="@link.Url" class="discovery-link-card">
                            <span class="card-kicker">@link.Eyebrow</span>
                            <strong>@link.Title</strong>
                            <p>@link.Description</p>
                        </a>
                    }
                </div>
            </section>

            <section class="surface-panel discovery-panel">
                <div class="surface-panel__header">
                    <div>
                        <span class="eyebrow">Unexpected Finds</span>
                        <h2 class="surface-title">随机发现</h2>
                    </div>
                </div>

                @if (!Model.RandomPosts.Any())
                {
                    <div class="empty-state empty-state--compact">
                        <p>这里会轮换一些值得顺手点开的文章。</p>
                    </div>
                }
                else
                {
                    <div class="discovery-post-list">
                        @foreach (var post in Model.RandomPosts)
                        {
                            <article class="discovery-post-card">
                                <span class="card-kicker">@post.Eyebrow</span>
                                <h3><a href="@post.Url">@post.Title</a></h3>
                                <p>@post.Description</p>
                                <div class="resource-card__meta">
                                    <span><i class="far fa-compass"></i>@post.MetaLabel</span>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        </div>

        <div class="content-grid">
            <div class="content-primary">
                @if (!Model.Posts.Any())
                {
                    <div class="empty-state">
                        <h2>还没有文章</h2>
                        <p>当前博客列表为空，后续内容会在这里展示。</p>
                    </div>
                }
                else
                {
                    <div class="post-list">
                        @foreach (var post in Model.Posts)
                        {
                            var postUrl = ConstantUtil.GetBbsPostUrl(post);
                            var hasCover = !string.IsNullOrWhiteSpace(post.Cover);
                            var authorName = string.IsNullOrWhiteSpace(post.Author) ? siteOwner : post.Author;

                            <article class="post-list-card @(hasCover ? string.Empty : "post-list-card--text-only")">
                                @if (hasCover)
                                {
                                    <a href="@postUrl" class="post-list-card__cover">
                                        <img src="@post.Cover" alt="@post.Title" class="cover-media" loading="lazy" decoding="async" />
                                    </a>
                                }

                                <div class="post-list-card__body">
                                    <h2 class="post-list-card__title">
                                        <a href="@postUrl">@post.Title</a>
                                    </h2>
                                    @if (!string.IsNullOrWhiteSpace(post.Description))
                                    {
                                        <p class="post-list-card__excerpt">@post.Description</p>
                                    }
                                    <div class="meta-line">
                                        <span><i class="far fa-calendar"></i>@post.Date?.ToString("yyyy-MM-dd")</span>
                                        <span><i class="far fa-user"></i>@authorName</span>
                                        @if (post.Categories?.Any() == true)
                                        {
                                            <span><i class="far fa-folder-open"></i>@string.Join(" / ", post.Categories.Take(2))</span>
                                        }
                                    </div>
                                    <a href="@postUrl" class="inline-link">
                                        阅读全文
                                        <i class="fas fa-arrow-right"></i>
                                    </a>
                                </div>
                            </article>
                        }
                    </div>
                }

                @if (Model.TotalPages > 1)
                {
                    <nav class="pagination-shell" aria-label="博客分页">
                        <p class="pagination-summary">第 @Model.PageIndex / @Model.TotalPages 页，共 @Model.Total 篇文章</p>
                        <ul class="pagination justify-content-center pagination-list">
                            <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : "")">
                                <a class="page-link" href="@ConstantUtil.GetBlogUrl(Model.PageIndex - 1)">上一页</a>
                            </li>
                            @if (startPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@ConstantUtil.GetBlogUrl(1)">1</a>
                                </li>
                                @if (startPage > 2)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                            }
                            @for (var i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(Model.PageIndex == i ? "active" : "")">
                                    <a class="page-link" href="@ConstantUtil.GetBlogUrl(i)">@i</a>
                                </li>
                            }
                            @if (endPage < Model.TotalPages)
                            {
                                @if (endPage < Model.TotalPages - 1)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                                <li class="page-item">
                                    <a class="page-link" href="@ConstantUtil.GetBlogUrl(Model.TotalPages)">@Model.TotalPages</a>
                                </li>
                            }
                            <li class="page-item @(Model.PageIndex >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@ConstantUtil.GetBlogUrl(Model.PageIndex + 1)">下一页</a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>

            <aside class="content-sidebar">
                <div class="surface-panel sidebar-panel sticky-panel">
                    <h2 class="sidebar-title">文章分类</h2>
                    <p class="sidebar-copy">按分类浏览，更快定位你想看的技术主题。</p>
                    <div class="sidebar-link-list">
                        @foreach (var category in Model.Categories)
                        {
                            <a href="@ConstantUtil.GetBbsCategoryUrl(category.Slug ?? ConstantUtil.DefaultCategory)" class="sidebar-link">
                                <span>@category.Name</span>
                                <i class="fas fa-angle-right"></i>
                            </a>
                        }
                    </div>

                    @if (Model.SerialReadingLinks.Any())
                    {
                        <div class="sidebar-link-list sidebar-link-list--compact">
                            <span class="card-kicker">连续阅读</span>
                            @foreach (var link in Model.SerialReadingLinks)
                            {
                                <a href="@link.Url" class="sidebar-link">
                                    <span>
                                        @link.Title
                                        <small class="article-guide-link__desc">@link.Description</small>
                                    </span>
                                    <i class="fas fa-angle-right"></i>
                                </a>
                            }
                        </div>
                    }
                </div>
            </aside>
        </div>
    </div>
</section>
