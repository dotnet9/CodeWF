@page "/tag/{slug?}"
@using WebApp.Extensions
@model WebApp.Pages.Bbs.Tag.IndexModel
@{
    ViewData["Title"] = Model.IsDirectoryPage ? "标签" : $"{Model.TagName} - 标签";
    ViewData["Description"] = Model.IsDirectoryPage
        ? "浏览码坊全部文章标签。"
        : $"查看 {Model.TagName} 标签下的技术文章。";
    var tagSlug = Model.CurrentSlug ?? string.Empty;
}

<section class="page-shell">
    <div class="container">
        <div class="page-banner">
            <div>
                <span class="eyebrow">Tag</span>
                <h1 class="page-title">@(Model.IsDirectoryPage ? "全部标签" : Model.TagName)</h1>
                <p class="page-description">@(Model.IsDirectoryPage ? "按标签快速聚合站内文章。" : $"正在浏览与 {Model.TagName} 相关的文章。")</p>
            </div>
            @if (!Model.IsDirectoryPage)
            {
                <div class="page-banner__stats">
                    <div class="stat-chip">
                        <strong>@Model.Total</strong>
                        <span>篇文章</span>
                    </div>
                    <div class="stat-chip">
                        <strong>@Model.PageIndex</strong>
                        <span>当前页</span>
                    </div>
                </div>
            }
        </div>

        @if (Model.IsDirectoryPage)
        {
            <div class="surface-panel directory-panel">
                @if (!Model.Tags.Any())
                {
                    <div class="empty-state">
                        <h2>暂未整理标签</h2>
                        <p>后续会在这里展示文章标签。</p>
                    </div>
                }
                else
                {
                    <div class="directory-grid">
                        @foreach (var tag in Model.Tags)
                        {
                            <a href="@Model.GetTagUrl(tag.Name)" class="directory-card">
                                <strong>@tag.Name</strong>
                                <p>@tag.PostCount 篇文章使用了这个标签。</p>
                                <span class="directory-card__action">
                                    查看标签
                                    <i class="fas fa-arrow-right"></i>
                                </span>
                            </a>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="content-grid">
                <div class="content-primary">
                    @if (!Model.Posts.Any())
                    {
                        <div class="empty-state">
                            <h2>这个标签下还没有文章</h2>
                            <p>可以返回标签列表或博客首页继续浏览。</p>
                        </div>
                    }
                    else
                    {
                        <div class="post-list">
                            @foreach (var post in Model.Posts)
                            {
                                var postUrl = ConstantUtil.GetBbsPostUrl(post);
                                var hasCover = !string.IsNullOrWhiteSpace(post.Cover);
                                <article class="post-list-card @(hasCover ? string.Empty : "post-list-card--text-only")">
                                    @if (hasCover)
                                    {
                                        <a href="@postUrl" class="post-list-card__cover">
                                            <img src="@post.Cover" alt="@post.Title" class="cover-media" loading="lazy" decoding="async" />
                                        </a>
                                    }
                                    <div class="post-list-card__body">
                                        <h2 class="post-list-card__title"><a href="@postUrl">@post.Title</a></h2>
                                        @if (!string.IsNullOrWhiteSpace(post.Description))
                                        {
                                            <p class="post-list-card__excerpt">@post.Description</p>
                                        }
                                        <div class="meta-line">
                                            <span><i class="far fa-user"></i>@(string.IsNullOrWhiteSpace(post.Author) ? Model.Owner : post.Author)</span>
                                            <span><i class="far fa-calendar"></i>@post.Date?.ToString("yyyy-MM-dd HH:mm")</span>
                                        </div>
                                        <a href="@postUrl" class="inline-link">
                                            阅读全文
                                            <i class="fas fa-arrow-right"></i>
                                        </a>
                                    </div>
                                </article>
                            }
                        </div>
                    }

                    @if (Model.TotalPages > 1)
                    {
                        <nav class="pagination-shell" aria-label="标签分页">
                            <p class="pagination-summary">第 @Model.PageIndex / @Model.TotalPages 页，共 @Model.Total 篇文章</p>
                            <ul class="pagination justify-content-center pagination-list">
                                <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : "")">
                                    <a class="page-link" href="@Model.GetTagUrl(tagSlug)?pageIndex=@(Model.PageIndex - 1)">上一页</a>
                                </li>
                                @{
                                    var startPage = Math.Max(1, Model.PageIndex - 2);
                                    var endPage = Math.Min(Model.TotalPages, Model.PageIndex + 2);
                                    if (endPage - startPage < 4)
                                    {
                                        if (startPage == 1)
                                        {
                                            endPage = Math.Min(Model.TotalPages, startPage + 4);
                                        }
                                        else if (endPage == Model.TotalPages)
                                        {
                                            startPage = Math.Max(1, endPage - 4);
                                        }
                                    }
                                }
                                @if (startPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Model.GetTagUrl(tagSlug)?pageIndex=1">1</a>
                                    </li>
                                    @if (startPage > 2)
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    }
                                }
                                @for (var i = startPage; i <= endPage; i++)
                                {
                                    <li class="page-item @(Model.PageIndex == i ? "active" : "")">
                                        <a class="page-link" href="@Model.GetTagUrl(tagSlug)?pageIndex=@i">@i</a>
                                    </li>
                                }
                                @if (endPage < Model.TotalPages)
                                {
                                    @if (endPage < Model.TotalPages - 1)
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    }
                                    <li class="page-item">
                                        <a class="page-link" href="@Model.GetTagUrl(tagSlug)?pageIndex=@Model.TotalPages">@Model.TotalPages</a>
                                    </li>
                                }
                                <li class="page-item @(Model.PageIndex >= Model.TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="@Model.GetTagUrl(tagSlug)?pageIndex=@(Model.PageIndex + 1)">下一页</a>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>

                <aside class="content-sidebar">
                    <div class="surface-panel sidebar-panel sticky-panel">
                        <h2 class="sidebar-title">全部标签</h2>
                        <div class="sidebar-link-list">
                            @foreach (var tag in Model.Tags)
                            {
                                <a href="@Model.GetTagUrl(tag.Name)" class="sidebar-link @(string.Equals(tag.Name, Model.TagName, StringComparison.OrdinalIgnoreCase) ? "is-current" : string.Empty)">
                                    <span>@tag.Name</span>
                                    <i class="fas fa-angle-right"></i>
                                </a>
                            }
                        </div>
                    </div>
                </aside>
            </div>
        }
    </div>
</section>
