@page "/timeline"
@model WebApp.Pages.TimeLineModel
@{
    ViewData["Title"] = "时间线";
    ViewData["Description"] = "查看码坊站点和内容建设的时间线记录。";
}

<section class="page-shell">
    <div class="container">
        <div class="page-banner">
            <div>
                <span class="eyebrow">Timeline</span>
                <h1 class="page-title">时间线</h1>
                <p class="page-description">
                    用时间轴回看站点的迭代与内容节点，让长期建设更容易被感知。
                </p>
            </div>
        </div>

        @if (Model.TimeLines == null || !Model.TimeLines.Any())
        {
            <div class="empty-state">
                <h2>暂无时间线数据</h2>
                <p>后续的关键版本和里程碑会展示在这里。</p>
            </div>
        }
        else
        {
            <div class="timeline-stream">
                @foreach (var item in Model.TimeLines.OrderByDescending(t => t.Time))
                {
                    <div class="timeline-item">
                        <div class="timeline-date">@item.Time?.ToString("yyyy-MM")</div>
                        <div class="timeline-card">
                            <h2>@item.Title</h2>
                            <p>@item.Content</p>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
