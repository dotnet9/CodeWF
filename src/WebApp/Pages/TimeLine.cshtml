@page "/timeline"
@model WebApp.Pages.TimeLineModel
@{
    ViewData["Title"] = I18n.T("nav.timeline", "时间线");
    ViewData["Description"] = I18n.T("timeline.description", "查看码坊站点和内容建设的时间线记录。");
    var banner = new WebApp.Models.PageBannerViewModel
    {
        Eyebrow = I18n.T("timeline.eyebrow", "时间线"),
        Title = I18n.T("nav.timeline", "时间线"),
        Description = I18n.T("timeline.intro", "用时间轴回看站点的迭代与内容节点，让长期建设更容易被感知。")
    };
}

<section class="page-shell">
    <div class="container">
        <partial name="_PageBanner" model="banner" />

        @if (Model.TimeLines == null || !Model.TimeLines.Any())
        {
            <div class="empty-state">
                <h2>@I18n.T("timeline.emptyTitle", "暂无时间线数据")</h2>
                <p>@I18n.T("timeline.emptyDescription", "后续的关键版本和里程碑会展示在这里。")</p>
            </div>
        }
        else
        {
            <div class="timeline-stream">
                @foreach (var item in Model.TimeLines.OrderByDescending(t => t.Time))
                {
                    <div class="timeline-item">
                        <div class="timeline-date">@item.Time?.ToString("yyyy-MM")</div>
                        <div class="timeline-card">
                            <h2>@I18n.Text(item.Title)</h2>
                            <p>@I18n.Text(item.Content)</p>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>
