@using Microsoft.Extensions.Options
@using WebApp.Options
@using WebApp.Services
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@inject IOptions<SiteOption> SiteOptions
@inject WebApp.Services.I18nService I18n
@{
    var site = SiteOptions.Value;
    var appTitle = I18n.T("site.name", site.AppTitle ?? "码坊");
    var rawPageTitle = ViewData["Title"] as string;
    var pageTitle = I18n.Text(rawPageTitle);
    var bodyClass = ViewData["BodyClass"] as string;
    var siteDescription = I18n.Text(ViewData["Description"] as string)
        ?? I18n.T("site.description", site.Memo ?? "面向 .NET 开发者的技术内容、项目说明与在线工具站点。");
    if (string.IsNullOrWhiteSpace(siteDescription))
    {
        siteDescription = I18n.T("site.description", site.Memo ?? "面向 .NET 开发者的技术内容、项目说明与在线工具站点。");
    }

    var siteKeywords = I18n.Text(ViewData["Keywords"] as string)
        ?? I18n.T("site.keywords", ".NET,C#,ASP.NET Core,Razor Pages,开发工具,技术文章,开源项目,码坊");
    if (string.IsNullOrWhiteSpace(siteKeywords))
    {
        siteKeywords = I18n.T("site.keywords", ".NET,C#,ASP.NET Core,Razor Pages,开发工具,技术文章,开源项目,码坊");
    }

    var requestPath = Context.Request.Path.ToUriComponent();
    var isHomeTitle = requestPath.Equals("/", StringComparison.OrdinalIgnoreCase)
        || string.IsNullOrWhiteSpace(rawPageTitle)
        || string.Equals(rawPageTitle, "首页", StringComparison.OrdinalIgnoreCase);
    var pageTitleText = isHomeTitle || string.IsNullOrWhiteSpace(pageTitle)
        ? appTitle
        : $"{pageTitle} - {appTitle}";
    var siteDomain = (site.Domain ?? $"{Context.Request.Scheme}://{Context.Request.Host}").TrimEnd('/');
    var canonicalPath = RequestLanguage.LocalizePath(ViewData["CanonicalPath"] as string ?? requestPath);
    if (string.IsNullOrWhiteSpace(canonicalPath))
    {
        canonicalPath = RequestLanguage.LocalizePath("/");
    }

    if (!canonicalPath.StartsWith('/'))
    {
        canonicalPath = $"/{canonicalPath}";
    }

    // 统一把站内相对路径提升为绝对地址，供 canonical、OG 和 Twitter Card 共用。
    string ToAbsoluteUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            return $"{siteDomain}/";
        }

        return Uri.TryCreate(url, UriKind.Absolute, out _)
            ? url
            : $"{siteDomain}/{url.TrimStart('/')}";
    }

    var canonicalUrl = ToAbsoluteUrl(ViewData["CanonicalUrl"] as string ?? canonicalPath);
    var ogImage = ToAbsoluteUrl(ViewData["OgImage"] as string ?? site.Favicon ?? "/favicon.png");
    var ogType = ViewData["OgType"] as string ?? "website";
    // 搜索结果页不参与索引，但允许爬虫继续跟随结果链接抓正文。
    var robots = ViewData["Robots"] as string
        ?? (requestPath.Equals("/s", StringComparison.OrdinalIgnoreCase)
            ? "noindex,follow"
            : "index,follow,max-image-preview:large");
    var articlePublishedTime = ViewData["ArticlePublishedTime"] as string;
    var articleModifiedTime = ViewData["ArticleModifiedTime"] as string;
    var articleAuthor = ViewData["ArticleAuthor"] as string;
    var language = I18n.CurrentLanguageInfo;
    var rssUrl = ToAbsoluteUrl(RequestLanguage.LocalizePath("/rss"));
}
<!DOCTYPE html>
<html lang="@language.HtmlLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="@robots" />
    <meta name="keywords" content="@siteKeywords" />
    <meta name="description" content="@siteDescription" />
    <meta name="theme-color" content="#0f172a" />
    <link rel="canonical" href="@canonicalUrl" />
    @foreach (var item in I18n.SeoLanguages)
    {
        <link rel="alternate" hreflang="@item.Code" href="@ToAbsoluteUrl(I18n.SwitchPath(item.Code))" />
    }
    <link rel="alternate" type="application/rss+xml" title="@($"{appTitle} RSS")" href="@rssUrl" />
    <meta property="og:locale" content="@language.OgLocale" />
    <meta property="og:site_name" content="@appTitle" />
    <meta property="og:type" content="@ogType" />
    <meta property="og:title" content="@pageTitleText" />
    <meta property="og:description" content="@siteDescription" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:image" content="@ogImage" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@pageTitleText" />
    <meta name="twitter:description" content="@siteDescription" />
    <meta name="twitter:image" content="@ogImage" />
    @if (!string.IsNullOrWhiteSpace(articlePublishedTime))
    {
        <meta property="article:published_time" content="@articlePublishedTime" />
    }
    @if (!string.IsNullOrWhiteSpace(articleModifiedTime))
    {
        <meta property="article:modified_time" content="@articleModifiedTime" />
    }
    @if (!string.IsNullOrWhiteSpace(articleAuthor))
    {
        <meta property="article:author" content="@articleAuthor" />
    }
    <title>@pageTitleText</title>

    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    @* 非关键图标样式改为异步生效，避免它阻塞首屏正文渲染。 *@
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" media="print" onload="this.media='all'" />
    <noscript>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    </noscript>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
    <link rel="icon" type="image/png" href="~/favicon.png" asp-append-version="true" />
    @if (!HostEnvironment.IsDevelopment())
    {
        <script>
            window.addEventListener("load", () => {
                // Defer analytics until the main content is stable.
                const loadAnalytics = () => {
                    const analytics = document.createElement("script");
                    analytics.async = true;
                    analytics.src = "https://hm.baidu.com/hm.js?b1c5c62f256893710ae912468261bf6b";
                    document.head.appendChild(analytics);
                };

                if ("requestIdleCallback" in window) {
                    window.requestIdleCallback(loadAnalytics, { timeout: 2500 });
                    return;
                }

                window.setTimeout(loadAnalytics, 1500);
            }, { once: true });
        </script>
    }
</head>
<body class="@bodyClass">
    <partial name="_SiteHeader" />

    <main class="site-main">
        @RenderBody()
    </main>

    <partial name="_SiteFooter" />

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script>
        window.CodeWFI18n = @Html.Raw(I18n.GetClientResourceJson());
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
