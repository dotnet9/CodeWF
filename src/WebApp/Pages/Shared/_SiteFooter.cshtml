@using Microsoft.Extensions.Options
@inject IOptions<WebApp.Options.SiteOption> SiteOptions
@{
    var site = SiteOptions.Value;
    var appTitle = site.AppTitle ?? "码坊";
    var defaultSiteDescription = site.Memo
        ?? "面向 .NET 开发者的技术内容、专题文档与在线工具站点。";
}

<section class="site-links-shell">
    <div class="container">
        @await Component.InvokeAsync("FriendLink")
    </div>
</section>

<footer class="site-footer">
    <div class="container">
        <div class="surface-panel footer-shell">
            <div class="footer-grid">
                <div class="footer-brand">
                    <span class="footer-brand__mark">@appTitle</span>
                    <p class="footer-brand__copy">@defaultSiteDescription</p>
                    <div class="footer-badges">
                        <span>.NET 11</span>
                        <span>Razor Pages</span>
                        <span>技术内容沉淀</span>
                    </div>
                </div>

                <div>
                    <h2 class="footer-title">站点导航</h2>
                    <ul class="footer-list">
                        <li><a href="/bbs">博客</a></li>
                        <li><a href="/doc">文档</a></li>
                        <li><a href="/tool">工具</a></li>
                        <li><a href="/timeline">时间线</a></li>
                    </ul>
                </div>

                <div>
                    <h2 class="footer-title">社区链接</h2>
                    <ul class="footer-list">
                        <li><a href="https://www.cnblogs.com/Dotnet9-com" target="_blank" rel="noreferrer">博客园</a></li>
                        <li><a href="https://space.bilibili.com/470546606" target="_blank" rel="noreferrer">B 站</a></li>
                        <li><a href="https://github.com/dotnet9" target="_blank" rel="noreferrer">GitHub</a></li>
                        <li><a href="https://irihi.tech/" target="_blank" rel="noreferrer">铱泓科技</a></li>
                    </ul>
                </div>

                <div>
                    <h2 class="footer-title">常用入口</h2>
                    <ul class="footer-list">
                        <li><a href="/about">关于站点</a></li>
                        <li><a href="/donation">支持作者</a></li>
                        <li><a href="/rss" target="_blank" rel="noreferrer">RSS 订阅</a></li>
                        <li><a href="/sitemap" target="_blank" rel="noreferrer">站点地图</a></li>
                    </ul>
                </div>

                <div class="footer-qr">
                    <img src="@(site.WeChatImg ?? "https://img1.dotnet9.com/site/favicon/wechatpublic.jpg")" alt="@($"{site.WeChatName ?? appTitle} 微信公众号")" loading="lazy" decoding="async" />
                    <p>关注公众号<br />@(site.WeChatName ?? appTitle)</p>
                </div>
            </div>

            <div class="footer-bottom">
                <span>&copy; @site.StartYear-@DateTime.Now.Year @(site.Owner ?? "码坊")</span>
                @if (!string.IsNullOrWhiteSpace(site.BaiAn))
                {
                    <span>@site.BaiAn</span>
                }
            </div>
        </div>
    </div>
</footer>
