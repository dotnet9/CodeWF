@using Microsoft.Extensions.Options
@using WebApp.Extensions
@using WebApp.Services
@inject IOptions<WebApp.Options.SiteOption> SiteOptions
@inject WebApp.Services.I18nService I18n
@{
    var site = SiteOptions.Value;
    var appTitle = I18n.T("site.name", site.AppTitle ?? "码坊");
    var defaultSiteDescription = I18n.T("footer.tagline", "技术文章、项目说明与在线工具");
}

<section class="site-links-shell">
    <div class="container">
        @await Component.InvokeAsync("FriendLink")
    </div>
</section>

<footer class="site-footer">
    <div class="container">
        <div class="surface-panel footer-shell">
            <div class="footer-grid">
                <div class="footer-brand">
                    <span class="footer-brand__mark">@appTitle</span>
                    <p class="footer-brand__copy">@defaultSiteDescription</p>
                </div>

                <div>
                    <h2 class="footer-title">@I18n.T("footer.navigation", "导航")</h2>
                    <ul class="footer-list">
                        <li><a href="@ConstantUtil.GetBlogUrl()">@I18n.T("nav.blog", "博客")</a></li>
                        <li><a href="@ConstantUtil.GetProjectDirectoryUrl()">@I18n.T("nav.projects", "项目")</a></li>
                        <li><a href="/tool">@I18n.T("nav.tools", "工具")</a></li>
                        <li><a href="@ConstantUtil.GetTagDirectoryUrl()">@I18n.T("nav.tags", "标签")</a></li>
                        <li><a href="/timeline">@I18n.T("nav.timeline", "时间线")</a></li>
                    </ul>
                </div>

                <div>
                    <h2 class="footer-title">@I18n.T("footer.community", "社区")</h2>
                    <ul class="footer-list">
                        <li><a href="https://www.cnblogs.com/Dotnet9-com" target="_blank" rel="noreferrer">博客园</a></li>
                        <li><a href="https://space.bilibili.com/470546606" target="_blank" rel="noreferrer">B 站</a></li>
                        <li><a href="https://github.com/dotnet9" target="_blank" rel="noreferrer">GitHub</a></li>
                        <li><a href="https://irihi.tech/" target="_blank" rel="noreferrer">银沫科技</a></li>
                    </ul>
                </div>

                <div>
                    <h2 class="footer-title">@I18n.T("footer.entries", "入口")</h2>
                    <ul class="footer-list">
                        <li><a href="/about">@I18n.T("footer.aboutSite", "关于站点")</a></li>
                        <li><a href="/donation">@I18n.T("footer.supportAuthor", "支持作者")</a></li>
                        <li><a href="https://github.com/dotnet9/CodeWF" target="_blank" rel="noreferrer">@I18n.T("footer.source", "查看源码")</a></li>
                        <li><a href="https://github.com/dotnet9/CodeWF/issues" target="_blank" rel="noreferrer">@I18n.T("footer.feedback", "反馈问题")</a></li>
                        <li><a href="/rss" target="_blank" rel="noreferrer">@I18n.T("footer.rss", "RSS 订阅")</a></li>
                        <li><a href="/sitemap" target="_blank" rel="noreferrer">@I18n.T("nav.sitemap", "站点地图")</a></li>
                    </ul>
                </div>

                <div>
                    <h2 class="footer-title">@I18n.T("language.title", "语言")</h2>
                    <label class="visually-hidden" for="footer-language-select">@I18n.T("language.switch", "切换语言")</label>
                    <select id="footer-language-select" class="footer-language-select" data-language-switch>
                        @foreach (var language in I18n.Languages)
                        {
                            var active = string.Equals(language.Code, I18n.CurrentLanguage, StringComparison.OrdinalIgnoreCase);
                            <option value="@I18n.SwitchUrl(language.Code)" lang="@language.HtmlLang" selected="@active">
                                @language.NativeName (@language.EnglishName)
                            </option>
                        }
                    </select>
                </div>

                <div class="footer-qr">
                    <img src="@(site.WeChatImg ?? "https://img1.dotnet9.com/site/favicon/wechatpublic.jpg")" alt="@I18n.Format("footer.wechatAlt", $"{site.WeChatName ?? appTitle} 微信公众号", site.WeChatName ?? appTitle)" loading="lazy" decoding="async" />
                    <p>@I18n.T("footer.followWechat", "关注公众号")<br />@(site.WeChatName ?? appTitle)</p>
                </div>
            </div>

            <div class="footer-bottom">
                <span>&copy; @site.StartYear-@DateTime.Now.Year @(site.Owner ?? "码坊")</span>
            </div>
        </div>
    </div>
</footer>
