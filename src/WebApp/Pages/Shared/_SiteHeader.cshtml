@using Microsoft.Extensions.Options
@using WebApp.Extensions
@inject IOptions<WebApp.Options.SiteOption> SiteOptions
@{
    var site = SiteOptions.Value;
    var appTitle = site.AppTitle ?? "码坊";
    var searchQuery = Context.Request.Query["q"].ToString();
    var currentPath = (Context.Request.Path.Value ?? "/").TrimEnd('/');
    if (string.IsNullOrEmpty(currentPath))
    {
        currentPath = "/";
    }

    var articleDetailActive = System.Text.RegularExpressions.Regex.IsMatch(
        currentPath,
        @"^/\d{4}/\d{1,2}/[^/]+$",
        System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    string NavClass(params string[] hrefs)
    {
        if (hrefs.Length == 1 && hrefs[0] == "/")
        {
            return currentPath == "/" ? "nav-link is-active" : "nav-link";
        }

        return hrefs.Any(href => currentPath.StartsWith(href, StringComparison.OrdinalIgnoreCase))
            ? "nav-link is-active"
            : "nav-link";
    }

    var blogActive = currentPath.StartsWith("/post", StringComparison.OrdinalIgnoreCase)
        || currentPath.StartsWith("/cat", StringComparison.OrdinalIgnoreCase)
        || currentPath.StartsWith("/album", StringComparison.OrdinalIgnoreCase)
        || currentPath.StartsWith("/tag", StringComparison.OrdinalIgnoreCase)
        || articleDetailActive;

    var moreActive = currentPath.StartsWith("/about", StringComparison.OrdinalIgnoreCase)
        || currentPath.StartsWith("/privacy", StringComparison.OrdinalIgnoreCase)
        || currentPath.StartsWith("/timeline", StringComparison.OrdinalIgnoreCase)
        || currentPath.StartsWith("/donation", StringComparison.OrdinalIgnoreCase)
        || currentPath.StartsWith("/rss", StringComparison.OrdinalIgnoreCase)
        || currentPath.StartsWith("/sitemap", StringComparison.OrdinalIgnoreCase);
}

<header class="site-header">
    <nav class="navbar navbar-expand-lg fixed-top site-navbar">
        <div class="container">
            <a class="navbar-brand site-brand" href="/">
                <span class="site-brand__mark">@appTitle</span>
                <span class="site-brand__meta">Tech Blog / .NET Lab</span>
            </a>

            <button class="navbar-toggler site-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="切换导航">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavigation">
                <ul class="navbar-nav me-auto align-items-xl-center">
                    <li class="nav-item">
                        <a class="@(NavClass("/"))" href="/">首页</a>
                    </li>
                    @await Component.InvokeAsync("Navigation", new { isActive = blogActive })
                    <li class="nav-item">
                        <a class="@(NavClass("/project"))" href="@ConstantUtil.GetProjectDirectoryUrl()">项目</a>
                    </li>
                    <li class="nav-item">
                        <a class="@(NavClass("/tool", "/timestamp", "/icon", "/nuoche", "/fuli", "/slugify-string"))" href="/tool">工具</a>
                    </li>
                    <li class="nav-item dropdown">
                        <button class="nav-link dropdown-toggle site-menu-toggle @(moreActive ? "is-active" : string.Empty)" type="button" data-bs-toggle="dropdown" aria-expanded="false">更多</button>
                        <div class="dropdown-menu site-dropdown">
                            <a class="dropdown-item" href="/about">关于</a>
                            <a class="dropdown-item" href="/timeline">时间线</a>
                            <a class="dropdown-item" href="/donation">赞助</a>
                            <a class="dropdown-item" href="/rss" target="_blank" rel="noreferrer">RSS</a>
                            <a class="dropdown-item" href="/sitemap" target="_blank" rel="noreferrer">站点地图</a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href="https://www.cnblogs.com/Dotnet9-com" target="_blank" rel="noreferrer">博客园</a>
                            <a class="dropdown-item" href="https://space.bilibili.com/470546606" target="_blank" rel="noreferrer">B 站</a>
                        </div>
                    </li>
                </ul>

                <div class="site-utility-bar">
                    <form class="site-search-form search-suggest" method="get" action="@ConstantUtil.GetSearchUrl()" role="search" data-search-suggestions-url="@($"{ConstantUtil.GetSearchUrl()}?handler=Suggest")">
                        <label class="visually-hidden" for="global-search-query">全站搜索</label>
                        <span class="site-search-form__icon" aria-hidden="true">
                            <i class="fas fa-magnifying-glass"></i>
                        </span>
                        <input
                            id="global-search-query"
                            class="site-search-input"
                            type="search"
                            name="q"
                            value="@searchQuery"
                            placeholder="搜索项目、工具、文章"
                            autocomplete="off"
                            aria-autocomplete="list"
                            aria-controls="global-search-suggestions"
                            data-search-suggest-input />
                        <button type="submit" class="site-search-submit">搜索</button>
                        <div id="global-search-suggestions" class="search-suggest-panel" data-search-suggest-panel hidden></div>
                    </form>
                </div>
            </div>
        </div>
    </nav>
</header>
