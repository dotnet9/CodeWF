@using Microsoft.Extensions.Options
@using WebApp.Extensions
@using WebApp.Services
@inject IOptions<WebApp.Options.SiteOption> SiteOptions
@inject WebApp.Services.I18nService I18n
@{
    var site = SiteOptions.Value;
    var appTitle = I18n.T("site.name", site.AppTitle ?? "码坊");
    var searchQuery = Context.Request.Query["q"].ToString();
    var currentPath = (Context.Request.Path.Value ?? "/").TrimEnd('/');
    if (string.IsNullOrEmpty(currentPath))
    {
        currentPath = "/";
    }

    // 文章详情页是 /yyyy/MM/slug 形式，单靠前缀判断无法让“博客”导航高亮。
    var articleDetailActive = System.Text.RegularExpressions.Regex.IsMatch(
        currentPath,
        @"^/\d{4}/\d{1,2}/[^/]+$",
        System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    string NavClass(params string[] hrefs)
    {
        if (hrefs.Length == 1 && hrefs[0] == "/")
        {
            return currentPath == "/" ? "nav-link is-active" : "nav-link";
        }

        return hrefs.Any(href => currentPath.StartsWith(href, StringComparison.OrdinalIgnoreCase))
            ? "nav-link is-active"
            : "nav-link";
    }

    var blogActive = currentPath.StartsWith("/post", StringComparison.OrdinalIgnoreCase)
        || currentPath.StartsWith("/cat", StringComparison.OrdinalIgnoreCase)
        || currentPath.StartsWith("/album", StringComparison.OrdinalIgnoreCase)
        || currentPath.StartsWith("/tag", StringComparison.OrdinalIgnoreCase)
        || articleDetailActive;

    var moreActive = currentPath.StartsWith("/about", StringComparison.OrdinalIgnoreCase)
        || currentPath.StartsWith("/privacy", StringComparison.OrdinalIgnoreCase)
        || currentPath.StartsWith("/timeline", StringComparison.OrdinalIgnoreCase)
        || currentPath.StartsWith("/donation", StringComparison.OrdinalIgnoreCase)
        || currentPath.StartsWith("/rss", StringComparison.OrdinalIgnoreCase)
        || currentPath.StartsWith("/sitemap", StringComparison.OrdinalIgnoreCase);
}

<header class="site-header">
    <nav class="navbar navbar-expand-lg fixed-top site-navbar">
        <div class="container">
            <a class="navbar-brand site-brand" href="/">
                <span class="site-brand__mark">@appTitle</span>
                <span class="site-brand__meta">@I18n.T("site.brandMeta", "Tech Blog / .NET Lab")</span>
            </a>

            <button class="navbar-toggler site-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="@I18n.T("nav.toggle", "切换导航")">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavigation">
                <ul class="navbar-nav me-auto align-items-xl-center">
                    <li class="nav-item">
                        <a class="@(NavClass("/"))" href="/">@I18n.T("nav.home", "首页")</a>
                    </li>
                    @await Component.InvokeAsync("Navigation", new { isActive = blogActive })
                    <li class="nav-item">
                        <a class="@(NavClass("/project"))" href="@ConstantUtil.GetProjectDirectoryUrl()">@I18n.T("nav.projects", "项目")</a>
                    </li>
                    <li class="nav-item">
                        <a class="@(NavClass("/tool", "/timestamp", "/icon", "/nuoche", "/fuli", "/slugify-string"))" href="/tool">@I18n.T("nav.tools", "工具")</a>
                    </li>
                    <li class="nav-item dropdown">
                        <button class="nav-link dropdown-toggle site-menu-toggle @(moreActive ? "is-active" : string.Empty)" type="button" data-bs-toggle="dropdown" aria-expanded="false">@I18n.T("nav.more", "更多")</button>
                        <div class="dropdown-menu site-dropdown">
                            <a class="dropdown-item" href="/about">@I18n.T("nav.about", "关于")</a>
                            <a class="dropdown-item" href="/timeline">@I18n.T("nav.timeline", "时间线")</a>
                            <a class="dropdown-item" href="/donation">@I18n.T("nav.donation", "赞助")</a>
                            <a class="dropdown-item" href="/rss" target="_blank" rel="noreferrer">RSS</a>
                            <a class="dropdown-item" href="/sitemap" target="_blank" rel="noreferrer">@I18n.T("nav.sitemap", "站点地图")</a>
                            <div class="dropdown-divider"></div>
                            <a class="dropdown-item" href="https://www.cnblogs.com/Dotnet9-com" target="_blank" rel="noreferrer">博客园</a>
                            <a class="dropdown-item" href="https://space.bilibili.com/470546606" target="_blank" rel="noreferrer">B 站</a>
                        </div>
                    </li>
                    <li class="nav-item dropdown site-language-menu">
                        <button class="nav-link dropdown-toggle site-menu-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@I18n.T("language.switch", "切换语言")">
                            <i class="fa-solid fa-globe" aria-hidden="true"></i>
                            <span>@I18n.CurrentLanguageInfo.NativeName</span>
                        </button>
                        <div class="dropdown-menu site-dropdown site-language-dropdown">
                            @foreach (var language in I18n.Languages)
                            {
                                var active = string.Equals(language.Code, I18n.CurrentLanguage, StringComparison.OrdinalIgnoreCase);
                                <a class="dropdown-item @(active ? "active" : string.Empty)" href="@I18n.SwitchUrl(language.Code)" lang="@language.HtmlLang" aria-current="@(active ? "true" : null)">
                                    <span>@language.NativeName</span>
                                    <small>@language.EnglishName</small>
                                </a>
                            }
                        </div>
                    </li>
                </ul>

                <div class="site-utility-bar">
                    @* 搜索建议通过 handler 异步获取，表单本身仍然保留正常 GET 行为，兼顾无脚本场景。 *@
                    <form class="site-search-form search-suggest" method="get" action="@ConstantUtil.GetSearchUrl()" role="search" data-search-suggestions-url="@($"{ConstantUtil.GetSearchUrl()}?handler=Suggest")">
                        <label class="visually-hidden" for="global-search-query">@I18n.T("search.global", "全站搜索")</label>
                        <span class="site-search-form__icon" aria-hidden="true">
                            <i class="fas fa-magnifying-glass"></i>
                        </span>
                        <input
                            id="global-search-query"
                            class="site-search-input"
                            type="search"
                            name="q"
                            value="@searchQuery"
                            placeholder="@I18n.T("search.placeholder", "搜索项目、工具、文章")"
                            autocomplete="off"
                            aria-autocomplete="list"
                            aria-controls="global-search-suggestions"
                            data-search-suggest-input />
                        <button type="submit" class="site-search-submit">@I18n.T("search.submit", "搜索")</button>
                        <div id="global-search-suggestions" class="search-suggest-panel" data-search-suggest-panel hidden></div>
                    </form>
                </div>
            </div>
        </div>
    </nav>
</header>
