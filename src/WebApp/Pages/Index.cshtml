@page "/"
@using Microsoft.Extensions.Options
@inject IOptions<WebApp.Options.SiteOption> SiteOptions
@model IndexModel
@{
    ViewData["Title"] = "首页";
    ViewData["Description"] = "码坊聚合 .NET 文章、文档与在线工具。";
    ViewData["BodyClass"] = "home-page";
    var siteOwner = SiteOptions.Value.Owner ?? SiteOptions.Value.AppTitle ?? "码坊";

    var heroPosts = Model.LatestPosts.Take(2).ToList();
    if (!heroPosts.Any())
    {
        heroPosts = Model.Posts.Take(2).ToList();
    }

    var heroPostSlugs = heroPosts
        .Where(post => !string.IsNullOrWhiteSpace(post.Slug))
        .Select(post => post.Slug!)
        .ToHashSet(StringComparer.OrdinalIgnoreCase);

    var latestPosts = Model.LatestPosts
        .Where(post => string.IsNullOrWhiteSpace(post.Slug) || !heroPostSlugs.Contains(post.Slug))
        .Take(3)
        .ToList();
    if (!latestPosts.Any())
    {
        latestPosts = Model.Posts
            .Where(post => string.IsNullOrWhiteSpace(post.Slug) || !heroPostSlugs.Contains(post.Slug))
            .Take(3)
            .ToList();
    }

    var albums = Model.FeaturedAlbums.ToList();
    var categories = Model.FeaturedCategories.ToList();
}

@section Head {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<section class="hero-band hero-band--home">
    <div class="container">
        <div class="home-hero">
            <div class="home-hero__content">
                <span class="eyebrow">Tech Blog / Engineering Notes</span>
                <h1>用工程视角记录 .NET 与现代开发</h1>
                <p class="hero-copy">
                    深入框架、源码实践、工具链与真实项目经验，沉淀可复用的技术判断。
                </p>

                <div class="hero-actions">
                    <a href="/bbs" class="btn btn-primary btn-lg">
                        <i class="fas fa-book-open me-2"></i>浏览文章
                    </a>
                    <a href="/doc" class="btn btn-ghost btn-lg">
                        <i class="fas fa-compass me-2"></i>进入文档
                    </a>
                    <a href="/search?q=dotnet" class="btn btn-outline-light btn-lg">
                        <i class="fas fa-magnifying-glass me-2"></i>全站搜索
                    </a>
                </div>

                <div class="hero-trustline">
                    <span>@Model.TotalPosts 篇文章</span>
                    <span>@Model.TotalDocNodes 个文档节点</span>
                    <span>@Model.TotalToolEntries 个工具入口</span>
                </div>
            </div>

            <aside class="surface-panel hero-terminal hero-terminal--focus">
                <div class="hero-terminal__header">
                    <span>Featured</span>
                    <strong>推荐文章</strong>
                </div>

                @if (heroPosts.Any())
                {
                    <div class="spotlight-list">
                        @foreach (var post in heroPosts)
                        {
                            var spotlightUrl = $"/Bbs/Post/{post.Date?.Year}/{post.Date?.Month}/{post.Slug}";
                            var spotlightAuthor = string.IsNullOrWhiteSpace(post.Author) ? siteOwner : post.Author;
                            <a href="@spotlightUrl" class="spotlight-story spotlight-story--hero">
                                <h2 title="@post.Title">@post.Title</h2>
                                @if (!string.IsNullOrWhiteSpace(post.Description))
                                {
                                    <p title="@post.Description">@post.Description</p>
                                }
                                <div class="spotlight-story__meta">
                                    <span><i class="far fa-calendar"></i>@post.Date?.ToString("yyyy-MM-dd")</span>
                                    <span><i class="far fa-user"></i>@spotlightAuthor</span>
                                </div>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state empty-state--compact">
                        <p>暂无推荐内容。</p>
                    </div>
                }
            </aside>
        </div>
    </div>
</section>

<section class="page-shell page-shell--home-grid">
    <div class="container">
        <div class="home-layout-grid">
            <div class="surface-panel home-curation">
                <div class="home-index-grid">
                    <article class="home-index-card">
                        <div class="home-index-card__header">
                            <h2 class="surface-title home-index-card__title">专题</h2>
                            <a href="/bbs/album" class="surface-link">查看更多</a>
                        </div>

                        @if (!albums.Any())
                        {
                            <div class="empty-state empty-state--compact">
                                <p>暂未配置专题内容。</p>
                            </div>
                        }
                        else
                        {
                            <div class="topic-list">
                                @foreach (var album in albums)
                                {
                                    <a href="/bbs/album/@album.Slug" class="topic-list__item">
                                        <div class="topic-list__content">
                                            <strong>@album.Name</strong>
                                            @if (!string.IsNullOrWhiteSpace(album.Memo))
                                            {
                                                <p>@album.Memo</p>
                                            }
                                        </div>
                                        <span class="topic-list__count">@album.PostCount</span>
                                    </a>
                                }
                            </div>
                        }
                    </article>

                    <article class="home-index-card">
                        <div class="home-index-card__header">
                            <h2 class="surface-title home-index-card__title">分类</h2>
                            <a href="/Bbs/Category" class="surface-link">查看更多</a>
                        </div>

                        @if (!categories.Any())
                        {
                            <div class="empty-state empty-state--compact">
                                <p>暂未配置文章分类。</p>
                            </div>
                        }
                        else
                        {
                            <div class="topic-list">
                                @foreach (var category in categories)
                                {
                                    <a href="/Bbs/Category/@category.Slug" class="topic-list__item">
                                        <div class="topic-list__content">
                                            <strong>@category.Name</strong>
                                            @if (!string.IsNullOrWhiteSpace(category.Memo))
                                            {
                                                <p>@category.Memo</p>
                                            }
                                        </div>
                                        <span class="topic-list__count">@category.PostCount</span>
                                    </a>
                                }
                            </div>
                        }
                    </article>
                </div>
            </div>

            <aside class="home-rail">
                <div class="surface-panel dispatch-panel">
                    <div class="dispatch-panel__header">
                        <h2 class="surface-title dispatch-panel__title">最新文章</h2>
                        <a href="/bbs" class="surface-link">更多</a>
                    </div>

                    @if (!latestPosts.Any())
                    {
                        <div class="empty-state empty-state--compact">
                            <p>近期更新会在这里展示。</p>
                        </div>
                    }
                    else
                    {
                        <div class="dispatch-list">
                            @foreach (var post in latestPosts)
                            {
                                var postUrl = $"/Bbs/Post/{post.Date?.Year}/{post.Date?.Month}/{post.Slug}";
                                <a href="@postUrl" class="dispatch-item">
                                    <span class="dispatch-item__meta">@post.Date?.ToString("yyyy-MM-dd")</span>
                                    <strong>@post.Title</strong>
                                    @if (!string.IsNullOrWhiteSpace(post.Description))
                                    {
                                        <p>@post.Description</p>
                                    }
                                </a>
                            }
                        </div>
                    }
                </div>
            </aside>
        </div>
    </div>
</section>

<section class="page-shell page-shell--tight page-shell--featured">
    <div class="container">
        @if (!Model.Posts.Any())
        {
            <div class="empty-state">
                <h2>内容还在整理中</h2>
                <p>可以先浏览博客或文档。</p>
            </div>
        }
        else
        {
            <div class="post-grid feature-grid">
                @foreach (var post in Model.Posts)
                {
                    var postUrl = $"/Bbs/Post/{post.Date?.Year}/{post.Date?.Month}/{post.Slug}";
                    var postAuthor = string.IsNullOrWhiteSpace(post.Author) ? siteOwner : post.Author;
                    <article class="resource-card">
                        <a href="@postUrl" class="resource-card__media">
                            @if (!string.IsNullOrWhiteSpace(post.Cover))
                            {
                                <img src="@post.Cover" alt="@post.Title" class="cover-media" loading="lazy" decoding="async" />
                            }
                            else
                            {
                                <div class="media-placeholder">
                                    <i class="fas fa-file-lines"></i>
                                </div>
                            }
                        </a>
                        <div class="resource-card__body">
                            <h3 class="resource-card__title">
                                <a href="@postUrl" title="@post.Title" aria-label="@post.Title">@post.Title</a>
                            </h3>
                            @if (!string.IsNullOrWhiteSpace(post.Description))
                            {
                                <p class="resource-card__desc" title="@post.Description">@post.Description</p>
                            }
                            <div class="resource-card__meta">
                                <span><i class="far fa-calendar"></i>@post.Date?.ToString("yyyy-MM-dd")</span>
                                <span><i class="far fa-user"></i>@postAuthor</span>
                            </div>
                            <a href="@postUrl" class="inline-link">
                                阅读全文
                                <i class="fas fa-arrow-right"></i>
                            </a>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>
