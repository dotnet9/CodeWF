@page "/"
@model IndexModel
@{
    ViewData["Title"] = "首页";
    ViewData["Description"] = "码坊聚合 .NET 技术文章、专题文档与在线工具，帮助开发者更高效地获取和实践知识。";
    ViewData["BodyClass"] = "home-page";
    var spotlight = Model.SpotlightPost;
    var latestPosts = Model.LatestPosts.Skip(1).Take(3).ToList();
    if (!latestPosts.Any())
    {
        latestPosts = Model.Posts
            .Where(post => spotlight == null || !string.Equals(post.Slug, spotlight.Slug, StringComparison.OrdinalIgnoreCase))
            .Take(3)
            .ToList();
    }

    var albums = Model.Albums
        .Where(item => !string.Equals(item.Slug, "default", StringComparison.OrdinalIgnoreCase))
        .Take(14)
        .ToList();
    var categories = Model.Categories
        .Where(item => !string.Equals(item.Slug, "default", StringComparison.OrdinalIgnoreCase))
        .Take(18)
        .ToList();
}

@section Head {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<section class="hero-band hero-band--home">
    <div class="container">
        <div class="home-hero">
            <div class="home-hero__content">
                <span class="eyebrow eyebrow--tech">TECH BLOG · .NET · ENGINEERING</span>
                <p class="hero-intro">技术内容系统化，阅读路径更清晰</p>
                <h1>持续更新的 .NET 技术博客</h1>
                <p class="hero-copy">把文章、文档和工具放进同一个入口，方便你更快找到能直接上手的内容。</p>

                <div class="hero-actions">
                    <a href="/bbs" class="btn btn-primary btn-lg">
                        <i class="fas fa-book-open me-2"></i>浏览文章
                    </a>
                    <a href="/doc" class="btn btn-ghost btn-lg">
                        <i class="fas fa-compass me-2"></i>进入文档
                    </a>
                    <a href="/search?q=dotnet" class="btn btn-outline-light btn-lg">
                        <i class="fas fa-magnifying-glass me-2"></i>全站搜索
                    </a>
                </div>

                <div class="metric-grid">
                    <div class="metric-card">
                        <strong>@Model.TotalPosts</strong>
                        <span>累计文章</span>
                    </div>
                    <div class="metric-card">
                        <strong>@Model.TotalAlbums</strong>
                        <span>专题沉淀</span>
                    </div>
                    <div class="metric-card">
                        <strong>@Model.TotalCategories</strong>
                        <span>技术分类</span>
                    </div>
                </div>

                <div class="quick-path-grid">
                    <a href="/bbs" class="quick-path-card">
                        <span class="quick-path-card__label">博客主线</span>
                        <strong>@Model.TotalPosts 篇内容</strong>
                        <p>先看最新更新。</p>
                    </a>
                    <a href="/doc" class="quick-path-card">
                        <span class="quick-path-card__label">文档体系</span>
                        <strong>@Model.TotalDocNodes 个节点</strong>
                        <p>按主题直接查找。</p>
                    </a>
                    <a href="/tool" class="quick-path-card">
                        <span class="quick-path-card__label">工具箱</span>
                        <strong>@Model.TotalToolEntries 个入口</strong>
                        <p>打开就能用。</p>
                    </a>
                </div>
            </div>

            <aside class="surface-panel hero-terminal">
                <div class="terminal-head">
                    <span></span>
                    <span></span>
                    <span></span>
                    <p>content-index@codewf</p>
                </div>

                <div class="terminal-screen">
                    <div class="terminal-line terminal-line--command">
                        <span class="terminal-prompt">$</span>
                        <span>site status</span>
                    </div>
                    <div class="terminal-line">
                        <span>posts</span>
                        <strong>@Model.TotalPosts</strong>
                    </div>
                    <div class="terminal-line">
                        <span>albums</span>
                        <strong>@Model.TotalAlbums</strong>
                    </div>
                    <div class="terminal-line">
                        <span>categories</span>
                        <strong>@Model.TotalCategories</strong>
                    </div>
                    <div class="terminal-line">
                        <span>docs</span>
                        <strong>@Model.TotalDocNodes</strong>
                    </div>
                    <div class="terminal-line">
                        <span>tools</span>
                        <strong>@Model.TotalToolEntries</strong>
                    </div>
                </div>

                @if (spotlight != null)
                {
                    var spotlightUrl = $"/Bbs/Post/{spotlight.Date?.Year}/{spotlight.Date?.Month}/{spotlight.Slug}";
                    <a href="@spotlightUrl" class="spotlight-story">
                        <span class="spotlight-story__label">Featured Story</span>
                        <h2>@spotlight.Title</h2>
                        @if (!string.IsNullOrWhiteSpace(spotlight.Description))
                        {
                            <p>@spotlight.Description</p>
                        }
                        <div class="spotlight-story__meta">
                            <span><i class="far fa-calendar"></i>@spotlight.Date?.ToString("yyyy-MM-dd")</span>
                            @if (!string.IsNullOrWhiteSpace(spotlight.Author))
                            {
                                <span><i class="far fa-user"></i>@spotlight.Author</span>
                            }
                        </div>
                    </a>
                }

                <div class="signal-card-grid">
                    <a href="/bbs" class="signal-card">
                        <strong>按更新阅读</strong>
                        <p>从最新文章进入。</p>
                    </a>
                    <a href="/doc" class="signal-card">
                        <strong>按主题查找</strong>
                        <p>从文档目录切入。</p>
                    </a>
                    <a href="/tool" class="signal-card">
                        <strong>边看边实操</strong>
                        <p>常用工具直接打开。</p>
                    </a>
                </div>
            </aside>
        </div>
    </div>
</section>

<section class="page-shell page-shell--home-grid">
    <div class="container">
        <div class="home-layout-grid">
            <div class="surface-panel home-curation">
                <div class="section-heading section-heading--compact">
                    <div>
                        <span class="eyebrow">Content Map</span>
                        <h2 class="section-title">从专题和分类切入内容</h2>
                    </div>
                    <p class="section-description">
                        先找到入口，再决定继续深入文章、文档还是工具。
                    </p>
                </div>

                <div class="home-index-grid">
                    <article class="home-index-card">
                        <div class="home-index-card__header">
                            <div>
                                <span class="eyebrow">Albums</span>
                                <h3 class="surface-title">专题专栏</h3>
                            </div>
                            <a href="/bbs" class="surface-link">全部文章</a>
                        </div>

                        @if (!albums.Any())
                        {
                            <div class="empty-state empty-state--compact">
                                <p>暂未配置专题内容。</p>
                            </div>
                        }
                        else
                        {
                            <div class="chip-cloud">
                                @foreach (var album in albums)
                                {
                                    <a href="/bbs/album/@album.Slug" class="chip-link">@album.Name</a>
                                }
                            </div>
                        }
                    </article>

                    <article class="home-index-card">
                        <div class="home-index-card__header">
                            <div>
                                <span class="eyebrow">Categories</span>
                                <h3 class="surface-title">技术分类</h3>
                            </div>
                            <a href="/bbs" class="surface-link">查看最新</a>
                        </div>

                        @if (!categories.Any())
                        {
                            <div class="empty-state empty-state--compact">
                                <p>暂未配置文章分类。</p>
                            </div>
                        }
                        else
                        {
                            <div class="chip-cloud">
                                @foreach (var category in categories)
                                {
                                    <a href="/Bbs/Category/@category.Slug" class="chip-link">@category.Name</a>
                                }
                            </div>
                        }
                    </article>
                </div>
            </div>

            <aside class="home-rail">
                <div class="surface-panel dispatch-panel">
                    <div class="dispatch-panel__header">
                        <div>
                            <span class="panel-kicker">Latest Dispatches</span>
                            <h2 class="surface-title">近期更新</h2>
                        </div>
                        <a href="/bbs" class="surface-link">进入博客</a>
                    </div>

                    @if (!latestPosts.Any())
                    {
                        <div class="empty-state empty-state--compact">
                            <p>近期更新会在这里展示。</p>
                        </div>
                    }
                    else
                    {
                        <div class="dispatch-list">
                            @foreach (var post in latestPosts)
                            {
                                var postUrl = $"/Bbs/Post/{post.Date?.Year}/{post.Date?.Month}/{post.Slug}";
                                <a href="@postUrl" class="dispatch-item">
                                    <span class="dispatch-item__meta">@post.Date?.ToString("yyyy-MM-dd")</span>
                                    <strong>@post.Title</strong>
                                    @if (!string.IsNullOrWhiteSpace(post.Description))
                                    {
                                        <p>@post.Description</p>
                                    }
                                </a>
                            }
                        </div>
                    }
                </div>
            </aside>
        </div>
    </div>
</section>

<section class="page-shell page-shell--tight">
    <div class="container">
        <div class="section-heading">
            <div>
                <span class="eyebrow">Featured Posts</span>
                <h2 class="section-title">精选文章</h2>
            </div>
            <p class="section-description">
                从这些文章开始，可以快速感受站点的主要内容方向。
            </p>
        </div>

        @if (!Model.Posts.Any())
        {
            <div class="empty-state">
                <h2>推荐内容还在整理中</h2>
                <p>可以先从博客列表或文档中心开始浏览。</p>
            </div>
        }
        else
        {
            <div class="post-grid feature-grid">
                @foreach (var post in Model.Posts)
                {
                    var postUrl = $"/Bbs/Post/{post.Date?.Year}/{post.Date?.Month}/{post.Slug}";
                    <article class="resource-card">
                        <a href="@postUrl" class="resource-card__media">
                            @if (!string.IsNullOrWhiteSpace(post.Cover))
                            {
                                <img src="@post.Cover" alt="@post.Title" class="cover-media" loading="lazy" decoding="async" />
                            }
                            else
                            {
                                <div class="media-placeholder">
                                    <i class="fas fa-file-lines"></i>
                                </div>
                            }
                        </a>
                        <div class="resource-card__body">
                            <h3 class="resource-card__title">
                                <a href="@postUrl">@post.Title</a>
                            </h3>
                            @if (!string.IsNullOrWhiteSpace(post.Description))
                            {
                                <p class="resource-card__desc">@post.Description</p>
                            }
                            <div class="resource-card__meta">
                                <span><i class="far fa-calendar"></i>@post.Date?.ToString("yyyy-MM-dd")</span>
                                @if (!string.IsNullOrWhiteSpace(post.Author))
                                {
                                    <span><i class="far fa-user"></i>@post.Author</span>
                                }
                            </div>
                            <a href="@postUrl" class="inline-link">
                                阅读全文
                                <i class="fas fa-arrow-right"></i>
                            </a>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>
