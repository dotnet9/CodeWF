@page "/"
@using Microsoft.Extensions.Options
@using WebApp.Extensions
@inject IOptions<WebApp.Options.SiteOption> SiteOptions
@model IndexModel
@{
    ViewData["Title"] = I18n.T("nav.home", "首页");
    ViewData["Description"] = I18n.T("site.description", "码坊聚合 .NET 文章、项目与在线工具。");
    ViewData["BodyClass"] = "home-page";
    var siteOwner = SiteOptions.Value.Owner ?? SiteOptions.Value.AppTitle ?? I18n.T("site.name", "码坊");

    var heroPosts = Model.HeroPosts.Take(2).ToList();
    if (!heroPosts.Any())
    {
        heroPosts = Model.Posts.Take(2).ToList();
    }

    var heroPostSlugs = heroPosts
        .Where(post => !string.IsNullOrWhiteSpace(post.Slug))
        .Select(post => post.Slug!)
        .ToHashSet(StringComparer.OrdinalIgnoreCase);

    var latestPosts = Model.LatestPosts
        .Where(post => string.IsNullOrWhiteSpace(post.Slug) || !heroPostSlugs.Contains(post.Slug))
        .Take(3)
        .ToList();
    if (!latestPosts.Any())
    {
        latestPosts = Model.Posts
            .Where(post => string.IsNullOrWhiteSpace(post.Slug) || !heroPostSlugs.Contains(post.Slug))
            .Take(3)
            .ToList();
    }

    var albums = Model.FeaturedAlbums.ToList();
    var categories = Model.FeaturedCategories.ToList();
}

@section Head {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<section class="hero-band hero-band--home">
    <div class="container">
        <div class="home-hero">
            <div class="home-hero__content">
                <span class="eyebrow">@I18n.T("home.eyebrow", "技术博客 / 工程笔记")</span>
                <h1>@I18n.T("home.heroTitle", "用工程视角记录 .NET 与现代开发")</h1>
                <p class="hero-copy">
                    @I18n.T("home.heroDescription", "深入框架、源码实践、工具链与真实项目经验，沉淀可复用的技术判断。")
                </p>

                <div class="hero-actions">
                    <a href="@ConstantUtil.GetBlogUrl()" class="btn btn-primary btn-lg">
                        <i class="fas fa-book-open me-2"></i>@I18n.T("home.browsePosts", "浏览文章")
                    </a>
                    <a href="@ConstantUtil.GetProjectDirectoryUrl()" class="btn btn-ghost btn-lg">
                        <i class="fas fa-compass me-2"></i>@I18n.T("home.openProjects", "进入项目")
                    </a>
                    <a href="@ConstantUtil.GetSearchUrl("dotnet")" class="btn btn-outline-light btn-lg">
                        <i class="fas fa-magnifying-glass me-2"></i>@I18n.T("search.global", "全站搜索")
                    </a>
                </div>

                <div class="hero-trustline">
                    <a href="@ConstantUtil.GetBlogUrl()" class="hero-trustline__item">@I18n.Format("home.totalPosts", "{0} 篇文章", Model.TotalPosts)</a>
                    <a href="@ConstantUtil.GetProjectDirectoryUrl()" class="hero-trustline__item">@I18n.Format("home.totalDocNodes", "{0} 个项目条目", Model.TotalDocNodes)</a>
                    <a href="/tool" class="hero-trustline__item">@I18n.Format("home.totalToolEntries", "{0} 个工具入口", Model.TotalToolEntries)</a>
                </div>
            </div>

            <aside class="surface-panel hero-terminal hero-terminal--focus">
                <div class="hero-terminal__header">
                    <span>@I18n.T("home.featuredEyebrow", "精选")</span>
                    <strong>@I18n.T("home.featuredPosts", "推荐文章")</strong>
                </div>

                @if (heroPosts.Any())
                {
                    <div class="spotlight-list">
                        @foreach (var post in heroPosts)
                        {
                            var spotlightUrl = ConstantUtil.GetPostUrl(post);
                            var spotlightAuthor = string.IsNullOrWhiteSpace(post.Author) ? siteOwner : post.Author;
                            var spotlightTitle = I18n.Text(post.Title);
                            var spotlightDescription = I18n.Text(post.Description);
                            <a href="@spotlightUrl" class="spotlight-story spotlight-story--hero">
                                <h2 title="@spotlightTitle">@spotlightTitle</h2>
                                @if (!string.IsNullOrWhiteSpace(spotlightDescription))
                                {
                                    <p title="@spotlightDescription">@spotlightDescription</p>
                                }
                                <div class="spotlight-story__meta">
                                    <span><i class="far fa-calendar"></i>@I18n.FormatDate(post.Lastmod ?? post.Date)</span>
                                    <span><i class="far fa-user"></i>@spotlightAuthor</span>
                                </div>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-state empty-state--compact">
                        <p>@I18n.T("home.emptyFeatured", "暂无推荐内容。")</p>
                    </div>
                }
            </aside>
        </div>
    </div>
</section>

<section class="page-shell page-shell--tight">
    <div class="container">
        <div class="discovery-grid discovery-grid--home">
            <section class="surface-panel discovery-panel">
                <div class="surface-panel__header">
                    <div>
                        <span class="eyebrow">@I18n.T("home.startEyebrow", "从这里开始")</span>
                        <h2 class="surface-title">@I18n.T("home.startTitle", "新用户起步路线")</h2>
                    </div>
                </div>
                <div class="discovery-link-list">
                    @foreach (var link in Model.GettingStartedLinks)
                    {
                        <a href="@link.Url" class="discovery-link-card">
                            <span class="card-kicker">@I18n.Text(link.Eyebrow)</span>
                            <strong>@I18n.Text(link.Title)</strong>
                            <p>@I18n.Text(link.Description)</p>
                            <span class="inline-link">@I18n.T("home.startNow", "现在开始") <i class="fas fa-arrow-right"></i></span>
                        </a>
                    }
                </div>
            </section>

            <section class="surface-panel discovery-panel">
                <div class="surface-panel__header">
                    <div>
                        <span class="eyebrow">@I18n.T("home.randomEyebrow", "随机探索")</span>
                        <h2 class="surface-title">@I18n.T("home.randomTitle", "随机发现")</h2>
                    </div>
                </div>

                @if (!Model.DiscoveryPosts.Any())
                {
                    <div class="empty-state empty-state--compact">
                        <p>@I18n.T("home.emptyRandom", "内容整理中，稍后会补上更多随机发现入口。")</p>
                    </div>
                }
                else
                {
                    <div class="discovery-post-list">
                        @foreach (var post in Model.DiscoveryPosts)
                        {
                            <article class="discovery-post-card">
                                <span class="card-kicker">@I18n.Text(post.Eyebrow)</span>
                                <h3><a href="@post.Url">@I18n.Text(post.Title)</a></h3>
                                <p>@I18n.Text(post.Description)</p>
                                <div class="resource-card__meta">
                                    <span><i class="far fa-calendar"></i>@I18n.Text(post.MetaLabel)</span>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        </div>
    </div>
</section>

<section class="page-shell page-shell--home-grid">
    <div class="container">
        <div class="home-layout-grid">
            <div class="surface-panel home-curation">
                <div class="home-index-grid">
                    <article class="home-index-card">
                        <div class="home-index-card__header">
                            <h2 class="surface-title home-index-card__title">@I18n.T("home.albums", "专题")</h2>
                            <a href="@ConstantUtil.GetAlbumDirectoryUrl()" class="surface-link">@I18n.T("home.viewMore", "查看更多")</a>
                        </div>

                        @if (!albums.Any())
                        {
                            <div class="empty-state empty-state--compact">
                                <p>@I18n.T("home.emptyAlbums", "暂未配置专题内容。")</p>
                            </div>
                        }
                        else
                        {
                            <div class="topic-list">
                                @foreach (var album in albums)
                                {
                                    <a href="@ConstantUtil.GetAlbumUrl(album.Slug)" class="topic-list__item">
                                        <div class="topic-list__content">
                                            <strong>@I18n.Text(album.Name)</strong>
                                            @if (!string.IsNullOrWhiteSpace(album.Memo))
                                            {
                                                <p>@I18n.Text(album.Memo)</p>
                                            }
                                        </div>
                                        <span class="topic-list__count">@album.PostCount</span>
                                    </a>
                                }
                            </div>
                        }
                    </article>

                    <article class="home-index-card">
                        <div class="home-index-card__header">
                            <h2 class="surface-title home-index-card__title">@I18n.T("home.categories", "分类")</h2>
                            <a href="@ConstantUtil.GetCategoryDirectoryUrl()" class="surface-link">@I18n.T("home.viewMore", "查看更多")</a>
                        </div>

                        @if (!categories.Any())
                        {
                            <div class="empty-state empty-state--compact">
                                <p>@I18n.T("home.emptyCategories", "暂未配置文章分类。")</p>
                            </div>
                        }
                        else
                        {
                            <div class="topic-list">
                                @foreach (var category in categories)
                                {
                                    <a href="@ConstantUtil.GetCategoryUrl(category.Slug)" class="topic-list__item">
                                        <div class="topic-list__content">
                                            <strong>@I18n.Text(category.Name)</strong>
                                            @if (!string.IsNullOrWhiteSpace(category.Memo))
                                            {
                                                <p>@I18n.Text(category.Memo)</p>
                                            }
                                        </div>
                                        <span class="topic-list__count">@category.PostCount</span>
                                    </a>
                                }
                            </div>
                        }
                    </article>
                </div>
            </div>

            <aside class="home-rail">
                <div class="surface-panel dispatch-panel">
                    <div class="dispatch-panel__header">
                        <h2 class="surface-title dispatch-panel__title">@I18n.T("home.latestPosts", "最新文章")</h2>
                        <a href="@ConstantUtil.GetBlogUrl()" class="surface-link">@I18n.T("nav.more", "更多")</a>
                    </div>

                    @if (!latestPosts.Any())
                    {
                        <div class="empty-state empty-state--compact">
                            <p>@I18n.T("home.emptyLatest", "近期更新会在这里展示。")</p>
                        </div>
                    }
                    else
                    {
                        <div class="dispatch-list">
                            @foreach (var post in latestPosts)
                            {
                                var postUrl = ConstantUtil.GetPostUrl(post);
                                <a href="@postUrl" class="dispatch-item">
                                    <span class="dispatch-item__meta">@I18n.FormatDate(post.Lastmod ?? post.Date)</span>
                                    <strong>@I18n.Text(post.Title)</strong>
                                    @if (!string.IsNullOrWhiteSpace(post.Description))
                                    {
                                        <p>@I18n.Text(post.Description)</p>
                                    }
                                </a>
                            }
                        </div>
                    }
                </div>
            </aside>
        </div>
    </div>
</section>

<section class="page-shell page-shell--tight page-shell--featured">
    <div class="container">
        @if (!Model.Posts.Any())
        {
            <div class="empty-state">
                <h2>@I18n.T("home.emptyTitle", "内容还在整理中")</h2>
                <p>@I18n.T("home.emptyDescription", "可以先浏览文章或项目。")</p>
            </div>
        }
        else
        {
            <div class="post-grid feature-grid">
                @foreach (var post in Model.Posts)
                {
                    var postUrl = ConstantUtil.GetPostUrl(post);
                    var postAuthor = string.IsNullOrWhiteSpace(post.Author) ? siteOwner : post.Author;
                    var postTitle = I18n.Text(post.Title);
                    var postDescription = I18n.Text(post.Description);
                    <article class="resource-card">
                        <a href="@postUrl" class="resource-card__media">
                            @if (!string.IsNullOrWhiteSpace(post.Cover))
                            {
                                <img src="@post.Cover" alt="@postTitle" class="cover-media" loading="lazy" decoding="async" />
                            }
                            else
                            {
                                <div class="media-placeholder">
                                    <i class="fas fa-file-lines"></i>
                                </div>
                            }
                        </a>
                        <div class="resource-card__body">
                            <h3 class="resource-card__title">
                                <a href="@postUrl" title="@postTitle" aria-label="@postTitle">@postTitle</a>
                            </h3>
                            @if (!string.IsNullOrWhiteSpace(postDescription))
                            {
                                <p class="resource-card__desc" title="@postDescription">@postDescription</p>
                            }
                            <div class="resource-card__meta">
                                <span><i class="far fa-calendar"></i>@I18n.FormatDate(post.Lastmod ?? post.Date)</span>
                                <span><i class="far fa-user"></i>@postAuthor</span>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>
