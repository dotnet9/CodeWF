@page "/"
@model IndexModel
@{
    ViewData["Title"] = "首页";
    ViewData["Description"] = "码坊聚合 .NET 技术文章、专题文档与在线工具，帮助开发者更高效地获取和实践知识。";
    var spotlight = Model.SpotlightPost;
}

<section class="hero-band">
    <div class="container">
        <div class="home-hero">
            <div class="home-hero__content">
                <span class="eyebrow">Razor Pages · Content Hub</span>
                <h1>把文章、文档和工具组织成更专业的开发者入口</h1>
                <p class="hero-copy">
                    码坊围绕 .NET 与泛开发主题沉淀内容，强化专题浏览、文档导航与在线工具三个核心入口，让阅读、检索与实践形成闭环。
                </p>

                <div class="hero-actions">
                    <a href="/bbs" class="btn btn-primary btn-lg">
                        <i class="fas fa-book-open me-2"></i>浏览文章
                    </a>
                    <a href="/doc" class="btn btn-ghost btn-lg">
                        <i class="fas fa-compass me-2"></i>进入文档
                    </a>
                </div>

                <div class="metric-grid">
                    <div class="metric-card">
                        <strong>@Model.TotalPosts</strong>
                        <span>累计文章</span>
                    </div>
                    <div class="metric-card">
                        <strong>@Model.TotalAlbums</strong>
                        <span>专题沉淀</span>
                    </div>
                    <div class="metric-card">
                        <strong>@Model.TotalCategories</strong>
                        <span>技术分类</span>
                    </div>
                </div>
            </div>

            <aside class="surface-panel hero-spotlight">
                <p class="panel-kicker">Spotlight</p>
                @if (spotlight != null)
                {
                    var spotlightUrl = $"/Bbs/Post/{spotlight.Date?.Year}/{spotlight.Date?.Month}/{spotlight.Slug}";
                    <div class="spotlight-card">
                        <span class="spotlight-card__label">推荐文章</span>
                        <h2>@spotlight.Title</h2>
                        @if (!string.IsNullOrWhiteSpace(spotlight.Description))
                        {
                            <p>@spotlight.Description</p>
                        }
                        <div class="spotlight-meta">
                            <span><i class="far fa-calendar"></i>@spotlight.Date?.ToString("yyyy-MM-dd")</span>
                            @if (!string.IsNullOrWhiteSpace(spotlight.Author))
                            {
                                <span><i class="far fa-user"></i>@spotlight.Author</span>
                            }
                        </div>
                        <a href="@spotlightUrl" class="spotlight-link">
                            阅读这篇文章
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                }

                <div class="pillar-list">
                    <div class="pillar-item">
                        <div class="pillar-item__icon">
                            <i class="fas fa-layer-group"></i>
                        </div>
                        <div>
                            <h3>专题沉淀</h3>
                            <p>用专辑组织系列内容，适合连续阅读与长期积累。</p>
                        </div>
                    </div>
                    <div class="pillar-item">
                        <div class="pillar-item__icon">
                            <i class="fas fa-book"></i>
                        </div>
                        <div>
                            <h3>文档导航</h3>
                            <p>把知识点整理成结构化目录，降低查找与复用成本。</p>
                        </div>
                    </div>
                    <div class="pillar-item">
                        <div class="pillar-item__icon">
                            <i class="fas fa-screwdriver-wrench"></i>
                        </div>
                        <div>
                            <h3>在线工具</h3>
                            <p>让常用开发小工具直接可用，而不是只停留在介绍层面。</p>
                        </div>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</section>

<section class="page-shell">
    <div class="container">
        <div class="section-heading">
            <div>
                <span class="eyebrow">Explore</span>
                <h2 class="section-title">从专题和分类切入内容</h2>
            </div>
            <p class="section-description">
                对初次访问者来说，先看入口比先看列表更重要。这里把高频的浏览方式整理成了更直观的入口层。
            </p>
        </div>

        <div class="row g-4">
            <div class="col-lg-6">
                <div class="surface-panel">
                    <div class="surface-panel__header">
                        <div>
                            <span class="eyebrow">Albums</span>
                            <h3 class="surface-title">专题专栏</h3>
                        </div>
                        <a href="/bbs" class="surface-link">全部文章</a>
                    </div>

                    @if (!Model.Albums.Any(item => !string.Equals(item.Slug, "default", StringComparison.OrdinalIgnoreCase)))
                    {
                        <div class="empty-state empty-state--compact">
                            <p>暂未配置专题内容。</p>
                        </div>
                    }
                    else
                    {
                        <div class="chip-cloud">
                            @foreach (var album in Model.Albums.Where(item => !string.Equals(item.Slug, "default", StringComparison.OrdinalIgnoreCase)).Take(18))
                            {
                                <a href="/bbs/album/@album.Slug" class="chip-link">@album.Name</a>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-6">
                <div class="surface-panel">
                    <div class="surface-panel__header">
                        <div>
                            <span class="eyebrow">Categories</span>
                            <h3 class="surface-title">技术分类</h3>
                        </div>
                        <a href="/bbs" class="surface-link">查看最新</a>
                    </div>

                    @if (!Model.Categories.Any(item => !string.Equals(item.Slug, "default", StringComparison.OrdinalIgnoreCase)))
                    {
                        <div class="empty-state empty-state--compact">
                            <p>暂未配置文章分类。</p>
                        </div>
                    }
                    else
                    {
                        <div class="chip-cloud">
                            @foreach (var category in Model.Categories.Where(item => !string.Equals(item.Slug, "default", StringComparison.OrdinalIgnoreCase)).Take(24))
                            {
                                <a href="/Bbs/Category/@category.Slug" class="chip-link">@category.Name</a>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<section class="page-shell page-shell--tight">
    <div class="container">
        <div class="section-heading">
            <div>
                <span class="eyebrow">Featured Posts</span>
                <h2 class="section-title">推荐阅读</h2>
            </div>
            <p class="section-description">
                精选近期值得打开的内容，优先展示站点里更适合首页承接的文章。
            </p>
        </div>

        @if (!Model.Posts.Any())
        {
            <div class="empty-state">
                <h2>推荐内容还在整理中</h2>
                <p>可以先从博客列表或文档中心开始浏览。</p>
            </div>
        }
        else
        {
            <div class="post-grid">
                @foreach (var post in Model.Posts)
                {
                    var postUrl = $"/Bbs/Post/{post.Date?.Year}/{post.Date?.Month}/{post.Slug}";
                    <article class="resource-card">
                        <a href="@postUrl" class="resource-card__media">
                            @if (!string.IsNullOrWhiteSpace(post.Cover))
                            {
                                <img src="@post.Cover" alt="@post.Title" class="cover-media" />
                            }
                            else
                            {
                                <div class="media-placeholder">
                                    <i class="fas fa-file-lines"></i>
                                </div>
                            }
                        </a>
                        <div class="resource-card__body">
                            <h3 class="resource-card__title">
                                <a href="@postUrl">@post.Title</a>
                            </h3>
                            @if (!string.IsNullOrWhiteSpace(post.Description))
                            {
                                <p class="resource-card__desc">@post.Description</p>
                            }
                            <div class="resource-card__meta">
                                <span><i class="far fa-calendar"></i>@post.Date?.ToString("yyyy-MM-dd")</span>
                                @if (!string.IsNullOrWhiteSpace(post.Author))
                                {
                                    <span><i class="far fa-user"></i>@post.Author</span>
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>
