@page "/project/{slug}"
@model WebApp.Pages.Doc.DetailModel
@using WebApp.Extensions
@{
    ViewData["Title"] = $"{I18n.Text(Model.Doc?.Name ?? I18n.T("nav.projects", "项目"))} - {I18n.T("project.center", "项目中心")}";
    ViewData["Description"] = I18n.Text(Model.Doc?.Memo ?? I18n.T("project.description", "浏览码坊的项目与使用说明。"));
    var banner = Model.Doc == null
        ? null
        : new WebApp.Models.PageBannerViewModel
        {
            Eyebrow = "Projects",
            Title = I18n.Text(Model.Doc.Name ?? I18n.T("nav.projects", "项目")),
            Description = Model.Doc.Memo,
            MetaItems = [I18n.T("project.docs", "项目说明")]
        };
}

@section Head {
    <partial name="_CodeHighlightHead" />
}

<section class="page-shell">
    <div class="container">
        @if (Model.Doc == null)
        {
            <div class="empty-state">
                <h2>@I18n.T("project.notFoundTitle", "项目不存在或已删除")</h2>
                <p>@I18n.T("project.notFoundDescription", "可以返回项目中心查看其他内容。")</p>
            </div>
        }
        else
        {
            <partial name="_PageBanner" model="banner" />
            @if (!string.IsNullOrWhiteSpace(Model.Doc.Repository))
            {
                <div class="page-banner__meta">
                    <a class="meta-chip" href="@Model.Doc.Repository" target="_blank" rel="noreferrer">
                        <i class="fab fa-github"></i>@I18n.T("project.repository", "相关仓库")
                    </a>
                </div>
            }

            <div class="article-layout">
                <div class="article-main">
                    <article class="surface-panel article-panel">
                        @if (!string.IsNullOrWhiteSpace(Model.Doc.HtmlContent))
                        {
                            <div class="prose doc-content" data-reading-body>
                                @Html.Raw(Model.Doc.HtmlContent)
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(Model.Doc.Content))
                        {
                            <div class="prose doc-content" data-reading-body>
                                @Html.Raw(Model.Doc.Content.ToHtml())
                            </div>
                        }
                    </article>

                    @if (Model.PreviousDoc != null || Model.NextDoc != null)
                    {
                        <nav class="doc-pager" aria-label="@I18n.T("project.readingNavigation", "项目阅读导航")">
                            @if (Model.PreviousDoc != null)
                            {
                                <a href="@ConstantUtil.GetProjectUrl(Model.PreviousDoc.Slug)" class="surface-panel doc-pager__item doc-pager__item--prev">
                                    <span class="doc-pager__label">
                                        <i class="fas fa-arrow-left"></i>
                                        @I18n.T("pagination.previousPost", "上一篇")
                                    </span>
                                    <strong>@I18n.Text(Model.PreviousDoc.Name)</strong>
                                    @if (!string.IsNullOrWhiteSpace(Model.PreviousDoc.Memo))
                                    {
                                        <p>@I18n.Text(Model.PreviousDoc.Memo)</p>
                                    }
                                </a>
                            }
                            else
                            {
                                <div class="surface-panel doc-pager__item doc-pager__item--empty" aria-hidden="true"></div>
                            }

                            @if (Model.NextDoc != null)
                            {
                                <a href="@ConstantUtil.GetProjectUrl(Model.NextDoc.Slug)" class="surface-panel doc-pager__item doc-pager__item--next">
                                    <span class="doc-pager__label">
                                        @I18n.T("pagination.nextPost", "下一篇")
                                        <i class="fas fa-arrow-right"></i>
                                    </span>
                                    <strong>@I18n.Text(Model.NextDoc.Name)</strong>
                                    @if (!string.IsNullOrWhiteSpace(Model.NextDoc.Memo))
                                    {
                                        <p>@I18n.Text(Model.NextDoc.Memo)</p>
                                    }
                                </a>
                            }
                            else
                            {
                                <div class="surface-panel doc-pager__item doc-pager__item--empty" aria-hidden="true"></div>
                            }
                        </nav>
                    }
                </div>

                <aside class="article-aside sticky-panel">
                    <div class="surface-panel toc-panel" data-reading-toc data-toc-hide-empty="true">
                        <h2 class="sidebar-title">@I18n.T("post.toc", "目录")</h2>
                        <div class="toc-nav"></div>
                    </div>
                </aside>
            </div>
        }
    </div>
</section>

@section Scripts {
    <partial name="_CodeHighlightScripts" />
}
