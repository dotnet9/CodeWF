@page "/doc/{slug}"
@model WebApp.Pages.Doc.DetailModel
@using WebApp.Extensions
@{
    ViewData["Title"] = $"{Model.Doc?.Name ?? "文档"} - 文档中心";
    ViewData["Description"] = Model.Doc?.Memo ?? "浏览码坊文档内容。";
}

<section class="page-shell">
    <div class="container">
        @if (Model.Doc == null)
        {
            <div class="empty-state">
                <h2>文档不存在或已删除</h2>
                <p>可以返回文档中心查看其他内容。</p>
            </div>
        }
        else
        {
            <div class="page-banner">
                <div>
                    <span class="eyebrow">Documentation</span>
                    <h1 class="page-title">@Model.Doc.Name</h1>
                    @if (!string.IsNullOrWhiteSpace(Model.Doc.Memo))
                    {
                        <p class="page-description">@Model.Doc.Memo</p>
                    }
                </div>
                <div class="page-banner__meta">
                    <span class="meta-chip">结构化文档</span>
                    @if (!string.IsNullOrWhiteSpace(Model.Doc.Repository))
                    {
                        <a class="meta-chip" href="@Model.Doc.Repository" target="_blank" rel="noreferrer">
                            <i class="fab fa-github"></i>相关仓库
                        </a>
                    }
                </div>
            </div>

            <div class="content-grid content-grid--article">
                <article class="surface-panel article-panel">
                    @if (!string.IsNullOrWhiteSpace(Model.Doc.HtmlContent))
                    {
                        <div class="prose doc-content">
                            @Html.Raw(Model.Doc.HtmlContent)
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(Model.Doc.Content))
                    {
                        <div class="prose doc-content">
                            @Html.Raw(Model.Doc.Content.ToHtml())
                        </div>
                    }
                </article>

                <aside class="content-sidebar">
                    <div class="surface-panel sidebar-panel sticky-panel">
                        <h2 class="sidebar-title">文档目录</h2>
                        <div class="sidebar-link-list">
                            @if (Model.DocItems != null && Model.DocItems.Any())
                            {
                                @foreach (var doc in Model.DocItems)
                                {
                                    <a href="/doc/@doc.Slug" class="sidebar-link @(doc.Slug == Model.Doc.Slug ? "is-current" : string.Empty)">
                                        <span>@doc.Name</span>
                                        <i class="fas fa-angle-right"></i>
                                    </a>
                                    @if (doc.Children != null && doc.Children.Any())
                                    {
                                        @foreach (var child in doc.Children)
                                        {
                                            <a href="/doc/@child.Slug" class="sidebar-link sidebar-link--child @(child.Slug == Model.Doc.Slug ? "is-current" : string.Empty)">
                                                <span>@child.Name</span>
                                                <i class="fas fa-angle-right"></i>
                                            </a>
                                        }
                                    }
                                }
                            }
                        </div>
                    </div>
                </aside>
            </div>
        }
    </div>
</section>
