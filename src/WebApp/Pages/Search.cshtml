@page "/s"
@using WebApp.Extensions
@model WebApp.Pages.SearchModel
@{
    var banner = new WebApp.Models.PageBannerViewModel
    {
        Eyebrow = I18n.T("search.eyebrow", "全局搜索"),
        Title = I18n.T("search.pageTitle", "搜索工具、项目与文章"),
        Description = I18n.T("search.pageDescription", "一个入口检索站内内容，优先返回最相关的工具、项目说明与技术文章。")
    };
    var startPage = Math.Max(1, Model.PageIndex - 2);
    var endPage = Math.Min(Model.TotalPages, Model.PageIndex + 2);
    if (endPage - startPage < 4)
    {
        if (startPage == 1)
        {
            endPage = Math.Min(Model.TotalPages, startPage + 4);
        }
        else if (endPage == Model.TotalPages)
        {
            startPage = Math.Max(1, endPage - 4);
        }
    }

    var previousPage = Math.Max(1, Model.PageIndex - 1);
    var nextPage = Model.TotalPages <= 0 ? 1 : Math.Min(Model.TotalPages, Model.PageIndex + 1);
}

<section class="page-shell">
    <div class="container">
        <div class="search-banner">
            <partial name="_PageBanner" model="banner" />
            <form class="search-page-form search-suggest" method="get" action="@ConstantUtil.GetSearchUrl()" role="search" data-search-suggestions-url="@($"{ConstantUtil.GetSearchUrl()}?handler=Suggest")">
                <label class="visually-hidden" for="search-page-query">@I18n.T("search.keywords", "搜索关键字")</label>
                <div class="search-page-form__shell">
                    <span class="search-page-form__icon" aria-hidden="true">
                        <i class="fas fa-magnifying-glass"></i>
                    </span>
                    <input
                        id="search-page-query"
                        class="search-page-input"
                        type="search"
                        name="q"
                        value="@Model.Query"
                        placeholder="@I18n.T("search.inputPlaceholder", "输入项目、工具或文章关键字")"
                        autocomplete="off"
                        aria-autocomplete="list"
                        aria-controls="search-page-suggestions"
                        data-search-suggest-input />
                    <button type="submit" class="btn btn-primary search-page-submit">@I18n.T("search.submit", "搜索")</button>
                </div>
                <div id="search-page-suggestions" class="search-suggest-panel" data-search-suggest-panel hidden></div>
            </form>
        </div>

        @if (string.IsNullOrWhiteSpace(Model.Query))
        {
            <div class="empty-state">
                <h2>@I18n.T("search.emptyTitle", "输入关键字开始搜索")</h2>
                <p>@I18n.T("search.emptyDescription", "可以直接搜索项目名、包名、工具名、文章标题或正文里的技术关键词。")</p>
                <div class="chip-row chip-row--secondary">
                    <span class="tag-chip tag-chip--muted">@I18n.T("search.kind.tool", "工具")</span>
                    <span class="tag-chip tag-chip--muted">@I18n.T("search.kind.doc", "项目")</span>
                    <span class="tag-chip tag-chip--muted">@I18n.T("search.kind.post", "文章")</span>
                </div>
            </div>
        }
        else
        {
            <div class="search-summary-row">
                <div class="page-banner__meta">
                    <span class="meta-chip">@I18n.Format("search.queryMeta", "关键字：{0}", Model.Query)</span>
                    <span class="meta-chip">@I18n.Format("search.totalResults", "共 {0} 条结果", Model.Total)</span>
                </div>
                <div class="page-banner__meta">
                    <span class="meta-chip">@I18n.Format("search.toolCount", "工具 {0}", Model.ToolCount)</span>
                    <span class="meta-chip">@I18n.Format("search.docCount", "项目 {0}", Model.DocCount)</span>
                    <span class="meta-chip">@I18n.Format("search.postCount", "文章 {0}", Model.PostCount)</span>
                </div>
            </div>

            @if (Model.IsBlocked)
            {
                <div class="empty-state">
                    <h2>@I18n.T("search.blockedTitle", "换一个技术关键词试试")</h2>
                    <p>@I18n.Text(Model.Notice)</p>
                </div>
            }
            else if (!Model.Results.Any())
            {
                <div class="empty-state">
                    <h2>@I18n.T("search.noResultsTitle", "没有找到相关结果")</h2>
                    <p>@I18n.T("search.noResultsDescription", "可以试试更短的关键词，或者直接搜索项目名、包名、工具名和文章标题中的核心词。")</p>
                </div>
            }
            else
            {
                <div class="search-result-list">
                    @foreach (var result in Model.Results)
                    {
                        var summary = string.Equals(result.Summary?.Trim(), result.Title?.Trim(), StringComparison.Ordinal)
                            ? null
                            : result.Summary;
                        var snippet = string.Equals(result.MatchedSnippet, result.Summary, StringComparison.Ordinal)
                            ? null
                            : result.MatchedSnippet;
                        var resultTitle = I18n.Text(result.Title);

                        <article class="surface-panel search-result-card">
                            <div class="search-result-card__head">
                                <span class="search-kind-badge search-kind-badge--@result.KindCssClass">@I18n.T(result.KindLabelKey, result.KindLabel)</span>
                                @if (result.UpdatedAt.HasValue)
                                {
                                    <span class="search-result-card__date">@I18n.FormatDate(result.UpdatedAt)</span>
                                }
                            </div>

                            <h2 class="search-result-card__title">
                                <a href="@result.Url">@resultTitle</a>
                            </h2>

                            @if (!string.IsNullOrWhiteSpace(summary))
                            {
                                <p class="search-result-card__summary">@I18n.Text(summary)</p>
                            }

                            @if (!string.IsNullOrWhiteSpace(snippet))
                            {
                                <p class="search-result-card__matched">@I18n.Format("search.matchedContent", "匹配内容：{0}", snippet)</p>
                            }

                            <div class="search-result-card__meta">
                                @if (!string.IsNullOrWhiteSpace(result.Context))
                                {
                                    <span><i class="fas fa-diagram-project"></i>@I18n.Text(result.Context)</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(result.Slug))
                                {
                                    <span><i class="fas fa-link"></i>@result.Slug</span>
                                }
                            </div>

                            <a href="@result.Url" class="inline-link">
                                @I18n.T("search.viewResult", "查看结果")
                                <i class="fas fa-arrow-right"></i>
                            </a>
                        </article>
                    }
                </div>

                @if (Model.TotalPages > 1)
                {
                    <nav class="pagination-shell" aria-label="@I18n.T("search.pagination", "搜索分页")">
                        <p class="pagination-summary">@I18n.Format("pagination.resultsSummary", "第 {0} / {1} 页，共 {2} 条结果", Model.PageIndex, Model.TotalPages, Model.Total)</p>
                        <ul class="pagination justify-content-center pagination-list">
                            <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : "")">
                                <a class="page-link" href="@ConstantUtil.GetSearchUrl(Model.Query, previousPage)">@I18n.T("pagination.previous", "上一页")</a>
                            </li>

                            @if (startPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@ConstantUtil.GetSearchUrl(Model.Query, 1)">1</a>
                                </li>
                                @if (startPage > 2)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                            }

                            @for (var i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(Model.PageIndex == i ? "active" : "")">
                                    <a class="page-link" href="@ConstantUtil.GetSearchUrl(Model.Query, i)">@i</a>
                                </li>
                            }

                            @if (endPage < Model.TotalPages)
                            {
                                @if (endPage < Model.TotalPages - 1)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                                <li class="page-item">
                                    <a class="page-link" href="@ConstantUtil.GetSearchUrl(Model.Query, Model.TotalPages)">@Model.TotalPages</a>
                                </li>
                            }

                            <li class="page-item @(Model.PageIndex >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@ConstantUtil.GetSearchUrl(Model.Query, nextPage)">@I18n.T("pagination.next", "下一页")</a>
                            </li>
                        </ul>
                    </nav>
                }
            }
        }
    </div>
</section>
