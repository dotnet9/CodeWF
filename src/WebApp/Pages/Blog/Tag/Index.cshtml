@page "/tag/{slug?}"
@using WebApp.Extensions
@model WebApp.Pages.Blog.Tag.IndexModel
@{
    var tagDisplayName = Model.IsTagMissing
        ? I18n.T("tag.notFoundTitle", "标签不存在")
        : I18n.Text(Model.TagName);
    ViewData["Title"] = Model.IsDirectoryPage
        ? I18n.T("nav.tags", "标签")
        : Model.IsTagMissing
            ? I18n.T("tag.notFoundTitle", "标签不存在")
            : I18n.Format("tag.titleWithName", "{0} - 标签", tagDisplayName);
    ViewData["Description"] = Model.IsDirectoryPage
        ? I18n.T("tag.directoryDescription", "浏览码坊全部文章标签。")
        : Model.IsTagMissing
            ? I18n.T("tag.notFoundDescription", "这个标签不存在或暂未收录文章。")
            : I18n.Format("tag.descriptionWithName", "查看 {0} 标签下的技术文章。", tagDisplayName);
    var tagSlug = Model.CurrentSlug ?? string.Empty;
    var maxTagCount = Math.Max(1, Model.Tags.Any() ? Model.Tags.Max(item => item.PostCount) : 1);
    var tagIndex = 0;
}

<section class="page-shell">
    <div class="container">
        <div class="page-banner">
            <div>
                <span class="eyebrow">@I18n.T("tag.eyebrow", "标签")</span>
                <h1 class="page-title">@(Model.IsDirectoryPage ? I18n.T("nav.allTags", "全部标签") : tagDisplayName)</h1>
                <p class="page-description">@(Model.IsDirectoryPage
                    ? I18n.T("tag.browseDescription", "按标签快速聚合站内文章。")
                    : Model.IsTagMissing
                        ? I18n.T("tag.notFoundPageDescription", "可以返回标签列表查看其他已收录标签。")
                        : I18n.Format("tag.browsingDescriptionWithName", "正在浏览与 {0} 相关的文章。", tagDisplayName))</p>
            </div>
            @if (!Model.IsDirectoryPage)
            {
                <div class="page-banner__stats">
                    <div class="stat-chip">
                        <strong>@Model.Total</strong>
                        <span>@I18n.T("blog.postCountUnit", "篇文章")</span>
                    </div>
                    <div class="stat-chip">
                        <strong>@Model.PageIndex</strong>
                        <span>@I18n.T("pagination.currentPage", "当前页")</span>
                    </div>
                </div>
            }
        </div>

        @if (Model.IsDirectoryPage)
        {
            <div class="surface-panel directory-panel">
                @if (!Model.Tags.Any())
                {
                    <div class="empty-state">
                        <h2>@I18n.T("tag.emptyDirectoryTitle", "暂未整理标签")</h2>
                        <p>@I18n.T("tag.emptyDirectoryDescription", "后续会在这里展示文章标签。")</p>
                    </div>
                }
                else
                {
                    <div class="tag-cloud" aria-label="@I18n.T("nav.allTags", "全部标签")">
                        @foreach (var tag in Model.Tags)
                        {
                            var weight = Math.Clamp(0.82 + tag.PostCount / (double)maxTagCount * 0.48, 0.82, 1.3);
                            var delay = (tagIndex++ % 12) * -0.18;
                            <a href="@Model.GetTagUrl(tag.Name)" class="tag-cloud__item" style="--tag-weight:@weight.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture); --tag-delay:@delay.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)s">
                                <span>@I18n.Text(tag.Name)</span><strong>(@tag.PostCount)</strong>
                            </a>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="content-grid">
                <div class="content-primary">
                    @if (!Model.Posts.Any())
                    {
                        <div class="empty-state">
                            <h2>@(Model.IsTagMissing ? I18n.T("tag.notFoundTitle", "标签不存在") : I18n.T("tag.emptyPostsTitle", "这个标签下还没有文章"))</h2>
                            <p>@(Model.IsTagMissing ? I18n.T("tag.notFoundEmptyDescription", "可以返回标签列表查看其他标签。") : I18n.T("tag.emptyPostsDescription", "可以返回标签列表或博客首页继续浏览。"))</p>
                        </div>
                    }
                    else
                    {
                        <div class="post-list">
                            @foreach (var post in Model.Posts)
                            {
                                var postUrl = ConstantUtil.GetPostUrl(post);
                                var hasCover = !string.IsNullOrWhiteSpace(post.Cover);
                                var postTitle = I18n.Text(post.Title);
                                var authorName = I18n.Text(string.IsNullOrWhiteSpace(post.Author) ? Model.Owner : post.Author);
                                <article class="post-list-card @(hasCover ? string.Empty : "post-list-card--text-only")">
                                    @if (hasCover)
                                    {
                                        <a href="@postUrl" class="post-list-card__cover">
                                            <img src="@post.Cover" alt="@postTitle" class="cover-media" loading="lazy" decoding="async" />
                                        </a>
                                    }
                                    <div class="post-list-card__body">
                                        <h2 class="post-list-card__title"><a href="@postUrl">@I18n.Text(post.Title)</a></h2>
                                        @if (!string.IsNullOrWhiteSpace(post.Description))
                                        {
                                            <p class="post-list-card__excerpt">@I18n.Text(post.Description)</p>
                                        }
                                        <div class="meta-line">
                                            <span><i class="far fa-user"></i>@authorName</span>
                                            <span><i class="far fa-calendar"></i>@I18n.FormatDateTime(post.Lastmod ?? post.Date)</span>
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>
                    }

                    @if (Model.TotalPages > 1)
                    {
                        <nav class="pagination-shell" aria-label="@I18n.T("tag.pagination", "标签分页")">
                            <p class="pagination-summary">@I18n.Format("pagination.postsSummary", "第 {0} / {1} 页，共 {2} 篇文章", Model.PageIndex, Model.TotalPages, Model.Total)</p>
                            <ul class="pagination justify-content-center pagination-list">
                                <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : "")">
                                    <a class="page-link" href="@Model.GetTagUrl(tagSlug)?pageIndex=@(Model.PageIndex - 1)">@I18n.T("pagination.previous", "上一页")</a>
                                </li>
                                @{
                                    var startPage = Math.Max(1, Model.PageIndex - 2);
                                    var endPage = Math.Min(Model.TotalPages, Model.PageIndex + 2);
                                    if (endPage - startPage < 4)
                                    {
                                        if (startPage == 1)
                                        {
                                            endPage = Math.Min(Model.TotalPages, startPage + 4);
                                        }
                                        else if (endPage == Model.TotalPages)
                                        {
                                            startPage = Math.Max(1, endPage - 4);
                                        }
                                    }
                                }
                                @if (startPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@Model.GetTagUrl(tagSlug)?pageIndex=1">1</a>
                                    </li>
                                    @if (startPage > 2)
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    }
                                }
                                @for (var i = startPage; i <= endPage; i++)
                                {
                                    <li class="page-item @(Model.PageIndex == i ? "active" : "")">
                                        <a class="page-link" href="@Model.GetTagUrl(tagSlug)?pageIndex=@i">@i</a>
                                    </li>
                                }
                                @if (endPage < Model.TotalPages)
                                {
                                    @if (endPage < Model.TotalPages - 1)
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    }
                                    <li class="page-item">
                                        <a class="page-link" href="@Model.GetTagUrl(tagSlug)?pageIndex=@Model.TotalPages">@Model.TotalPages</a>
                                    </li>
                                }
                                <li class="page-item @(Model.PageIndex >= Model.TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="@Model.GetTagUrl(tagSlug)?pageIndex=@(Model.PageIndex + 1)">@I18n.T("pagination.next", "下一页")</a>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>

                <aside class="content-sidebar">
                    <div class="surface-panel sidebar-panel sticky-panel">
                        <h2 class="sidebar-title">@I18n.T("nav.allTags", "全部标签")</h2>
                        <div class="sidebar-link-list">
                            @foreach (var tag in Model.Tags)
                            {
                                <a href="@Model.GetTagUrl(tag.Name)" class="sidebar-link @(string.Equals(tag.Name, Model.TagName, StringComparison.OrdinalIgnoreCase) ? "is-current" : string.Empty)">
                                    <span>@I18n.Text(tag.Name)</span>
                                    <i class="fas fa-angle-right"></i>
                                </a>
                            }
                        </div>
                    </div>
                </aside>
            </div>
        }
    </div>
</section>
