@page "/post"
@using Microsoft.Extensions.Options
@using WebApp.Extensions
@inject IOptions<WebApp.Options.SiteOption> SiteOptions
@model WebApp.Pages.Blog.IndexModel
@{
    ViewData["Title"] = I18n.T("nav.blog", "博客");
    ViewData["Description"] = I18n.T("blog.description", "浏览码坊博客内容，按时间查看最新技术文章。");
    var siteOwner = SiteOptions.Value.Owner ?? SiteOptions.Value.AppTitle ?? I18n.T("site.name", "码坊");
    var startPage = Math.Max(1, Model.PageIndex - 2);
    var endPage = Math.Min(Model.TotalPages, Model.PageIndex + 2);
    if (endPage - startPage < 4)
    {
        if (startPage == 1)
        {
            endPage = Math.Min(Model.TotalPages, startPage + 4);
        }
        else if (endPage == Model.TotalPages)
        {
            startPage = Math.Max(1, endPage - 4);
        }
    }
}

<section class="page-shell">
    <div class="container">
        <div class="page-banner">
            <div>
                <span class="eyebrow">Blog</span>
                <h1 class="page-title">@I18n.T("blog.title", "技术文章")</h1>
                <p class="page-description">
                    @I18n.T("blog.intro", "这里收录站点的文章正文，覆盖 .NET、桌面开发、工程实践与通用开发话题。")
                </p>
            </div>
            <div class="page-banner__stats">
                <a href="@ConstantUtil.GetBlogUrl()" class="stat-chip stat-chip--link">
                    <strong>@Model.Total</strong>
                    <span>@I18n.T("blog.postCountUnit", "篇文章")</span>
                </a>
                <a href="@ConstantUtil.GetCategoryDirectoryUrl()" class="stat-chip stat-chip--link">
                    <strong>@Math.Max(0, Model.Categories.Count - 1)</strong>
                    <span>@I18n.T("blog.categoryCountUnit", "个分类")</span>
                </a>
            </div>
        </div>

        <div class="discovery-grid">
            <section class="surface-panel discovery-panel">
                <div class="surface-panel__header">
                    <div>
                        <span class="eyebrow">@I18n.T("blog.startEyebrow", "第一次访问")</span>
                        <h2 class="surface-title">@I18n.T("home.startTitle", "新用户起步路线")</h2>
                    </div>
                </div>
                <div class="discovery-link-list">
                    @foreach (var link in Model.GettingStartedLinks)
                    {
                        <a href="@link.Url" class="discovery-link-card">
                            <span class="card-kicker">@I18n.Text(link.Eyebrow)</span>
                            <strong>@I18n.Text(link.Title)</strong>
                            <p>@I18n.Text(link.Description)</p>
                        </a>
                    }
                </div>
            </section>

            <section class="surface-panel discovery-panel">
                <div class="surface-panel__header">
                    <div>
                        <span class="eyebrow">@I18n.T("home.randomEyebrow", "随机探索")</span>
                        <h2 class="surface-title">@I18n.T("home.randomTitle", "随机发现")</h2>
                    </div>
                </div>

                @if (!Model.RandomPosts.Any())
                {
                    <div class="empty-state empty-state--compact">
                        <p>@I18n.T("blog.emptyRandom", "这里会轮换一些值得顺手点开的文章。")</p>
                    </div>
                }
                else
                {
                    <div class="discovery-post-list">
                        @foreach (var post in Model.RandomPosts)
                        {
                            <article class="discovery-post-card">
                                <span class="card-kicker">@I18n.Text(post.Eyebrow)</span>
                                <h3><a href="@post.Url">@I18n.Text(post.Title)</a></h3>
                                <p>@I18n.Text(post.Description)</p>
                                <div class="resource-card__meta">
                                    <span><i class="far fa-compass"></i>@I18n.Text(post.MetaLabel)</span>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        </div>

        <div class="content-grid">
            <div class="content-primary">
                @if (!Model.Posts.Any())
                {
                    <div class="empty-state">
                        <h2>@I18n.T("blog.emptyTitle", "还没有文章")</h2>
                        <p>@I18n.T("blog.emptyDescription", "当前博客列表为空，后续内容会在这里展示。")</p>
                    </div>
                }
                else
                {
                    <div class="post-list">
                        @foreach (var post in Model.Posts)
                        {
                            var postUrl = ConstantUtil.GetPostUrl(post);
                            var hasCover = !string.IsNullOrWhiteSpace(post.Cover);
                            var authorName = string.IsNullOrWhiteSpace(post.Author) ? siteOwner : post.Author;
                            var postTitle = I18n.Text(post.Title);
                            var postDescription = I18n.Text(post.Description);

                            <article class="post-list-card @(hasCover ? string.Empty : "post-list-card--text-only")">
                                @if (hasCover)
                                {
                                    <a href="@postUrl" class="post-list-card__cover">
                                        <img src="@post.Cover" alt="@postTitle" class="cover-media" loading="lazy" decoding="async" />
                                    </a>
                                }

                                <div class="post-list-card__body">
                                    <h2 class="post-list-card__title">
                                        <a href="@postUrl">@postTitle</a>
                                    </h2>
                                    @if (!string.IsNullOrWhiteSpace(postDescription))
                                    {
                                        <p class="post-list-card__excerpt">@postDescription</p>
                                    }
                                    <div class="meta-line">
                                        <span><i class="far fa-calendar"></i>@I18n.FormatDate(post.Lastmod ?? post.Date)</span>
                                        <span><i class="far fa-user"></i>@authorName</span>
                                        @if (post.Categories?.Any() == true)
                                        {
                                            <span><i class="far fa-folder-open"></i>@I18n.Text(string.Join(" / ", post.Categories.Take(2)))</span>
                                        }
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }

                @if (Model.TotalPages > 1)
                {
                    <nav class="pagination-shell" aria-label="@I18n.T("blog.pagination", "博客分页")">
                        <p class="pagination-summary">@I18n.Format("pagination.postsSummary", "第 {0} / {1} 页，共 {2} 篇文章", Model.PageIndex, Model.TotalPages, Model.Total)</p>
                        <ul class="pagination justify-content-center pagination-list">
                            <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : "")">
                                <a class="page-link" href="@ConstantUtil.GetBlogUrl(Model.PageIndex - 1)">@I18n.T("pagination.previous", "上一页")</a>
                            </li>
                            @if (startPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="@ConstantUtil.GetBlogUrl(1)">1</a>
                                </li>
                                @if (startPage > 2)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                            }
                            @for (var i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(Model.PageIndex == i ? "active" : "")">
                                    <a class="page-link" href="@ConstantUtil.GetBlogUrl(i)">@i</a>
                                </li>
                            }
                            @if (endPage < Model.TotalPages)
                            {
                                @if (endPage < Model.TotalPages - 1)
                                {
                                    <li class="page-item disabled">
                                        <span class="page-link">...</span>
                                    </li>
                                }
                                <li class="page-item">
                                    <a class="page-link" href="@ConstantUtil.GetBlogUrl(Model.TotalPages)">@Model.TotalPages</a>
                                </li>
                            }
                            <li class="page-item @(Model.PageIndex >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@ConstantUtil.GetBlogUrl(Model.PageIndex + 1)">@I18n.T("pagination.next", "下一页")</a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>

            <aside class="content-sidebar">
                <div class="surface-panel sidebar-panel sticky-panel">
                    <h2 class="sidebar-title">@I18n.T("blog.categoriesTitle", "文章分类")</h2>
                    <p class="sidebar-copy">@I18n.T("blog.categoriesDescription", "按分类浏览，更快定位你想看的技术主题。")</p>
                    <div class="sidebar-link-list">
                        @foreach (var category in Model.Categories)
                        {
                            <a href="@ConstantUtil.GetCategoryUrl(category.Slug ?? ConstantUtil.DefaultCategory)" class="sidebar-link">
                                <span>@I18n.Text(category.Name)</span>
                                <i class="fas fa-angle-right"></i>
                            </a>
                        }
                    </div>

                    @if (Model.SerialReadingLinks.Any())
                    {
                        <div class="sidebar-link-list sidebar-link-list--compact">
                            <span class="card-kicker">@I18n.T("blog.serialTitle", "连续阅读")</span>
                            @foreach (var link in Model.SerialReadingLinks)
                            {
                                <a href="@link.Url" class="sidebar-link">
                                    <span>
                                        @I18n.Text(link.Title)
                                        <small class="article-guide-link__desc">@I18n.Text(link.Description)</small>
                                    </span>
                                    <i class="fas fa-angle-right"></i>
                                </a>
                            }
                        </div>
                    }
                </div>
            </aside>
        </div>
    </div>
</section>
