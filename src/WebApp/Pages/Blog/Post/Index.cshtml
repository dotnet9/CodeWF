@page "/{year:int}/{month:int}/{slug}"
@using System.Text.Encodings.Web
@using System.Text.Json
@using Microsoft.Extensions.Options
@using WebApp.Extensions
@inject IOptions<WebApp.Options.SiteOption> SiteOptions
@model WebApp.Pages.Blog.Post.IndexModel
@{
    var site = SiteOptions.Value;
    ViewData["Title"] = Model.Post?.Title ?? "文章详情";
    ViewData["Description"] = Model.Post?.Description ?? "浏览码坊技术文章。";
    var siteOwner = site.Owner ?? site.AppTitle ?? "码坊";
    var articleJson = string.Empty;

    if (Model.Post != null)
    {
        var siteDomain = (site.Domain ?? $"{HttpContext.Request.Scheme}://{HttpContext.Request.Host}").TrimEnd('/');
        string AbsoluteUrl(string? url)
        {
            if (string.IsNullOrWhiteSpace(url))
            {
                return $"{siteDomain}/";
            }

            return Uri.TryCreate(url, UriKind.Absolute, out _)
                ? url
                : $"{siteDomain}/{url.TrimStart('/')}";
        }

        var articleUrl = $"{siteDomain}{ConstantUtil.GetPostUrl(Model.Post)}";
        var articleImage = string.IsNullOrWhiteSpace(Model.Post.Cover)
            ? AbsoluteUrl(site.Favicon ?? "/favicon.png")
            : AbsoluteUrl(Model.Post.Cover);
        var keywords = (Model.Post.Tags ?? [])
            .Concat(Model.Post.Categories ?? [])
            .Concat(Model.Post.Albums ?? [])
            .Where(static item => !string.IsNullOrWhiteSpace(item))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        ViewData["CanonicalPath"] = ConstantUtil.GetPostUrl(Model.Post);
        ViewData["OgType"] = "article";
        ViewData["OgImage"] = articleImage;
        ViewData["Keywords"] = keywords.Any()
            ? string.Join(",", keywords)
            : ".NET,C#,技术文章,码坊";
        ViewData["ArticlePublishedTime"] = Model.Post.Date?.ToString("O");
        ViewData["ArticleModifiedTime"] = (Model.Post.Lastmod ?? Model.Post.Date)?.ToString("O");
        ViewData["ArticleAuthor"] = string.IsNullOrWhiteSpace(Model.Post.Author) ? siteOwner : Model.Post.Author;

        var articleSchema = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "Article",
            ["headline"] = Model.Post.Title,
            ["description"] = Model.Post.Description,
            ["image"] = new[] { articleImage },
            ["datePublished"] = Model.Post.Date?.ToString("O"),
            ["dateModified"] = (Model.Post.Lastmod ?? Model.Post.Date)?.ToString("O"),
            ["mainEntityOfPage"] = new Dictionary<string, string>
            {
                ["@type"] = "WebPage",
                ["@id"] = articleUrl
            },
            ["author"] = new Dictionary<string, string>
            {
                ["@type"] = "Person",
                ["name"] = ViewData["ArticleAuthor"]?.ToString() ?? siteOwner
            },
            ["publisher"] = new Dictionary<string, object?>
            {
                ["@type"] = "Organization",
                ["name"] = site.AppTitle ?? "码坊",
                ["logo"] = new Dictionary<string, string>
                {
                    ["@type"] = "ImageObject",
                    ["url"] = AbsoluteUrl(site.Favicon ?? "/favicon.png")
                }
            },
            ["keywords"] = keywords
        };

        articleJson = JsonSerializer.Serialize(articleSchema, new JsonSerializerOptions
        {
            Encoder = JavaScriptEncoder.UnsafeRelaxedJsonEscaping
        });
    }
}

@section Head {
    <partial name="_CodeHighlightHead" />
    @if (!string.IsNullOrWhiteSpace(articleJson))
    {
        <script type="application/ld+json">
            @Html.Raw(articleJson)
        </script>
    }
}

<section class="page-shell">
    <div class="container">
        @if (Model.Post == null)
        {
            <div class="empty-state">
                <h2>文章不存在或已下线</h2>
                <p>可以返回博客首页继续浏览其他内容。</p>
            </div>
        }
        else
        {
            var authorName = string.IsNullOrWhiteSpace(Model.Post.Author) ? siteOwner : Model.Post.Author;
            var updatedAt = I18n.FormatDateTime(Model.Post.Lastmod ?? Model.Post.Date);
            var categorySummary = string.Join(" / ", Model.CategoryLinks.Select(item => item.Label));
            var albumSummary = string.Join(" / ", Model.AlbumLinks.Select(item => item.Label));
            var tagSummary = string.Join(" / ", Model.TagLinks.Select(item => item.Label));
            <div class="reading-progress-shell" aria-hidden="true">
                <span class="reading-progress-bar" data-reading-progress-bar></span>
            </div>

            <div class="page-banner article-banner">
                <div class="article-banner__cover">
                    @if (!string.IsNullOrWhiteSpace(Model.Post.Cover))
                    {
                        <img src="@Model.Post.Cover" alt="@Model.Post.Title" class="cover-media article-banner__cover-media" decoding="async" fetchpriority="high" />
                    }
                    else
                    {
                        <div class="article-banner__cover-placeholder">
                            <i class="fas fa-file-lines"></i>
                        </div>
                    }
                </div>
                <div class="article-banner__content">
                    <div>
                        <h1 class="page-title">@Model.Post.Title</h1>
                        @if (!string.IsNullOrWhiteSpace(Model.Post.Description))
                        {
                            <p class="page-description">@Model.Post.Description</p>
                        }
                    </div>

                    <div class="article-banner__meta-grid">
                        @if (!string.IsNullOrWhiteSpace(updatedAt))
                        {
                            <div class="meta-chip article-banner__meta-card">
                                <i class="fas fa-rotate-right"></i>
                                <span>最后更新 @updatedAt</span>
                            </div>
                        }
                        <div class="meta-chip article-banner__meta-card">
                            <i class="far fa-user"></i>
                            <span>@authorName</span>
                        </div>
                        <div class="meta-chip article-banner__meta-card">
                            <i class="far fa-clock"></i>
                            <span>预计阅读 @Model.EstimatedReadingMinutes 分钟</span>
                        </div>
                    </div>

                    <div class="article-topic-summary-list">
                        @if (!string.IsNullOrWhiteSpace(categorySummary))
                        {
                            <div class="article-topic-summary">
                                <span class="article-topic-summary__label">分类</span>
                                <div class="article-topic-summary__value article-topic-link-list" title="@categorySummary">
                                    @foreach (var link in Model.CategoryLinks)
                                    {
                                        <a href="@link.Url" class="article-topic-link">
                                            <i class="@link.IconClass"></i>
                                            <span>@link.Label</span>
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(albumSummary))
                        {
                            <div class="article-topic-summary">
                                <span class="article-topic-summary__label">专题</span>
                                <div class="article-topic-summary__value article-topic-link-list" title="@albumSummary">
                                    @foreach (var link in Model.AlbumLinks)
                                    {
                                        <a href="@link.Url" class="article-topic-link">
                                            <i class="@link.IconClass"></i>
                                            <span>@link.Label</span>
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(tagSummary))
                        {
                            <div class="article-topic-summary">
                                <span class="article-topic-summary__label">标签</span>
                                <div class="article-topic-summary__value article-topic-link-list" title="@tagSummary">
                                    @foreach (var link in Model.TagLinks)
                                    {
                                        <a href="@link.Url" class="article-topic-link">
                                            <i class="@link.IconClass"></i>
                                            <span>@link.Label</span>
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="article-layout">
                <div class="article-main">
                    <article class="surface-panel article-panel">
                        <div class="prose article-content" data-reading-body>
                            @Html.Raw(Model.Post.HtmlContent)
                        </div>
                    </article>

                    @if (Model.RelatedPosts.Any())
                    {
                        <section class="surface-panel article-related-panel">
                            <div class="surface-panel__header">
                                <div>
                                    <span class="eyebrow">Keep Exploring</span>
                                    <h2 class="surface-title">延伸阅读</h2>
                                </div>
                                <a href="@ConstantUtil.GetBlogUrl()" class="surface-link">更多文章</a>
                            </div>

                            <div class="article-related-grid">
                                @foreach (var relatedPost in Model.RelatedPosts)
                                {
                                    <article class="article-related-card">
                                        <div class="article-related-card__meta">
                                            <span class="article-related-card__badge">@relatedPost.ContextLabel</span>
                                            @if (relatedPost.UpdatedAt.HasValue)
                                            {
                                                <span>@I18n.FormatDate(relatedPost.UpdatedAt)</span>
                                            }
                                        </div>
                                        <h3>
                                            <a href="@relatedPost.Url">@relatedPost.Title</a>
                                        </h3>
                                        @if (!string.IsNullOrWhiteSpace(relatedPost.Description))
                                        {
                                            <p>@relatedPost.Description</p>
                                        }
                                        <a href="@relatedPost.Url" class="inline-link">
                                            继续阅读
                                            <i class="fas fa-arrow-right"></i>
                                        </a>
                                    </article>
                                }
                            </div>
                        </section>
                    }

                    @if (Model.PreviousPost != null || Model.NextPost != null)
                    {
                        <nav class="doc-pager" aria-label="文章阅读导航">
                            @if (Model.PreviousPost != null)
                            {
                                var previousUrl = ConstantUtil.GetPostUrl(Model.PreviousPost);
                                <a href="@previousUrl" class="surface-panel doc-pager__item doc-pager__item--prev">
                                    <span class="doc-pager__label">
                                        <i class="fas fa-arrow-left"></i>
                                        上一篇
                                    </span>
                                    <strong>@Model.PreviousPost.Title</strong>
                                    @if (!string.IsNullOrWhiteSpace(Model.PreviousPost.Description))
                                    {
                                        <p>@Model.PreviousPost.Description</p>
                                    }
                                </a>
                            }
                            else
                            {
                                <div class="surface-panel doc-pager__item doc-pager__item--empty" aria-hidden="true"></div>
                            }

                            @if (Model.NextPost != null)
                            {
                                var nextUrl = ConstantUtil.GetPostUrl(Model.NextPost);
                                <a href="@nextUrl" class="surface-panel doc-pager__item doc-pager__item--next">
                                    <span class="doc-pager__label">
                                        下一篇
                                        <i class="fas fa-arrow-right"></i>
                                    </span>
                                    <strong>@Model.NextPost.Title</strong>
                                    @if (!string.IsNullOrWhiteSpace(Model.NextPost.Description))
                                    {
                                        <p>@Model.NextPost.Description</p>
                                    }
                                </a>
                            }
                            else
                            {
                                <div class="surface-panel doc-pager__item doc-pager__item--empty" aria-hidden="true"></div>
                            }
                        </nav>
                    }
                </div>

                <aside class="article-aside sticky-panel">
                    <div id="toc" class="surface-panel toc-panel" data-reading-toc data-toc-hide-empty="true">
                        <h2 class="sidebar-title">目录</h2>
                        <div class="toc-nav"></div>
                    </div>
                </aside>
            </div>
        }
    </div>
</section>

@section Scripts {
    <partial name="_CodeHighlightScripts" />
}
