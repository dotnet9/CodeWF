@page "/cat/{slug?}"
@using WebApp.Extensions
@model WebApp.Pages.Blog.Category.IndexModel
@{
    ViewData["Title"] = Model.IsDirectoryPage
        ? I18n.T("home.categories", "分类")
        : I18n.Format("category.titleWithName", "{0} - 博客分类", I18n.Text(Model.CategoryName));
    ViewData["Description"] = Model.IsDirectoryPage
        ? I18n.T("category.directoryDescription", "浏览码墙全部文章分类。")
        : (string.IsNullOrWhiteSpace(Model.CategoryMemo)
            ? I18n.Format("category.descriptionWithName", "查看 {0} 分类下的技术文章。", I18n.Text(Model.CategoryName))
            : I18n.Text(Model.CategoryMemo));
    var categorySlug = Model.CurrentSlug ?? string.Empty;
    var categories = Model.Categories
        .Where(item => !string.Equals(item.Slug, "default", StringComparison.OrdinalIgnoreCase))
        .ToList();
}

<section class="page-shell">
    <div class="container">
        <div class="page-banner">
            <div>
                <span class="eyebrow">@I18n.T("category.eyebrow", "分类")</span>
                <h1 class="page-title">@(Model.IsDirectoryPage ? I18n.T("nav.allCategories", "全部分类") : I18n.Text(Model.CategoryName))</h1>
                <p class="page-description">@(string.IsNullOrWhiteSpace(Model.CategoryMemo) ? I18n.T("category.browseDescription", "按分类浏览站内文章内容。") : I18n.Text(Model.CategoryMemo))</p>
            </div>
            @if (!Model.IsDirectoryPage)
            {
                <div class="page-banner__stats">
                    <div class="stat-chip">
                        <strong>@Model.Total</strong>
                        <span>@I18n.T("blog.postCountUnit", "篇文章")</span>
                    </div>
                    <div class="stat-chip">
                        <strong>@Model.PageIndex</strong>
                        <span>@I18n.T("pagination.currentPage", "当前页")</span>
                    </div>
                </div>
            }
        </div>

        @if (Model.IsDirectoryPage)
        {
            <div class="surface-panel directory-panel">
                @if (!categories.Any())
                {
                    <div class="empty-state">
                        <h2>@I18n.T("category.emptyDirectoryTitle", "暂未配置分类")</h2>
                        <p>@I18n.T("category.emptyDirectoryDescription", "后续会在这里展示全部文章分类。")</p>
                    </div>
                }
                else
                {
                    <div class="directory-grid">
                        @foreach (var category in categories)
                        {
                            <a href="@ConstantUtil.GetCategoryUrl(category.Slug!)" class="directory-card">
                                <strong>@I18n.Text(category.Name)</strong>
                                @if (!string.IsNullOrWhiteSpace(category.Memo))
                                {
                                    <p>@I18n.Text(category.Memo)</p>
                                }
                            </a>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="content-grid">
                <div class="content-primary">
                    @if (!Model.Posts.Any())
                    {
                        <div class="empty-state">
                            <h2>@I18n.T("category.emptyPostsTitle", "这个分类下还没有文章")</h2>
                            <p>@I18n.T("category.emptyPostsDescription", "可以先去首页或博客列表看看其他内容。")</p>
                        </div>
                    }
                    else
                    {
                        <div class="post-list">
                            @foreach (var post in Model.Posts)
                            {
                                var postUrl = ConstantUtil.GetPostUrl(post);
                                var hasCover = !string.IsNullOrWhiteSpace(post.Cover);
                                var postTitle = I18n.Text(post.Title);
                                var authorName = I18n.Text(string.IsNullOrWhiteSpace(post.Author) ? Model.Owner : post.Author);
                                <article class="post-list-card @(hasCover ? string.Empty : "post-list-card--text-only")">
                                    @if (hasCover)
                                    {
                                        <a href="@postUrl" class="post-list-card__cover">
                                            <img src="@post.Cover" alt="@postTitle" class="cover-media" loading="lazy" decoding="async" />
                                        </a>
                                    }
                                    <div class="post-list-card__body">
                                        <h2 class="post-list-card__title"><a href="@postUrl">@I18n.Text(post.Title)</a></h2>
                                        @if (!string.IsNullOrWhiteSpace(post.Description))
                                        {
                                            <p class="post-list-card__excerpt">@I18n.Text(post.Description)</p>
                                        }
                                        <div class="meta-line">
                                            <span><i class="far fa-user"></i>@authorName</span>
                                            <span><i class="far fa-calendar"></i>@I18n.FormatDateTime(post.Lastmod ?? post.Date)</span>
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>
                    }

                    @if (Model.TotalPages > 1)
                    {
                        <nav class="pagination-shell" aria-label="@I18n.T("category.pagination", "分类分页")">
                            <p class="pagination-summary">@I18n.Text($"第 {Model.PageIndex} / {Model.TotalPages} 页，共 {Model.Total} 篇文章")</p>
                            <ul class="pagination justify-content-center pagination-list">
                                <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : "")">
                                    <a class="page-link" href="@ConstantUtil.GetCategoryUrl(categorySlug)?pageIndex=@(Model.PageIndex - 1)">@I18n.T("pagination.previous", "上一页")</a>
                                </li>
                                @{
                                    var startPage = Math.Max(1, Model.PageIndex - 2);
                                    var endPage = Math.Min(Model.TotalPages, Model.PageIndex + 2);
                                    if (endPage - startPage < 4)
                                    {
                                        if (startPage == 1)
                                        {
                                            endPage = Math.Min(Model.TotalPages, startPage + 4);
                                        }
                                        else if (endPage == Model.TotalPages)
                                        {
                                            startPage = Math.Max(1, endPage - 4);
                                        }
                                    }
                                }
                                @if (startPage > 1)
                                {
                                    <li class="page-item">
                                        <a class="page-link" href="@ConstantUtil.GetCategoryUrl(categorySlug)?pageIndex=1">1</a>
                                    </li>
                                    @if (startPage > 2)
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    }
                                }
                                @for (var i = startPage; i <= endPage; i++)
                                {
                                    <li class="page-item @(Model.PageIndex == i ? "active" : "")">
                                        <a class="page-link" href="@ConstantUtil.GetCategoryUrl(categorySlug)?pageIndex=@i">@i</a>
                                    </li>
                                }
                                @if (endPage < Model.TotalPages)
                                {
                                    @if (endPage < Model.TotalPages - 1)
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    }
                                    <li class="page-item">
                                        <a class="page-link" href="@ConstantUtil.GetCategoryUrl(categorySlug)?pageIndex=@Model.TotalPages">@Model.TotalPages</a>
                                    </li>
                                }
                                <li class="page-item @(Model.PageIndex >= Model.TotalPages ? "disabled" : "")">
                                    <a class="page-link" href="@ConstantUtil.GetCategoryUrl(categorySlug)?pageIndex=@(Model.PageIndex + 1)">@I18n.T("pagination.next", "下一页")</a>
                                </li>
                            </ul>
                        </nav>
                    }
                </div>

                <aside class="content-sidebar">
                    <div class="surface-panel sidebar-panel sticky-panel">
                        <h2 class="sidebar-title">@I18n.T("nav.allCategories", "全部分类")</h2>
                        <div class="sidebar-link-list">
                            @foreach (var category in categories)
                            {
                                <a href="@ConstantUtil.GetCategoryUrl(category.Slug!)" class="sidebar-link @(category.Slug == categorySlug ? "is-current" : string.Empty)">
                                    <span>@I18n.Text(category.Name)</span>
                                    <i class="fas fa-angle-right"></i>
                                </a>
                            }
                        </div>
                    </div>
                </aside>
            </div>
        }
    </div>
</section>
