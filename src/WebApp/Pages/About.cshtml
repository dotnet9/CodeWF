@page "/about"
@model WebApp.Pages.AboutModel
@{
    ViewData["Title"] = I18n.T("nav.about", "关于");
    ViewData["Description"] = I18n.T("about.description", "了解码坊的定位、内容方向与维护理念。");
    var banner = new WebApp.Models.PageBannerViewModel
    {
        Eyebrow = I18n.T("about.eyebrow", "关于 CodeWF"),
        Title = I18n.T("about.title", "一个把文章、项目和工具串起来的技术站点"),
        Description = I18n.T("about.intro", "码坊聚焦 .NET 与工程实践，希望把可复用的知识、可检索的项目说明和能直接落地的小工具沉淀成稳定入口。"),
        MetaItems = [
            I18n.T("about.meta.content", "持续沉淀技术内容"),
            I18n.T("about.meta.tools", "面向开发者的实用工具"),
            I18n.T("about.meta.albums", "专题化组织知识资产")
        ]
    };
}

@section Head {
    <partial name="_CodeHighlightHead" />
}

<section class="page-shell">
    <div class="container">
        <partial name="_PageBanner" model="banner" />

        @if (!string.IsNullOrEmpty(Model.HtmlContent))
        {
            <div class="article-layout">
                <div class="article-main">
                    <article class="surface-panel article-panel">
                        <div class="prose article-content" data-reading-body asp-prerender="true">
                            @Html.Raw(Model.HtmlContent)
                        </div>
                    </article>
                </div>

                <aside class="article-aside sticky-panel">
                    <div id="about-toc" class="surface-panel toc-panel" data-reading-toc data-toc-hide-empty="true">
                        <h2 class="sidebar-title">@I18n.T("post.toc", "目录")</h2>
                        <div class="toc-nav"></div>
                    </div>
                </aside>
            </div>
        }
        else
        {
            <div class="empty-state">
                <h2>@I18n.T("about.emptyTitle", "内容准备中")</h2>
                <p>@I18n.T("about.emptyDescription", "关于页的详细介绍暂时还没有加载出来，稍后可以再来看看。")</p>
            </div>
        }
    </div>
</section>

@section Scripts {
    <partial name="_CodeHighlightScripts" />
}
