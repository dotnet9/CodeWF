@page "/tool/text-diff"
@{
    ViewData["Title"] = "文本差异比较";
    ViewData["Description"] = "逐行比较两段文本，显示新增和删除内容。";
    ViewData["CanonicalPath"] = "/tool/text-diff";
    var banner = new WebApp.Models.PageBannerViewModel
    {
        Eyebrow = "文本工具",
        Title = "文本差异比较",
        Description = "逐行比较两段文本，显示新增和删除内容。",
        MetaItems = ["Razor Pages", "原生工具", "text-diff"]
    };
}

<section class="page-shell">
    <div class="container">
        <partial name="_PageBanner" model="banner" />

        <div class="tool-detail-nav">
            <a class="inline-link" href="/tool">
                <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                返回工具箱
            </a>
        </div>

        <article class="surface-panel native-tool-host">
            <div class="native-tool-panel__head">
                <div>
                    <span class="card-kicker">Razor Pages 原生工具</span>
                    <h2 class="surface-title">文本差异比较</h2>
                </div>
                <button type="button" class="btn btn-ghost btn-sm" onclick="copyOutput()">
                    <i class="fa-regular fa-copy" aria-hidden="true"></i> 复制结果
                </button>
            </div>
            <div class="native-tool-grid">
<label class="native-field native-field--full"><span>原文本</span><textarea class="form-control native-textarea" id="left" rows="8">Hello
CodeWF</textarea></label><label class="native-field native-field--full"><span>新文本</span><textarea class="form-control native-textarea" id="right" rows="8">Hello
CodeWF Tools
CodeWF</textarea></label>

                <div class="native-tool-actions native-field--full">
                    <button type="button" class="btn btn-primary" onclick="runTool()">执行</button>
                </div>
                <label class="native-field native-field--full">
                    <span>输出</span>
                    <textarea class="form-control native-textarea native-textarea--output" id="output" rows="10" readonly></textarea>
                </label>
            </div>
        </article>
    </div>
</section>

@section Scripts {
<script>

function $(id) { return document.getElementById(id); }
function setOutput(value) { const output = $('output'); if (output) output.value = value ?? ''; else if (output) output.textContent = value ?? ''; }
function showError(error) { setOutput(error?.message ?? String(error)); }
async function copyOutput() {
    const output = $('output');
    if (!output) return;
    try { await navigator.clipboard.writeText(output.value || output.textContent || ''); }
    catch { output.select?.(); document.execCommand('copy'); }
}
function escapeHtml(value) {
    return String(value ?? '').replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;').replaceAll("'", '&#39;');
}
function loadScript(src, globalName) {
    if (globalName && window[globalName]) return Promise.resolve(window[globalName]);
    return new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = src;
        script.async = true;
        script.onload = () => resolve(globalName ? window[globalName] : true);
        script.onerror = () => reject(new Error('资源加载失败：' + src));
        document.head.appendChild(script);
    });
}
const moduleCache = new Map();
function loadModule(src) {
    if (!moduleCache.has(src)) moduleCache.set(src, import(src));
    return moduleCache.get(src);
}

function clearTool() { if ($('input')) $('input').value = ''; setOutput(''); $('input')?.focus(); }
function runTool(){const a=$('left').value.replace(/\r\n?/g,'\n').split('\n'), b=$('right').value.replace(/\r\n?/g,'\n').split('\n'), rows=[]; for(let i=0;i<Math.max(a.length,b.length);i++){ if(a[i]===b[i]) rows.push('  '+(a[i]??'')); else { if(a[i]!==undefined) rows.push('- '+a[i]); if(b[i]!==undefined) rows.push('+ '+b[i]); } } setOutput(rows.join('\n'));}
document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, textarea, select').forEach(el => {
        el.addEventListener('input', () => runTool?.());
        el.addEventListener('change', () => runTool?.());
    });

});
</script>
}
