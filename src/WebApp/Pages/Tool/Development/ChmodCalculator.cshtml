@page "/tool/chmod-calculator"
@{
    ViewData["Title"] = "Chmod 权限计算器";
    ViewData["Description"] = "选择读、写、执行权限，生成八进制和符号形式的 chmod 命令。";
    ViewData["CanonicalPath"] = "/tool/chmod-calculator";
    var banner = new WebApp.Models.PageBannerViewModel
    {
        Eyebrow = "开发工具",
        Title = "Chmod 权限计算器",
        Description = "选择读、写、执行权限，生成八进制和符号形式的 chmod 命令。",
        MetaItems = ["Razor Pages", "原生工具", "chmod-calculator"]
    };
}

<section class="page-shell">
    <div class="container">
        <partial name="_PageBanner" model="banner" />

        <div class="tool-detail-nav">
            <a class="inline-link" href="/tool">
                <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                返回工具箱
            </a>
        </div>

        <article class="surface-panel native-tool-host">
            <div class="native-tool-panel__head">
                <div>
                    <span class="card-kicker">Razor Pages 原生工具</span>
                    <h2 class="surface-title">Chmod 权限计算器</h2>
                </div>
                <button type="button" class="btn btn-ghost btn-sm" onclick="copyOutput()">
                    <i class="fa-regular fa-copy" aria-hidden="true"></i> 复制结果
                </button>
            </div>
            <div class="native-chmod"><fieldset><legend>所有者</legend><label class="native-check"><input type="checkbox" data-g="o" data-v="4" checked /> 读</label><label class="native-check"><input type="checkbox" data-g="o" data-v="2" checked /> 写</label><label class="native-check"><input type="checkbox" data-g="o" data-v="1" checked /> 执行</label></fieldset><fieldset><legend>组</legend><label class="native-check"><input type="checkbox" data-g="g" data-v="4" checked /> 读</label><label class="native-check"><input type="checkbox" data-g="g" data-v="2" /> 写</label><label class="native-check"><input type="checkbox" data-g="g" data-v="1" checked /> 执行</label></fieldset><fieldset><legend>其他</legend><label class="native-check"><input type="checkbox" data-g="x" data-v="4" checked /> 读</label><label class="native-check"><input type="checkbox" data-g="x" data-v="2" /> 写</label><label class="native-check"><input type="checkbox" data-g="x" data-v="1" checked /> 执行</label></fieldset></div><textarea class="form-control native-textarea native-textarea--output" id="output" rows="5" readonly></textarea>
        </article>
    </div>
</section>

@section Scripts {
<script>

function $(id) { return document.getElementById(id); }
function setOutput(value) { const output = $('output'); if (output) output.value = value ?? ''; else if (output) output.textContent = value ?? ''; }
function showError(error) { setOutput(error?.message ?? String(error)); }
async function copyOutput() {
    const output = $('output');
    if (!output) return;
    try { await navigator.clipboard.writeText(output.value || output.textContent || ''); }
    catch { output.select?.(); document.execCommand('copy'); }
}
function escapeHtml(value) {
    return String(value ?? '').replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;').replaceAll("'", '&#39;');
}
function loadScript(src, globalName) {
    if (globalName && window[globalName]) return Promise.resolve(window[globalName]);
    return new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = src;
        script.async = true;
        script.onload = () => resolve(globalName ? window[globalName] : true);
        script.onerror = () => reject(new Error('资源加载失败：' + src));
        document.head.appendChild(script);
    });
}
const moduleCache = new Map();
function loadModule(src) {
    if (!moduleCache.has(src)) moduleCache.set(src, import(src));
    return moduleCache.get(src);
}

function runTool(){ const groups=['o','g','x']; const digits=groups.map(g=>[...document.querySelectorAll('[data-g="'+g+'"]')].reduce((s,i)=>s+(i.checked?Number(i.dataset.v):0),0)); const symbols=groups.map(g=>[...document.querySelectorAll('[data-g="'+g+'"]')].map(i=>i.checked?({4:'r',2:'w',1:'x'}[i.dataset.v]):'-').join('')).join(''); setOutput('八进制：'+digits.join('')+'\n符号：'+symbols+'\n命令：chmod '+digits.join('')+' file'); }
document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, textarea, select').forEach(el => {
        el.addEventListener('input', () => runTool?.());
        el.addEventListener('change', () => runTool?.());
    });
    document.querySelectorAll('input').forEach(i=>i.addEventListener('change',runTool)); runTool();
});
</script>
}
