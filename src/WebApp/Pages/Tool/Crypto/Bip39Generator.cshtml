@page "/tool/bip39-generator"
@{
    ViewData["Title"] = "BIP39 助记词生成器";
    ViewData["Description"] = "生成 BIP39 助记词短语，便于学习和测试助记词相关流程。";
    ViewData["CanonicalPath"] = "/tool/bip39-generator";
    var banner = new WebApp.Models.PageBannerViewModel
    {
        Eyebrow = "加密与安全",
        Title = "BIP39 助记词生成器",
        Description = "生成 BIP39 助记词短语，便于学习和测试助记词相关流程。",
        MetaItems = ["Razor Pages", "原生工具", "bip39-generator"]
    };
}

<section class="page-shell">
    <div class="container">
        <partial name="_PageBanner" model="banner" />

        <div class="tool-detail-nav">
            <a class="inline-link" href="/tool">
                <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                返回工具箱
            </a>
        </div>

        <article class="surface-panel native-tool-host">
            <div class="native-tool-panel__head">
                <div>
                    <span class="card-kicker">Razor Pages 原生工具</span>
                    <h2 class="surface-title">BIP39 助记词生成器</h2>
                </div>
                <button type="button" class="btn btn-ghost btn-sm" onclick="copyOutput()">
                    <i class="fa-regular fa-copy" aria-hidden="true"></i> 复制结果
                </button>
            </div>
            <div class="native-tool-grid">
                <label class="native-field">
                    <span>语言</span>
                    <select class="form-select" id="language">
                        <option value="english" selected>English</option>
                        <option value="chineseSimplified">中文简体</option>
                        <option value="chineseTraditional">中文繁体</option>
                        <option value="french">French</option>
                        <option value="italian">Italian</option>
                        <option value="spanish">Spanish</option>
                    </select>
                </label>                <label class="native-field">
                    <span>Entropy 十六进制</span>
                    <input class="form-control" id="entropy" type="text" value="" />
                </label>

                <div class="native-tool-actions native-field--full">
                    <button type="button" class="btn btn-primary" onclick="runTool()">执行</button>
                </div>
                <label class="native-field native-field--full">
                    <span>输出</span>
                    <textarea class="form-control native-textarea native-textarea--output" id="output" rows="10" readonly></textarea>
                </label>
            </div>
        </article>
    </div>
</section>

@section Scripts {
<script>

function $(id) { return document.getElementById(id); }
function setOutput(value) { const output = $('output'); if (output) output.value = value ?? ''; else if (output) output.textContent = value ?? ''; }
function showError(error) { setOutput(error?.message ?? String(error)); }
async function copyOutput() {
    const output = $('output');
    if (!output) return;
    try { await navigator.clipboard.writeText(output.value || output.textContent || ''); }
    catch { output.select?.(); document.execCommand('copy'); }
}
function escapeHtml(value) {
    return String(value ?? '').replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;').replaceAll("'", '&#39;');
}
function loadScript(src, globalName) {
    if (globalName && window[globalName]) return Promise.resolve(window[globalName]);
    return new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = src;
        script.async = true;
        script.onload = () => resolve(globalName ? window[globalName] : true);
        script.onerror = () => reject(new Error('资源加载失败：' + src));
        document.head.appendChild(script);
    });
}
const moduleCache = new Map();
function loadModule(src) {
    if (!moduleCache.has(src)) moduleCache.set(src, import(src));
    return moduleCache.get(src);
}

const bip39Wordlists = {
    english: 'english',
    chineseSimplified: 'simplified-chinese',
    chineseTraditional: 'traditional-chinese',
    french: 'french',
    italian: 'italian',
    spanish: 'spanish'
};
function hexToBytes(hex) {
    const value = hex.trim();
    if (!/^[0-9a-fA-F]+$/.test(value) || value.length % 2 !== 0) {
        throw new Error('Entropy 必须是偶数长度的十六进制字符串');
    }

    return Uint8Array.from(value.match(/.{2}/g).map(byte => Number.parseInt(byte, 16)));
}
async function loadWordlist(language) {
    const wordlist = bip39Wordlists[language] ?? bip39Wordlists.english;
    const module = await loadModule(`https://cdn.jsdelivr.net/npm/@@scure/bip39@@1.5.4/wordlists/${wordlist}/+esm`);
    return module.wordlist;
}
async function runTool() {
    try {
        setOutput('处理中...');
        const [bip39, wordlist] = await Promise.all([
            loadModule('https://cdn.jsdelivr.net/npm/@@scure/bip39@@1.5.4/+esm'),
            loadWordlist($('language').value)
        ]);
        const entropy = $('entropy').value.trim();
        const mnemonic = entropy
            ? bip39.entropyToMnemonic(hexToBytes(entropy), wordlist)
            : bip39.generateMnemonic(wordlist);
        setOutput((entropy ? `Entropy: ${entropy}\n\n` : '') + mnemonic);
    } catch (error) {
        showError(error);
    }
}
document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, textarea, select').forEach(el => {
        el.addEventListener('input', () => runTool?.());
        el.addEventListener('change', () => runTool?.());
    });
    runTool();
});
</script>
}
