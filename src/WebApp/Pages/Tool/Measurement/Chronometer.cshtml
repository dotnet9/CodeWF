@page "/tool/chronometer"
@{
    ViewData["Title"] = "计时器";
    ViewData["Description"] = "提供简单的开始、停止和重置计时功能。";
    ViewData["CanonicalPath"] = "/tool/chronometer";
    var banner = new WebApp.Models.PageBannerViewModel
    {
        Eyebrow = "计量工具",
        Title = "计时器",
        Description = "提供简单的开始、停止和重置计时功能。",
        MetaItems = ["Razor Pages", "原生工具", "chronometer"]
    };
}

<section class="page-shell">
    <div class="container">
        <partial name="_PageBanner" model="banner" />

        <div class="tool-detail-nav">
            <a class="inline-link" href="/tool">
                <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                返回工具箱
            </a>
        </div>

        <article class="surface-panel native-tool-host">
            <div class="native-tool-panel__head">
                <div>
                    <span class="card-kicker">Razor Pages 原生工具</span>
                    <h2 class="surface-title">计时器</h2>
                </div>
                <button type="button" class="btn btn-ghost btn-sm" onclick="copyOutput()">
                    <i class="fa-regular fa-copy" aria-hidden="true"></i> 复制结果
                </button>
            </div>
            <div class="native-stopwatch" id="display">00:00:00.000</div><div class="native-tool-actions"><button type="button" class="btn btn-primary" id="start">开始</button><button type="button" class="btn btn-ghost" id="stop">停止</button><button type="button" class="btn btn-ghost" id="reset">重置</button></div><textarea class="form-control native-textarea native-textarea--output" id="output" hidden></textarea>
        </article>
    </div>
</section>

@section Scripts {
<script>

function $(id) { return document.getElementById(id); }
function setOutput(value) { const output = $('output'); if (output) output.value = value ?? ''; else if (output) output.textContent = value ?? ''; }
function showError(error) { setOutput(error?.message ?? String(error)); }
async function copyOutput() {
    const output = $('output');
    if (!output) return;
    try { await navigator.clipboard.writeText(output.value || output.textContent || ''); }
    catch { output.select?.(); document.execCommand('copy'); }
}
function escapeHtml(value) {
    return String(value ?? '').replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;').replaceAll("'", '&#39;');
}
function loadScript(src, globalName) {
    if (globalName && window[globalName]) return Promise.resolve(window[globalName]);
    return new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = src;
        script.async = true;
        script.onload = () => resolve(globalName ? window[globalName] : true);
        script.onerror = () => reject(new Error('资源加载失败：' + src));
        document.head.appendChild(script);
    });
}
const moduleCache = new Map();
function loadModule(src) {
    if (!moduleCache.has(src)) moduleCache.set(src, import(src));
    return moduleCache.get(src);
}

let started=0, elapsed=0, timer=0; function fmt(ms){const h=Math.floor(ms/3600000),m=Math.floor(ms/60000)%60,s=Math.floor(ms/1000)%60,x=Math.floor(ms%1000);return String(h).padStart(2,'0')+':'+String(m).padStart(2,'0')+':'+String(s).padStart(2,'0')+'.'+String(x).padStart(3,'0');} function paint(){const ms=started?elapsed+performance.now()-started:elapsed; $('display').textContent=fmt(ms); setOutput($('display').textContent);} function start(){if(started)return; started=performance.now(); timer=setInterval(paint,32);} function stop(){if(!started)return; elapsed+=performance.now()-started; started=0; clearInterval(timer); paint();} function reset(){started=0; elapsed=0; clearInterval(timer); paint();} function runTool(){paint();}
document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, textarea, select').forEach(el => {
        el.addEventListener('input', () => runTool?.());
        el.addEventListener('change', () => runTool?.());
    });
    $('start').addEventListener('click',start); $('stop').addEventListener('click',stop); $('reset').addEventListener('click',reset); paint();
});
</script>
}
