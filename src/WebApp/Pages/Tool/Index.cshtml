@page "/tool"
@using WebApp.Extensions
@model WebApp.Pages.Tool.IndexModel
@{
    ViewData["Title"] = "工具";
    ViewData["Description"] = "查看码墙提供的在线开发工具，提升日常开发效率。";
    var banner = new WebApp.Models.PageBannerViewModel
    {
        Eyebrow = "Toolbox",
        Title = "在线工具",
        Description = "面向日常开发场景整理的小工具集合，优先覆盖高频、直接、可以马上派上用场的能力。",
        MetaItems = ["即开即用", "面向开发场景", "减少来回切换"]
    };
}

<section class="page-shell">
    <div class="container">
        <partial name="_PageBanner" model="banner" />

        @if (!Model.Tools.Any())
        {
            <div class="empty-state">
                <h2>工具列表暂未配置</h2>
                <p>后续可以在这里继续补充更多贴近开发流程的小工具。</p>
            </div>
        }
        else
        {
            <div class="post-grid">
                @foreach (var tool in Model.Tools)
                {
                    <article class="resource-card">
                        <div class="resource-card__body">
                            <span class="card-kicker">工具分组</span>
                            <h2 class="resource-card__title">@tool.Name</h2>
                            @if (!string.IsNullOrWhiteSpace(tool.Memo))
                            {
                                <p class="resource-card__desc">@tool.Memo</p>
                            }

                            @if (tool.Children != null && tool.Children.Any())
                            {
                                <div class="chip-cloud">
                                    @foreach (var child in tool.Children)
                                    {
                                        var toolLink = ConstantUtil.GetToolUrl(child.Slug);
                                        <a href="@toolLink" class="chip-link">@child.Name</a>
                                    }
                                </div>
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>
