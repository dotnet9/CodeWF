@page "/tool/camera-recorder"
@{
    ViewData["Title"] = "摄像头拍照工具";
    ViewData["Description"] = "调用浏览器摄像头进行预览，并可截取当前画面。";
    ViewData["CanonicalPath"] = "/tool/camera-recorder";
    var banner = new WebApp.Models.PageBannerViewModel
    {
        Eyebrow = "图像与视频",
        Title = "摄像头拍照工具",
        Description = "调用浏览器摄像头进行预览，并可截取当前画面。",
        MetaItems = ["Razor Pages", "原生工具", "camera-recorder"]
    };
}

<section class="page-shell">
    <div class="container">
        <partial name="_PageBanner" model="banner" />

        <div class="tool-detail-nav">
            <a class="inline-link" href="/tool">
                <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                返回工具箱
            </a>
        </div>

        <article class="surface-panel native-tool-host">
            <div class="native-tool-panel__head">
                <div>
                    <span class="card-kicker">Razor Pages 原生工具</span>
                    <h2 class="surface-title">摄像头拍照工具</h2>
                </div>
                <button type="button" class="btn btn-ghost btn-sm" onclick="copyOutput()">
                    <i class="fa-regular fa-copy" aria-hidden="true"></i> 复制结果
                </button>
            </div>
            <div class="native-tool-actions"><button type="button" class="btn btn-primary" id="start">开启摄像头</button><button type="button" class="btn btn-ghost" id="snap">拍照</button><button type="button" class="btn btn-ghost" id="stop">停止</button></div><video class="native-video" id="video" autoplay playsinline></video><canvas class="native-video" id="canvas" hidden></canvas><label class="native-field native-field--full"><span>图片 Data URL</span><textarea class="form-control native-textarea native-textarea--output" id="output" rows="5" readonly></textarea></label>
        </article>
    </div>
</section>

@section Scripts {
<script>

function $(id) { return document.getElementById(id); }
function setOutput(value) { const output = $('output'); if (output) output.value = value ?? ''; else if (output) output.textContent = value ?? ''; }
function showError(error) { setOutput(error?.message ?? String(error)); }
async function copyOutput() {
    const output = $('output');
    if (!output) return;
    try { await navigator.clipboard.writeText(output.value || output.textContent || ''); }
    catch { output.select?.(); document.execCommand('copy'); }
}
function escapeHtml(value) {
    return String(value ?? '').replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;').replaceAll("'", '&#39;');
}
function loadScript(src, globalName) {
    if (globalName && window[globalName]) return Promise.resolve(window[globalName]);
    return new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = src;
        script.async = true;
        script.onload = () => resolve(globalName ? window[globalName] : true);
        script.onerror = () => reject(new Error('资源加载失败：' + src));
        document.head.appendChild(script);
    });
}
const moduleCache = new Map();
function loadModule(src) {
    if (!moduleCache.has(src)) moduleCache.set(src, import(src));
    return moduleCache.get(src);
}

let stream=null; async function startCamera(){ stream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false }); $('video').srcObject = stream; } function stopCamera(){ stream?.getTracks().forEach(t=>t.stop()); stream=null; } function snap(){ const canvas=$('canvas'), video=$('video'); canvas.hidden=false; canvas.width=video.videoWidth||1280; canvas.height=video.videoHeight||720; canvas.getContext('2d').drawImage(video,0,0,canvas.width,canvas.height); setOutput(canvas.toDataURL('image/png')); } function runTool(){}
document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input, textarea, select').forEach(el => {
        el.addEventListener('input', () => runTool?.());
        el.addEventListener('change', () => runTool?.());
    });
    $('start').addEventListener('click',()=>startCamera().catch(showError)); $('stop').addEventListener('click',stopCamera); $('snap').addEventListener('click',snap);
});
</script>
}
