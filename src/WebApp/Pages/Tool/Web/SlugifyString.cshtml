@page "/SlugifyString"
@model WebApp.Pages.Tool.Web.SlugifyStringModel
@{
    ViewData["Title"] = "标题转 URL 别名";
    var banner = new WebApp.Models.PageBannerViewModel
    {
        Eyebrow = "Tool",
        Title = "标题转 URL 别名",
        Description = "将中文标题翻译为英文，再转换为适合文章链接、路由和 SEO 的 slug 格式。",
        MetaItems = ["URL alias", "文章别名", "SEO 友好"]
    };
}

<section class="page-shell">
    <div class="container">
        <partial name="_PageBanner" model="banner" />

        <div class="content-grid">
            <div class="content-primary">
                <div class="surface-panel">
                    <form method="post" class="tool-form-stack">
                        <div class="mb-3">
                            <label class="form-label" for="inputString">输入标题</label>
                            <textarea class="form-control" id="inputString" name="InputString" rows="4" placeholder="例如：Slug 转换工具">@Model.InputString</textarea>
                        </div>
                        <button type="submit" class="btn btn-primary">转换</button>
                    </form>

                    @if (!string.IsNullOrEmpty(Model.TranslatedResult))
                    {
                        <div class="tool-result-grid">
                            <div class="tool-result-card">
                                <span class="card-kicker">Translation</span>
                                <h2 class="surface-title">英文翻译</h2>
                                <code class="tool-code-block">@Model.TranslatedResult</code>
                            </div>
                            <div class="tool-result-card">
                                <span class="card-kicker">Slug</span>
                                <h2 class="surface-title">URL 别名</h2>
                                <div class="tool-copy-row">
                                    <code class="tool-code-block">@Model.SlugResult</code>
                                    <button class="btn btn-ghost btn-sm" type="button" onclick="copyToClipboard('@Model.SlugResult')">复制</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <aside class="content-sidebar">
                <div class="surface-panel sidebar-panel sticky-panel">
                    <h2 class="sidebar-title">使用说明</h2>
                    <div class="sidebar-link-list tool-note-list">
                        <div class="sidebar-link sidebar-link--static"><span>输入中文标题后点击转换</span></div>
                        <div class="sidebar-link sidebar-link--static"><span>系统会先翻译，再生成 slug</span></div>
                        <div class="sidebar-link sidebar-link--static"><span>适合文章链接、路由和页面别名</span></div>
                        <div class="sidebar-link sidebar-link--static"><span>当前使用 MyMemory 免费翻译 API</span></div>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</section>

@section Scripts {
<script>
    function copyToClipboard(text) {
        navigator.clipboard.writeText(text).then(function() {
            alert("已复制到剪贴板");
        }, function(err) {
            console.error("复制失败:", err);
        });
    }
</script>
}
