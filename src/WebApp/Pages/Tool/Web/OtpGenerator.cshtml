@page "/tool/otp-generator"
@{
    ViewData["Title"] = "OTP 动态验证码生成器";
    ViewData["Description"] = "基于 Base32 密钥生成 TOTP 动态验证码，并显示剩余有效时间。";
    ViewData["CanonicalPath"] = "/tool/otp-generator";
    var banner = new WebApp.Models.PageBannerViewModel
    {
        Eyebrow = "网页工具",
        Title = "OTP 动态验证码生成器",
        Description = "基于 Base32 密钥生成 TOTP 动态验证码，并显示剩余有效时间。",
        MetaItems = ["Razor Pages", "原生工具", "otp-generator"]
    };
}

<section class="page-shell">
    <div class="container">
        <partial name="_PageBanner" model="banner" />

        <div class="tool-detail-nav">
            <a class="inline-link" href="/tool">
                <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                返回工具箱
            </a>
        </div>

        <article class="surface-panel native-tool-host">
            <div class="native-tool-panel__head">
                <div>
                    <span class="card-kicker">Razor Pages 原生工具</span>
                    <h2 class="surface-title">OTP 动态验证码生成器</h2>
                </div>
                <button type="button" class="btn btn-ghost btn-sm" onclick="copyOutput()">
                    <i class="fa-regular fa-copy" aria-hidden="true"></i> 复制结果
                </button>
            </div>
            <div class="native-tool-grid">
                <label class="native-field">
                    <span>Base32 密钥</span>
                    <input class="form-control" id="secret" type="text" value="JBSWY3DPEHPK3PXP" />
                </label>
                <label class="native-field">
                    <span>账号</span>
                    <input class="form-control" id="account" type="text" value="demo-user" />
                </label>
                <label class="native-field">
                    <span>周期秒</span>
                    <input class="form-control" id="period" type="number" min="10" max="120" value="30" />
                </label>
                <label class="native-field">
                    <span>位数</span>
                    <input class="form-control" id="digits" type="number" min="6" max="8" value="6" />
                </label>
                <div class="native-tool-actions native-field--full">
                    <button type="button" class="btn btn-primary" onclick="runTool()">生成</button>
                    <button type="button" class="btn btn-ghost" onclick="generateSecret()">随机密钥</button>
                </div>
                <label class="native-field native-field--full">
                    <span>输出</span>
                    <textarea class="form-control native-textarea native-textarea--output" id="output" rows="8" readonly></textarea>
                </label>
            </div>
        </article>
    </div>
</section>

@section Scripts {
<script>

function $(id) { return document.getElementById(id); }
function setOutput(value) { const output = $('output'); if (output) output.value = value ?? ''; }
function showError(error) { setOutput(error?.message ?? String(error)); }
async function copyOutput() {
    const output = $('output');
    if (!output) return;
    try { await navigator.clipboard.writeText(output.value || output.textContent || ''); }
    catch { output.select?.(); document.execCommand('copy'); }
}
function base32ToBytes(base32) {
    const alphabet = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';
    const bits = String(base32 ?? '').toUpperCase().replace(/=+$/g, '').replace(/\s+/g, '').split('').map(char => {
        const index = alphabet.indexOf(char);
        if (index < 0) throw new Error('Base32 密钥包含非法字符。');
        return index.toString(2).padStart(5, '0');
    }).join('');
    const bytes = [];
    for (let i = 0; i + 8 <= bits.length; i += 8) bytes.push(parseInt(bits.slice(i, i + 8), 2));
    return new Uint8Array(bytes);
}
async function hmacSha1(keyBytes, messageBytes) {
    const key = await crypto.subtle.importKey('raw', keyBytes, { name: 'HMAC', hash: 'SHA-1' }, false, ['sign']);
    return new Uint8Array(await crypto.subtle.sign('HMAC', key, messageBytes));
}
async function totp(secret, period, digits) {
    const counter = Math.floor(Date.now() / 1000 / period);
    const message = new ArrayBuffer(8);
    new DataView(message).setUint32(4, counter);
    const digest = await hmacSha1(base32ToBytes(secret), new Uint8Array(message));
    const offset = digest[digest.length - 1] & 0xf;
    const code = ((digest[offset] & 0x7f) << 24) | ((digest[offset + 1] & 0xff) << 16) | ((digest[offset + 2] & 0xff) << 8) | (digest[offset + 3] & 0xff);
    return String(code % (10 ** digits)).padStart(digits, '0');
}
function generateSecret() {
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ234567';
    const bytes = new Uint8Array(16);
    crypto.getRandomValues(bytes);
    $('secret').value = [...bytes].map(byte => chars[byte % chars.length]).join('');
    runTool();
}
async function runTool() {
    try {
        const period = Number($('period').value);
        const digits = Number($('digits').value);
        const code = await totp($('secret').value, period, digits);
        const remain = period - (Math.floor(Date.now() / 1000) % period);
        const uri = 'otpauth://totp/CodeWF:' + encodeURIComponent($('account').value) + '?secret=' + encodeURIComponent($('secret').value) + '&issuer=CodeWF&digits=' + digits + '&period=' + period;
        setOutput(['验证码：' + code, '剩余秒数：' + remain, 'URI：' + uri].join('\n'));
    } catch (error) { showError(error); }
}
document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('input').forEach(el => {
        el.addEventListener('input', runTool);
        el.addEventListener('change', runTool);
    });
    runTool();
    window.setInterval(runTool, 1000);
});
</script>
}
