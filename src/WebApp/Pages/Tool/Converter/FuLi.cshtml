@page "/FuLi"

<div style="max-width: 1200px; margin: 20px auto; padding: 20px;">
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="card-title mb-3">复利计算</h5>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">复利方式</label>
                    <select class="form-select" id="compoundType" onchange="calculate()">
                        <option value="year">按年复利</option>
                        <option value="month">按月复利</option>
                        <option value="day">按日复利</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">利率类型</label>
                    <select class="form-select" id="rateType" onchange="updateRatePlaceholder()">
                        <option value="annual">年利率</option>
                        <option value="monthly">月利率</option>
                        <option value="daily">日利率</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">利率值（%）</label>
                    <input type="number" class="form-control" id="rateValue" step="0.1" value="3" oninput="calculate()" placeholder="可输入负数">
                </div>

                <div class="col-md-6">
                    <label class="form-label">本金（元）</label>
                    <input type="number" class="form-control" id="principal" min="0" step="100" value="10000" oninput="calculate()">
                </div>

                <div class="col-md-6">
                    <label class="form-label">存入期限类型</label>
                    <select class="form-select" id="durationType" onchange="calculate()">
                        <option value="year">年</option>
                        <option value="month">月</option>
                        <option value="day">日</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label class="form-label">存入期限数</label>
                    <input type="number" class="form-control" id="durationValue" min="1" value="1" oninput="calculate()">
                </div>

                <div class="col-12 text-center mt-3">
                    <button class="btn btn-primary px-4" onclick="calculate()">
                        <i class="bi bi-calculator me-2"></i>立即计算
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div id="quickResult" style="margin-top: 10px;"></div>

    <div class="mt-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-3">
                <canvas id="resultChart" style="height: 500px;"></canvas>
            </div>
        </div>
        <div class="text-center mt-3">
            <button class="btn btn-info" onclick="toggleTable()">显示计算明细</button>
        </div>
        <div id="resultTableContainer" style="display: none;">
            <div class="card shadow-sm mt-3">
                <div class="card-body">
                    <div style="height: 500px; overflow-y: auto; background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                        <table class="table table-hover align-middle">
                            <thead class="sticky-top bg-white">
                                <tr>
                                    <th>期数</th>
                                    <th>本息合计</th>
                                    <th>累计利息</th>
                                </tr>
                            </thead>
                            <tbody id="resultTable" class="font-monospace"></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4 mt-4">
        <div class="card-body">
            <h5 class="card-title">复利知识科普</h5>
            <p class="card-text">复利计算器采用利滚利的计算方式，将前一期利息计入下一期本金一并计算，实现利上有利。与单利（仅对本金计息）不同，复利借助时间放大收益，利息持续加入本金再投资，时间越久，财富增长越显著，呈现出"滚雪球"效应。</p>
            <p class="card-text">使用本复利计算器，您可以计算复利终值和复利现值，计算收益或反算本金。计算器支持按年、月、日多种复利方式计算，并提供计算明细查看功能。</p>
            <div class="bg-light p-3 rounded">
                <h6 class="mb-3">复利计算公式</h6>
                <p>A = P(1 + r)^n</p>
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>(A)</strong>：未来值（本金与利息之和）</p>
                        <p><strong>(P)</strong>：本金</p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>(r)</strong>：每期利率</p>
                        <p><strong>(n)</strong>：复利的期数</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.bootcdn.net/ajax/libs/Chart.js/3.7.1/chart.min.js"></script>
<script>
    let myChart = null;

    function toggleTable() {
        const tableContainer = document.getElementById('resultTableContainer');
        const button = event.target;
        if (tableContainer.style.display === 'none') {
            tableContainer.style.display = 'block';
            button.textContent = '隐藏计算明细';
        } else {
            tableContainer.style.display = 'none';
            button.textContent = '显示计算明细';
        }
    }

    function updateTable(results) {
        const tableBody = document.getElementById('resultTable');
        tableBody.innerHTML = results.map((item) =>
            `<tr>
                <td>第${item.period}期</td>
                <td>¥${item.total.toFixed(2)}</td>
                <td>¥${item.interest.toFixed(2)}</td>
            </tr>`
        ).join('');
    }

    function initChart(results) {
        const ctx = document.getElementById('resultChart').getContext('2d');

        if (myChart) {
            myChart.destroy();
        }

        myChart = new Chart(ctx, {
            type: 'line',
            data: {
                labels: results.map(r => `第${r.period}期`),
                datasets: [{
                    label: '本息合计',
                    data: results.map(r => r.total),
                    borderColor: 'rgb(75, 192, 192)',
                    tension: 0.1
                }, {
                    label: '累计利息',
                    data: results.map(r => r.interest),
                    borderColor: 'rgb(255, 99, 132)',
                    tension: 0.1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false
            }
        });
    }

    function updateRatePlaceholder() {
        const rateType = document.getElementById('rateType').value;
        const label = document.querySelector("label[for='rateValue']");

        if (rateType === 'monthly') label.innerHTML = '月利率（%）';
        else if (rateType === 'daily') label.innerHTML = '日利率（%）';
        else label.innerHTML = '年利率（%）';
    }

    function calculate() {
        const principal = parseFloat(document.getElementById('principal').value);
        const rateValue = parseFloat(document.getElementById('rateValue').value);
        const durationValue = parseFloat(document.getElementById('durationValue').value);
        const rateType = document.getElementById('rateType').value;
        const durationType = document.getElementById('durationType').value;
        const compoundType = document.getElementById('compoundType').value;

        if (isNaN(principal) || principal <= 0 || isNaN(rateValue) || isNaN(durationValue) || durationValue <= 0) {
            return;
        }

        let annualRate = rateValue;
        if (rateType === 'monthly') annualRate = rateValue * 12;
        if (rateType === 'daily') annualRate = rateValue * 365;

        let totalYears = durationValue;
        if (durationType === 'month') totalYears = durationValue / 12;
        if (durationType === 'day') totalYears = durationValue / 365;

        let periods = totalYears;
        if (compoundType === 'month') periods = totalYears * 12;
        if (compoundType === 'day') periods = totalYears * 365;
        periods = Math.round(periods);

        const ratePerPeriod = annualRate / 100 / (compoundType === 'year' ? 1 : compoundType === 'month' ? 12 : 365);

        const results = [];
        let current = principal;
        let totalInterest = 0;

        for (let i = 0; i < periods; i++) {
            const interest = current * ratePerPeriod;
            totalInterest += interest;
            current += interest;

            results.push({
                period: i + 1,
                principal: principal,
                interest: Number(totalInterest.toFixed(2)),
                total: Number(current.toFixed(2))
            });
        }

        updateTable(results);
        initChart(results);

        if (results.length > 0) {
            const lastResult = results[results.length - 1];
            document.getElementById('quickResult').innerHTML = `
                <div class="alert alert-success">
                    最终本息：¥${lastResult.total.toFixed(2)}<br>
                    总利息：¥${lastResult.interest.toFixed(2)}
                </div>
            `;
        }
    }

    calculate();
</script>
}
