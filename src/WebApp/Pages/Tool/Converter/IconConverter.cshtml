@page "/Tool/Icon"

<style>
.fluent-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 24px;
    font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, sans-serif;
    color: #323130;
    width: 100%;
    box-sizing: border-box;
}

.fluent-header {
    margin-bottom: 24px;
}

.fluent-title {
    font-size: 28px;
    font-weight: 600;
    margin: 0 0 8px 0;
    color: #0078d4;
}

.fluent-subtitle {
    font-size: 16px;
    margin: 0;
    color: #605e5c;
}

.fluent-content {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 24px;
    width: 100%;
}

.fluent-card {
    background: white;
    border-radius: 4px;
    box-shadow: 0 1.6px 3.6px 0 rgba(0,0,0,0.132), 0 0.3px 0.9px 0 rgba(0,0,0,0.108);
    margin-bottom: 24px;
    width: 100%;
}

.fluent-card-header {
    padding: 16px 20px;
    border-bottom: 1px solid #edebe9;
}

.fluent-card-header h3 {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
}

.fluent-card-content {
    padding: 20px;
}

.fluent-form-group {
    margin-bottom: 24px;
}

.fluent-label {
    display: block;
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 8px;
}

.fluent-file-input {
    position: relative;
    display: flex;
    align-items: center;
    border: 1px solid #8a8886;
    border-radius: 2px;
    height: 36px;
    width: 100%;
}

.fluent-file-input input[type="file"] {
    position: absolute;
    width: 100%;
    height: 100%;
    opacity: 0;
    cursor: pointer;
    z-index: 2;
}

.fluent-file-button {
    background-color: #f3f2f1;
    padding: 0 16px;
    height: 100%;
    display: flex;
    align-items: center;
    border-right: 1px solid #8a8886;
    font-size: 14px;
}

.fluent-file-name {
    padding: 0 12px;
    font-size: 14px;
    color: #605e5c;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex: 1;
}

.fluent-hint {
    font-size: 12px;
    color: #605e5c;
    margin-top: 4px;
}

.fluent-checkbox-group {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(90px, 1fr));
    gap: 12px;
    width: 100%;
}

.fluent-checkbox {
    display: flex;
    align-items: center;
}

.fluent-checkbox input[type="checkbox"] {
    width: 20px;
    height: 20px;
    margin-right: 8px;
    cursor: pointer;
}

.fluent-checkbox label {
    font-size: 14px;
    cursor: pointer;
}

.fluent-actions {
    display: flex;
    gap: 12px;
    margin-bottom: 24px;
    flex-wrap: wrap;
}

.fluent-button {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 16px;
    height: 36px;
    border-radius: 2px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    border: none;
    text-decoration: none;
}

.fluent-primary {
    background-color: #0078d4;
    color: white;
}

.fluent-secondary {
    background-color: #f3f2f1;
    color: #323130;
    border: 1px solid #8a8886;
}

.fluent-success {
    background-color: #107c10;
    color: white;
}

.fluent-icon {
    width: 18px;
    height: 18px;
    margin-right: 8px;
    fill: currentColor;
}

.fluent-result {
    display: none;
}

.fluent-success-message,
.fluent-warning-message {
    display: flex;
    align-items: flex-start;
    padding: 12px 16px;
    border-radius: 2px;
    margin-bottom: 16px;
}

.fluent-list {
    padding-left: 20px;
    margin: 0 0 20px 0;
}

.fluent-list li {
    margin-bottom: 8px;
    line-height: 1.5;
}

.fluent-code-block {
    background-color: #f3f2f1;
    border-radius: 2px;
    overflow: hidden;
    width: 100%;
}

.fluent-code-title {
    background-color: #edebe9;
    padding: 8px 12px;
    font-size: 13px;
    font-weight: 600;
}

.fluent-code-block pre {
    margin: 0;
    padding: 12px;
    overflow-x: auto;
}

.fluent-code-block code {
    font-family: 'Cascadia Code', Consolas, monospace;
    font-size: 13px;
    color: #323130;
}

*, *::before, *::after {
    box-sizing: border-box;
}

@@media (max-width: 768px) {
    .fluent-content {
        grid-template-columns: 1fr;
    }
    .fluent-container {
        padding: 16px;
    }
    .fluent-actions {
        flex-direction: column;
    }
    .fluent-button {
        width: 100%;
    }
}
</style>

<div class="fluent-container">
    <div class="fluent-header">
        <h2 class="fluent-title">ICO 图标转换工具</h2>
        <p class="fluent-subtitle">将您的图片转换为多尺寸的 ICO 图标文件</p>
    </div>

    <div class="fluent-content">
        <div class="fluent-main">
            <div class="fluent-card">
                <div class="fluent-card-content">
                    <div class="fluent-form-group">
                        <label class="fluent-label">选择源图片文件</label>
                        <div class="fluent-file-input">
                            <input type="file" id="fileInput" accept=".png,.jpg,.jpeg,.webp" />
                            <span class="fluent-file-button">浏览文件</span>
                            <span class="fluent-file-name">未选择文件</span>
                        </div>
                        <div class="fluent-hint">支持的格式: PNG、JPG、JPEG、WEBP</div>
                    </div>

                    <div class="fluent-form-group">
                        <label class="fluent-label">选择图标尺寸</label>
                        <div class="fluent-checkbox-group">
                            <div class="fluent-checkbox">
                                <input type="checkbox" id="size16" value="16" checked>
                                <label for="size16">16x16</label>
                            </div>
                            <div class="fluent-checkbox">
                                <input type="checkbox" id="size32" value="32" checked>
                                <label for="size32">32x32</label>
                            </div>
                            <div class="fluent-checkbox">
                                <input type="checkbox" id="size48" value="48">
                                <label for="size48">48x48</label>
                            </div>
                            <div class="fluent-checkbox">
                                <input type="checkbox" id="size64" value="64">
                                <label for="size64">64x64</label>
                            </div>
                            <div class="fluent-checkbox">
                                <input type="checkbox" id="size128" value="128">
                                <label for="size128">128x128</label>
                            </div>
                            <div class="fluent-checkbox">
                                <input type="checkbox" id="size256" value="256">
                                <label for="size256">256x256</label>
                            </div>
                        </div>
                    </div>

                    <div class="fluent-actions">
                        <button id="mergeButton" class="fluent-button fluent-primary">
                            <svg class="fluent-icon" viewBox="0 0 24 24">
                                <path d="M4 21h16v-2H4v2zm0-4h16v-2H4v2zm0-4h16v-2H4v2zm0-4h16V7H4v2zm0-6v2h16V3H4z"/>
                            </svg>
                            合并生成ICO
                        </button>
                        <button id="separateButton" class="fluent-button fluent-secondary">
                            <svg class="fluent-icon" viewBox="0 0 24 24">
                                <path d="M3 3v6h6V3H3zm8 0v6h6V3h-6zm-8 8v6h6v-6H3zm8 0v6h6v-6h-6z"/>
                            </svg>
                            分别生成ICO
                        </button>
                    </div>

                    <div id="result" class="fluent-result">
                        <div class="fluent-success-message" style="background-color: #dff6dd; color: #107c10;">
                            <svg class="fluent-icon" viewBox="0 0 24 24">
                                <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/>
                            </svg>
                            <span>转换成功! 请点击下方按钮下载文件。</span>
                        </div>
                        <a id="downloadLink" class="fluent-button fluent-success" target="_blank">
                            <svg class="fluent-icon" viewBox="0 0 24 24">
                                <path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/>
                            </svg>
                            下载文件
                        </a>
                        <div class="fluent-warning-message" style="background-color: #fff4ce; color: #797600;">
                            <svg class="fluent-icon" viewBox="0 0 24 24">
                                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z"/>
                            </svg>
                            <span>请注意：生成的文件仅保留2分钟，请及时下载。</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="fluent-sidebar">
            <div class="fluent-card">
                <div class="fluent-card-header">
                    <h3>使用说明</h3>
                </div>
                <div class="fluent-card-content">
                    <ol class="fluent-list">
                        <li>选择一个图片文件作为源文件</li>
                        <li>选择需要的图标尺寸（建议至少包含16x16和32x32）</li>
                        <li>点击"合并生成ICO"将所有尺寸合并到一个ICO文件中</li>
                        <li>或点击"分别生成ICO"获取每个尺寸的单独文件</li>
                    </ol>
                    <div class="fluent-code-block">
                        <div class="fluent-code-title">网站图标引用代码</div>
                        <pre><code>&lt;link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" /&gt;</code></pre>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(document).ready(function () {
        $('#fileInput').on('change', function() {
            var fileName = $(this).val().split('\\').pop();
            if (fileName) {
                $('.fluent-file-name').text(fileName);
            } else {
                $('.fluent-file-name').text('未选择文件');
            }
        });

        function validateInput() {
            const $fileInput = $('#fileInput');
            if (!$fileInput[0].files || !$fileInput[0].files.length) {
                alert('请选择图片文件');
                return false;
            }

            const sizes = $('input[type="checkbox"]:checked')
                .map(function () { return $(this).val(); })
                .get();

            if (sizes.length === 0) {
                alert('请至少选择一个图标尺寸');
                return false;
            }

            return {
                file: $fileInput[0].files[0],
                sizes: sizes
            };
        }

        async function convertIcon(isMerge) {
            const validation = validateInput();
            if (!validation) return;

            const $button = isMerge ? $('#mergeButton') : $('#separateButton');
            const $result = $('.fluent-result');
            const $downloadLink = $('#downloadLink');

            const originalHtml = $button.html();
            $button.prop('disabled', true)
                .html(`<div class="spinner" style="width: 16px; height: 16px; margin-right: 8px; border: 2px solid rgba(255,255,255,0.3); border-radius: 50%; border-top-color: #fff; animation: spin 0.8s linear infinite;"></div><span>生成中...</span>`);

            try {
                const formData = new FormData();
                formData.append('sourceImage', validation.file);
                formData.append('sizes', validation.sizes.join(','));

                const response = await $.ajax({
                    url: `/api/Image/${isMerge ? 'merge' : 'separate'}`,
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false
                });

                if (response.success) {
                    $downloadLink
                        .attr('href', response.url)
                        .html(`<svg class="fluent-icon" viewBox="0 0 24 24">
                                <path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z"/>
                              </svg> 下载${isMerge ? 'ICO文件' : 'ZIP压缩包'}`);
                    $result.fadeIn(300);
                } else {
                    alert('生成失败：' + response.message);
                }
            } catch (error) {
                console.error('错误:', error);
                alert('生成过程出错，请稍后重试');
            } finally {
                $button.prop('disabled', false).html(originalHtml);
            }
        }

        $('#mergeButton').click(() => convertIcon(true));
        $('#separateButton').click(() => convertIcon(false));
    });

    $('<style>').text('\x40keyframes spin { to { transform: rotate(360deg); } }').appendTo('head');
</script>
}
