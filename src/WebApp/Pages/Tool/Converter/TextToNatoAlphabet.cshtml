@page "/tool/text-to-nato-alphabet"
@{
    ViewData["Title"] = "文本转北约音标字母";
    ViewData["Description"] = "把文本转换为北约音标字母表，适合口头拼读和信息确认。";
    ViewData["CanonicalPath"] = "/tool/text-to-nato-alphabet";
    var banner = new WebApp.Models.PageBannerViewModel
    {
        Eyebrow = "转换器",
        Title = "文本转北约音标字母",
        Description = "把文本转换为北约音标字母表，适合口头拼读和信息确认。",
        MetaItems = ["Razor Pages", "原生工具", "text-to-nato-alphabet"]
    };
}

<section class="page-shell">
    <div class="container">
        <partial name="_PageBanner" model="banner" />

        <div class="tool-detail-nav">
            <a class="inline-link" href="/tool">
                <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
                返回工具箱
            </a>
        </div>

        <article class="surface-panel native-tool-host">
            <div class="native-tool-panel__head">
                <div>
                    <span class="card-kicker">Razor Pages 原生工具</span>
                    <h2 class="surface-title">文本转北约音标字母</h2>
                </div>
                <button type="button" class="btn btn-ghost btn-sm" onclick="copyOutput()">
                    <i class="fa-regular fa-copy" aria-hidden="true"></i> 复制结果
                </button>
            </div>
            <div class="native-tool-grid">

                <label class="native-field native-field--full">
                    <span>输入</span>
                    <textarea class="form-control native-textarea" id="input" rows="8">CodeWF</textarea>
                </label>
                <div class="native-tool-actions native-field--full">
                    <button type="button" class="btn btn-primary" onclick="runTool()">执行</button>
                    <button type="button" class="btn btn-ghost" onclick="clearTool()">清空</button>
                </div>
                <label class="native-field native-field--full">
                    <span>输出</span>
                    <textarea class="form-control native-textarea native-textarea--output" id="output" rows="8" readonly></textarea>
                </label>
            </div>
        </article>
    </div>
</section>

@section Scripts {
<script>

function $(id) { return document.getElementById(id); }
function setOutput(value) { const output = $('output'); if (output) output.value = value ?? ''; }
function showError(error) { setOutput(error?.message ?? String(error)); }
async function copyOutput() {
    const output = $('output');
    if (!output) return;
    try { await navigator.clipboard.writeText(output.value || output.textContent || ''); }
    catch { output.select?.(); document.execCommand('copy'); }
}
function escapeHtml(value) {
    return String(value ?? '').replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;').replaceAll("'", '&#39;');
}
function loadScript(src, globalName) {
    if (globalName && window[globalName]) return Promise.resolve(window[globalName]);
    return new Promise((resolve, reject) => {
        const script = document.createElement('script');
        script.src = src;
        script.async = true;
        script.onload = () => resolve(globalName ? window[globalName] : true);
        script.onerror = () => reject(new Error('资源加载失败：' + src));
        document.head.appendChild(script);
    });
}

async function transform(value, mode) {

    const nato = { a:'Alfa', b:'Bravo', c:'Charlie', d:'Delta', e:'Echo', f:'Foxtrot', g:'Golf', h:'Hotel', i:'India', j:'Juliett', k:'Kilo', l:'Lima', m:'Mike', n:'November', o:'Oscar', p:'Papa', q:'Quebec', r:'Romeo', s:'Sierra', t:'Tango', u:'Uniform', v:'Victor', w:'Whiskey', x:'X-ray', y:'Yankee', z:'Zulu' };
    return [...value].map(ch => nato[ch.toLowerCase()] ?? ch).join(' ');
}
async function runTool() {
    try { setOutput('处理中...'); setOutput(await transform($('input').value, $('mode')?.value ?? 'default')); }
    catch (error) { showError(error); }
}
function clearTool() { $('input').value = ''; setOutput(''); $('input').focus(); }
document.addEventListener('DOMContentLoaded', () => {
    $('input').addEventListener('input', () => { runTool(); });
    $('mode')?.addEventListener('change', runTool);
    runTool();
});
</script>
}
