@page "/Timestamp"
@{
    ViewData["Title"] = "时间戳转换工具";
    var banner = new WebApp.Models.PageBannerViewModel
    {
        Eyebrow = "Tool",
        Title = "时间戳转换工具",
        Description = "在时间戳和常见日期格式之间快速互转，支持秒、毫秒与带毫秒的显示格式。",
        MetaItems = ["Timestamp", "Date format", "秒与毫秒"]
    };
}

<section class="page-shell">
    <div class="container">
        <partial name="_PageBanner" model="banner" />

        <div class="tool-highlight-bar">
            <span class="tool-highlight-bar__label">当前时间戳</span>
            <strong id="currentTimestamp"></strong>
            <div class="tool-highlight-bar__actions">
                <button class="btn btn-primary btn-sm" onclick="startRefreshing()">开始刷新</button>
                <button class="btn btn-ghost btn-sm" onclick="stopRefreshing()">停止刷新</button>
                <button class="btn btn-ghost btn-sm" onclick="refreshTimestamp()">立即刷新</button>
            </div>
        </div>

        <div class="post-grid">
            <article class="surface-panel">
                <span class="card-kicker">Timestamp to Date</span>
                <h2 class="surface-title">时间戳转日期</h2>
                <div class="tool-form-grid">
                    <div>
                        <label class="form-label" for="inputTimestamp">时间戳</label>
                        <input type="text" class="form-control" id="inputTimestamp" placeholder="输入时间戳" />
                    </div>
                    <div>
                        <label class="form-label" for="timestampUnit">单位</label>
                        <select class="form-select" id="timestampUnit">
                            <option value="s">秒</option>
                            <option value="ms">毫秒</option>
                        </select>
                    </div>
                    <div>
                        <label class="form-label" for="dateFormat">输出格式</label>
                        <select class="form-select" id="dateFormat">
                            <option value="yyyy-MM-dd HH:mm:ss">yyyy-MM-dd HH:mm:ss</option>
                            <option value="yyyy-MM-dd HH:mm:ss.fff" selected>yyyy-MM-dd HH:mm:ss.fff</option>
                        </select>
                    </div>
                </div>
                <div class="tool-action-row">
                    <button class="btn btn-primary" onclick="convertTimestampToDate()">转换为日期</button>
                </div>
                <div class="mt-3">
                    <label class="form-label" for="outputDate">日期结果</label>
                    <input type="text" class="form-control" id="outputDate" readonly placeholder="转换结果" />
                </div>
            </article>

            <article class="surface-panel">
                <span class="card-kicker">Date to Timestamp</span>
                <h2 class="surface-title">日期转时间戳</h2>
                <div class="tool-form-grid">
                    <div>
                        <label class="form-label" for="inputDate">日期时间</label>
                        <input type="text" class="form-control" id="inputDate" placeholder="yyyy-MM-dd HH:mm:ss.fff" />
                    </div>
                    <div>
                        <label class="form-label" for="outputUnit">输出单位</label>
                        <select class="form-select" id="outputUnit">
                            <option value="s">秒</option>
                            <option value="ms">毫秒</option>
                        </select>
                    </div>
                </div>
                <div class="tool-action-row">
                    <button class="btn btn-primary" onclick="convertDateToTimestamp()">转换为时间戳</button>
                </div>
                <div class="mt-3">
                    <label class="form-label" for="outputTimestamp">时间戳结果</label>
                    <input type="text" class="form-control" id="outputTimestamp" readonly placeholder="转换结果" />
                </div>
                <p class="sidebar-copy mt-3">提示：支持手动输入，例如 `2024-01-01 12:30:45.123`。</p>
            </article>
        </div>
    </div>
</section>

@section Scripts {
<script>
    let timer = null;

    function refreshTimestamp() {
        const now = Date.now();
        document.getElementById("currentTimestamp").textContent = Math.floor(now / 1000);
    }

    function startRefreshing() {
        stopRefreshing();
        refreshTimestamp();
        timer = setInterval(refreshTimestamp, 1000);
    }

    function stopRefreshing() {
        if (timer) {
            clearInterval(timer);
            timer = null;
        }
    }

    function convertTimestampToDate() {
        const timestamp = document.getElementById("inputTimestamp").value;
        const unit = document.getElementById("timestampUnit").value;
        const format = document.getElementById("dateFormat").value;
        const outputElement = document.getElementById("outputDate");

        if (!timestamp || isNaN(timestamp)) {
            outputElement.value = "无效的时间戳";
            return;
        }

        try {
            const timestampNum = parseInt(timestamp, 10);
            const date = new Date(unit === "ms" ? timestampNum : timestampNum * 1000);

            if (isNaN(date.getTime())) {
                outputElement.value = "无效的时间戳";
                return;
            }

            outputElement.value = formatDate(date, format);
        } catch {
            outputElement.value = "转换失败";
        }
    }

    function convertDateToTimestamp() {
        const dateStr = document.getElementById("inputDate").value.trim();
        const unit = document.getElementById("outputUnit").value;
        const outputElement = document.getElementById("outputTimestamp");

        if (!dateStr) {
            outputElement.value = "";
            return;
        }

        try {
            let timestamp;
            const parts = dateStr.match(/^(\\d{4})-(\\d{2})-(\\d{2})\\s+(\\d{2}):(\\d{2}):(\\d{2})(?:\\.(\\d{1,3}))?$/);

            if (parts) {
                const year = parseInt(parts[1], 10);
                const month = parseInt(parts[2], 10) - 1;
                const day = parseInt(parts[3], 10);
                const hour = parseInt(parts[4], 10);
                const minute = parseInt(parts[5], 10);
                const second = parseInt(parts[6], 10);
                const millis = parts[7] ? parseInt(parts[7].padEnd(3, "0"), 10) : 0;

                timestamp = Date.UTC(year, month, day, hour, minute, second, millis);
                timestamp = new Date(timestamp).getTime();
            } else {
                const date = new Date(dateStr);
                if (isNaN(date.getTime())) {
                    outputElement.value = "无效的日期格式";
                    return;
                }
                timestamp = date.getTime();
            }

            outputElement.value = unit === "ms" ? timestamp : Math.floor(timestamp / 1000);
        } catch {
            outputElement.value = "转换失败";
        }
    }

    function formatDate(date, format) {
        const pad = (n) => n.toString().padStart(2, "0");

        let result = format;
        result = result.replace("yyyy", date.getFullYear());
        result = result.replace("MM", pad(date.getMonth() + 1));
        result = result.replace("dd", pad(date.getDate()));
        result = result.replace("HH", pad(date.getHours()));
        result = result.replace("mm", pad(date.getMinutes()));
        result = result.replace("ss", pad(date.getSeconds()));
        result = result.replace("fff", date.getMilliseconds().toString().padStart(3, "0"));

        return result;
    }

    document.addEventListener("DOMContentLoaded", () => {
        refreshTimestamp();
        const now = new Date();
        document.getElementById("inputDate").value = formatDate(now, "yyyy-MM-dd HH:mm:ss.fff");
    });
</script>
}
