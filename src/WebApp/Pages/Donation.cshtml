@page "/donation"
@model WebApp.Pages.DonationModel
@{ ViewData["Title"] = "赞助"; }

<div class="container">
    <div class="row">
        <div class="col-md-8">
            <h1 class="mb-4">赞助</h1>
            <div class="card">
                <div class="card-body">
                    @Html.Raw(Model.HtmlContent)
                </div>
            </div>
            <div class="card mt-3">
                <div class="card-header">调试信息</div>
                <div class="card-body">
                    @Html.Raw(Model.DebugInfo)
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card">
                <div class="card-header">其他页面</div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item"><a href="/rss">RSS订阅</a></li>
                        <li class="list-group-item"><a href="/sitemap">站点地图</a></li>
                        <li class="list-group-item"><a href="/about">关于我们</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
