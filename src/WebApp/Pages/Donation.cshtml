@page "/donation"
@model WebApp.Pages.DonationModel
@{
    ViewData["Title"] = I18n.T("nav.donation", "赞助");
    ViewData["Description"] = I18n.T("donation.description", "如果码坊的内容对你有帮助，欢迎通过赞助支持持续更新。");
    var banner = new WebApp.Models.PageBannerViewModel
    {
        Eyebrow = I18n.T("donation.eyebrow", "支持"),
        Title = I18n.T("donation.title", "赞助与支持"),
        Description = I18n.T("donation.intro", "如果这里的内容和工具帮到了你，欢迎通过赞助支持站点继续维护与更新。"),
        MetaItems = [
            I18n.T("donation.meta.content", "支持持续创作"),
            I18n.T("donation.meta.tools", "支持工具维护")
        ]
    };
}

@section Head {
    <partial name="_CodeHighlightHead" />
}

<section class="page-shell">
    <div class="container">
        <partial name="_PageBanner" model="banner" />

        <div class="content-grid">
            <div class="content-primary">
                <div class="surface-panel prose-panel">
                    <div class="prose article-content" data-reading-body asp-prerender="true">
                        @Html.Raw(Model.HtmlContent)
                    </div>
                </div>
            </div>

            <aside class="content-sidebar">
                <div class="surface-panel sidebar-panel sticky-panel">
                    <h2 class="sidebar-title">@I18n.T("donation.sidebarTitle", "你也可以从这里继续")</h2>
                    <p class="sidebar-copy">@I18n.T("donation.sidebarDescription", "如果暂时不赞助，也欢迎继续阅读、订阅或反馈建议。")</p>
                    <div class="sidebar-link-list">
                        <a href="/rss" class="sidebar-link">
                            <span>@I18n.T("footer.rss", "RSS 订阅")</span>
                            <i class="fas fa-angle-right"></i>
                        </a>
                        <a href="/sitemap" class="sidebar-link">
                            <span>@I18n.T("nav.sitemap", "站点地图")</span>
                            <i class="fas fa-angle-right"></i>
                        </a>
                        <a href="/about" class="sidebar-link">
                            <span>@I18n.T("footer.aboutSite", "关于站点")</span>
                            <i class="fas fa-angle-right"></i>
                        </a>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_CodeHighlightScripts" />
}
